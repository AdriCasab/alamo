#@
#@ [3d]
#@ dim=3
#@ check=true
#@ exe=mmwspalling
#@

# P2-24 unit/face_melt: THE BEAM SEES THE MELT, AND THE CRACK RULE STOPS IN AND OVER IT.
# The production rock and form (a face-list deck) on a 1 m cube at 64^3 (the face list needs CUBIC cells; the
# unit/beam_tau column is 64 x 64 x 16), the patch off, ZERO conduction (grimsel.lambda.a = 0), no losses, a melt
# band of its own (T_m 650 K, fus_width 100 K: fully liquid above 700 K, solid below 600 K), the beam from
# unit/beam_tau (omega0 0.1, lambda 1e-3, eps_r 1 => R 0, alpha 1 1/m exactly) at P0 1 kW with the melt keys
# melt_factor 4 and R_melt 0.3 (the rock file's) and a FLAT loss table on the sum path (two equal pairs).
#   U1 (this deck) IC 300 + 500 (z >= 0.5): the top half LIQUID (f_L 1), the bottom solid.
#      Deposition per unit beam power: top (1 - 0.3)(1 - e^-(4 x 0.5)) = 0.605265, bottom 0.7 e^-2 (1 - e^-0.5) =
#      0.037275, transmitted 0.7 e^-2.5 = 0.057460. Every top line's surface cell is liquid: fr_n_molten 4096,
#      fr_n_lid 0, bk_n_eval 0.
#   U1b IC 800 - 500 (z >= 0.5): a solid top over a liquid bottom; the window (h_spall_max 0.6 m = 38 cells) reaches
#      the liquid 32 cells down: fr_n_lid 4096, fr_n_molten 0, bk_n_eval 0.
#   U2 U1 with the melt keys at their no-op values (melt_factor 1, R_melt = R = 0): the flat fractions, and the
#      deposition bit-identical to a run without the melt band.
# THREE steps of 0.01 s: step 1 (T_old = the IC) is the deposition; step 2 is the first with a face list (built by
# step 1's kernel) and its row (t = 0.02) is written before step 3.
# P0 is 1 kW, not unit_beam_tau's 1 W: the deposition is read as an H difference, and at the 800 K top H is ~1.3e9
# J/m3, so one rounding (2e-16 x 1.3e9) is ~3e-7 J/m3 per cell -- at 1 W that put the fractions 7.6e-8 off (above
# the 1e-9 bar). 1 kW raises the top cell ~1e-3 K per step: no cell changes its phase state.
#
# check_shared.py (iii) (T_ref = a CONSTANT IC) cannot hold: the two-temperature IC is the fixture; T_ref 300 = the solid.
# check_shared: allow losses.epsilon
# check_shared: allow losses.epsilon_high
# check_shared: allow spall.h_spall_max
# check_shared: allow microstructure.phase0.T_m
# check_shared: allow microstructure.phase0.fus_width
# check_shared: allow microstructure.phase0.L_m
# check_shared: allow microstructure.phase0.grimsel.lambda.a
# check_shared: allow beam.eps_r
# check_shared: allow beam.tan_delta
# check_shared: allow beam.tan_delta_T

FILE = tests/MMWSpalling/validation/shared/rock_grimsel.inputs
FILE = tests/MMWSpalling/validation/shared/model_form_flame.inputs

alamo.program = mmwspalling
plot_file = tests/MMWSpalling/unit/face_melt/output/U1

timestep  = 0.01
stop_time = 0.03

amr.plot_int        = 1
amr.thermo.int      = 1
amr.thermo.plot_int = 1
amr.max_level       = 0
amr.max_grid_size   = 32
amr.blocking_factor = 2
amr.regrid_int      = 1000000
amr.grid_eff        = 0.7
amr.n_error_buf     = 1
amr.cell.all        = 1
amr.n_cell           = 64 64 64
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 1.0 1.0 1.0
geometry.is_periodic = 0 0 0
alpha = 0.0 0.0
weibull.V0 = 3.814697265625e-6     # the cell volume (1/64 m)^3

# the melt band of this fixture, and no conduction
microstructure.phase0.T_m       = 650.0
microstructure.phase0.fus_width = 100.0
microstructure.phase0.L_m       = 1.0
microstructure.phase0.grimsel.lambda.a = 0.0
microstructure.phase0.T_ref = 300.0
spall.h_spall_max = 0.6            # the window reaches 0.6 m (38 cells): U1b's lid lies 32 cells down

hc.ic.type                 = expression
hc.ic.expression.coord     = cartesian
hc.ic.expression.region0   = "300.0+500.0*(z>=0.5)"
hc.heat.alpha        = 6.9022e-7
hc.heat.refinement_threshold = 1.0
hc.bc.temp.constant.type.xlo = neumann
hc.bc.temp.constant.type.xhi = neumann
hc.bc.temp.constant.type.ylo = neumann
hc.bc.temp.constant.type.yhi = neumann
hc.bc.temp.constant.type.zlo = neumann
hc.bc.temp.constant.type.zhi = neumann
hc.bc.temp.constant.val.xlo  = 0.0
hc.bc.temp.constant.val.xhi  = 0.0
hc.bc.temp.constant.val.ylo  = 0.0
hc.bc.temp.constant.val.yhi  = 0.0
hc.bc.temp.constant.val.zlo  = 0.0
hc.bc.temp.constant.val.zhi  = 0.0
conductivity.h_gb0 = 0.0
confining.p = 0.0
losses.epsilon      = 0.0
losses.epsilon_high = 0.0
losses.h_conv       = 0.0
losses.T_amb        = 300.0

surface_patch.enabled = 0
surface_patch.radius  = 1.0
surface_patch.x0      = 0.5
surface_patch.y0      = 0.5

beam.P0         = 1000.0
beam.omega0     = 0.1
beam.lambda     = 1.0e-3
beam.x0         = 0.5
beam.y0         = 0.5
beam.z0         = 1.0
beam.eps_r      = 1.0
beam.tan_delta  = 0.00015915494309189536     # alpha = 1 1/m exactly in the code's association
beam.tan_delta_T = 295.15 1.0  1268.15 1.0   # two EQUAL pairs: a flat alpha on the sum path

el.type      = disable
el.nmodels   = 1
el.model1.E  = 30.0e9
el.model1.nu = 0.3
el.model1.F0 = 0 0 0 0 0 0 0 0 0
