#!/usr/bin/env python3
# Verification of Step 4: surface losses (radiation + convection). P2-30: the fixture reaches the equilibrium it scores.
#
# Only the top cell absorbs (alpha dz = 40; deck): its deposit in W/m^2 is I (1 - exp(-alpha dz)), I = 2 P0/(pi omega0^2)
# (⚠ the centre-point form I alpha dz exp(-alpha dz/2) is 8e-8 of the power at this optical depth). Pass criteria:
#   - steady: |T_top(end) - T_top(0.9 end)| / T_top(end) <= 1e-4
#   - T_top(end) within 1 % of the analytic balance
#         I (1 - exp(-alpha dz)) = eps sigma_SB (T_eq^4 - T_amb^4) + h (T_eq - T_amb)
#   - every cell within the property table's [200, 5000] K
#   - L8: the first step row's P_dep / P_inc >= 1 - 1e-6 (nothing transmitted), and every cell below the top within
#     1e-9 K of T_amb (nothing below absorbs; the deck has kappa = 0, so the interior holds at the IC)
#
# The constants are read from the RUN's metadata (P0, omega0, alpha from the dielectric pair, eps, sigma, h, T_amb, Lz, nz).
#
# Usage: test [OUTPUT_DIR]   (default: this directory's output/)

import sys
import os
import glob
import math

import numpy as np
import yt

TOL = 0.01
TOL_STEADY = 1e-4

outdir = sys.argv[1] if len(sys.argv) > 1 else "tests/MMWSpalling/unit/equilibrium/output"


def meta(run):
    d = {}
    for ln in open(os.path.join(run, "metadata")):
        if " = " in ln:
            k, v = ln.rstrip("\n").split(" = ", 1)
            d[k.strip()] = v.strip()   # the LAST occurrence wins (an argv override follows the deck's value)
    return d


m = meta(outdir)
P0 = float(m["beam.P0"])
OMEGA0 = float(m["beam.omega0"])
ALPHA = 2.0 * math.pi * math.sqrt(float(m["beam.eps_r"])) * float(m["beam.tan_delta"]) / float(m["beam.lambda"])
EPS = float(m["losses.epsilon"])
SIGMA = float(m["losses.sigma_SB"])
H_CONV = float(m["losses.h_conv"])
T_AMB = float(m["losses.T_amb"])
LZ = float(m["geometry.prob_hi"].split()[2]) - float(m["geometry.prob_lo"].split()[2])
NZ = int(m["amr.n_cell"].split()[2])
print(f"from the run's metadata: P0 {P0:g} W, omega0 {OMEGA0:g} m, alpha {ALPHA:.6f} 1/m, eps {EPS:g}, "
      f"sigma {SIGMA:g}, h {H_CONV:g}, T_amb {T_AMB:g} K, Lz {LZ:g} m, nz {NZ}")

dz = LZ / NZ
peak_intensity = 2.0 * P0 / (math.pi * OMEGA0 * OMEGA0)
rhs = peak_intensity * (1.0 - math.exp(-ALPHA * dz))
print(f"alpha dz = {ALPHA * dz:.4f}; I = {peak_intensity:.5e} W/m^2; the top cell's deposit I (1 - exp(-alpha dz)) = {rhs:.5e} W/m^2")


# Solve eps * sigma * (T^4 - T_amb^4) + h * (T - T_amb) = rhs (monotone in T above T_amb): bisection.
def f(T):
    return EPS * SIGMA * (T ** 4 - T_AMB ** 4) + H_CONV * (T - T_AMB) - rhs


lo, hi = T_AMB, max(2.0 * T_AMB, 1.0)
while f(hi) < 0.0:
    hi *= 2.0
for _ in range(200):
    mid = 0.5 * (lo + hi)
    lo, hi = (mid, hi) if f(mid) < 0.0 else (lo, mid)
T_eq = 0.5 * (lo + hi)

plotfiles = sorted(glob.glob(os.path.join(outdir, "*cell")))
if not plotfiles:
    print("FAIL: no cell plotfiles in", outdir)
    sys.exit(1)


def read_top(pf):
    ds = yt.load(pf)
    ad = ds.all_data()
    z = ad["z"].to_value()
    Tv = ad["Temp"].to_value()
    top_z = LZ - dz / 2.0
    on_top = np.abs(z - top_z) < dz * 0.1
    return float(ds.current_time), Tv, on_top


fails = 0
T_end_t, Tv, on_top = read_top(plotfiles[-1])
T_sim = float(np.mean(Tv[on_top]))
print(f"Temp range at t = {T_end_t:g} s: {Tv.min():.4f} .. {Tv.max():.4f} K")

times = [float(yt.load(p).current_time) for p in plotfiles]
i90 = min(range(len(times)), key=lambda i: abs(times[i] - 0.9 * T_end_t))
t90, T90, on90 = read_top(plotfiles[i90])
T_top_90 = float(np.mean(T90[on90]))
steady = abs(T_sim - T_top_90) / T_sim
print(f"steady: T_top({T_end_t:g} s) = {T_sim:.4f}, T_top({t90:g} s) = {T_top_90:.4f}, relative change {steady:.2e} (bar {TOL_STEADY:g})")
if steady > TOL_STEADY:
    print("FAIL: the top cell is not steady")
    fails += 1

err = abs(T_sim - T_eq) / T_eq
print(f"Surface equilibrium: T_sim = {T_sim:.4f}, T_analytic = {T_eq:.4f}, relative error = {err*100:.3f}%")
if err > TOL:
    print(f"FAIL: error {err*100:.2f}% exceeds tolerance {TOL*100:.0f}%.")
    fails += 1

if Tv.min() < 200.0 or Tv.max() > 5000.0:
    print(f"FAIL: a cell left the property table's [200, 5000] K: {Tv.min():.2f} .. {Tv.max():.2f}")
    fails += 1

# L8: nothing below the top cell absorbs
below = float(np.abs(Tv[~on_top] - T_AMB).max())
print(f"L8: every cell below the top within {below:.2e} K of T_amb {T_AMB:g} K (bar 1e-9)")
if below > 1e-9:
    print("FAIL: a cell below the top moved")
    fails += 1
L = open(os.path.join(outdir, "thermo.dat")).read().splitlines()
hdr = [c.strip() for c in L[0].split("\t")]
step = next(r.split("\t") for r in L[1:] if float(r.split("\t")[hdr.index("beam_P_inc")]) > 0.0)
pinc, pdep = float(step[hdr.index("beam_P_inc")]), float(step[hdr.index("beam_P_dep")])
print(f"L8: first step row: P_dep / P_inc = {pdep / pinc:.8f} (P_inc {pinc:g} W; bar >= 1 - 1e-6)")
if pdep / pinc < 1.0 - 1e-6:
    print("FAIL: part of the beam passed the top cell")
    fails += 1

if fails:
    print(f"FAIL ({fails})")
    sys.exit(1)
print("PASS")
sys.exit(0)
