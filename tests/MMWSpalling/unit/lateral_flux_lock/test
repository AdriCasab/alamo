def strip_comments(text):
    """blank out // and /* */ comments, PRESERVING newlines so every line number
    this test reports still matches the file.

    ⚠⚠ Not cosmetic. The first run of this lock FAILED because
    `side_hmax = surface_patch.side_face_h_max;` -- the defect -- is quoted
    verbatim inside the comment that explains the fix. A source assertion that
    reads comments as code cannot tell a fix from a description of the bug it
    fixed, which is a particularly bad failure mode for THIS test."""
    out, i, n = [], 0, len(text)
    while i < n:
        if text.startswith("//", i):
            j = text.find("\n", i)
            j = n if j < 0 else j
            out.append(" " * (j - i)); i = j
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            j = n if j < 0 else j + 2
            out.append("".join(c if c == "\n" else " " for c in text[i:j]))
            i = j
        elif text[i] in "\"'":
            q, j = text[i], i + 1
            while j < n and text[j] != q:
                j += 2 if text[j] == "\\" else 1
            j = min(j + 1, n)
            # keep string literals: the abort MESSAGES are what (a3) checks
            out.append(text[i:j]); i = j
        else:
            out.append(text[i]); i += 1
    return "".join(out)


def calls(path, text):
    """every SurfaceCellFlux call in `text`, as (line, [args]) -- brace matched.
    ⚠ Fails closed: an unbalanced call raises rather than being skipped."""
    out = []
    for m in re.finditer(r"SurfaceCellFlux\s*\(", text):
        head = text[:m.start()].rstrip()
        if head.endswith("static void") or head.endswith("void"):
            continue                      # the declaration, not a call
        depth, j = 1, m.end()
        while depth and j < len(text):
            if text[j] == "(":
                depth += 1
            elif text[j] == ")":
                depth -= 1
            j += 1
        if depth:
            raise RuntimeError("unbalanced SurfaceCellFlux call at %s:%d"
                               % (path, text[:m.start()].count("\n") + 1))
        body, args, d2, cur = text[m.end():j - 1], [], 0, ""
        for ch in body:
            if ch in "([{":
                d2 += 1
            elif ch in ")]}":
                d2 -= 1
            if ch == "," and d2 == 0:
                args.append(cur); cur = ""
            else:
                cur += ch
        args.append(cur)
        # normalise whitespace, and strip /*comment*/ argument labels
        norm = []
        for a in args:
            a = re.sub(r"/\*.*?\*/", " ", a)
            norm.append(" ".join(a.split()))
        out.append((text[:m.start()].count("\n") + 1, norm))
    return out


def main():
    fails = []

    def need(ok, msg):
        print(("  ok    " if ok else "  FAIL  ") + msg)
        if not ok:
            fails.append(msg)

    # ⚠ every assertion below reads CODE, never comments -- see strip_comments.
    mmw, rem = strip_comments(open(MMW).read()), strip_comments(open(REM).read())
    try:
        cm, cr = calls(MMW, mmw), calls(REM, rem)
    except RuntimeError as e:
        print("  FAIL  parse failed (fail closed): %s" % e)
        return 1

    # ---- identify the FOUR lateral sites ---------------------------------
    # ⚠ by CONTENT, not by line number: P1g-0 moved these sites by ~25 lines
    # when a comment grew, and a line-pinned lock would have silently missed.
    lateral = [("kernel", MMW, ln, a) for ln, a in cm
               if any("lat_" in x for x in a)]
    lateral += [("criterion", REM, ln, a) for ln, a in cr]
    print("P1g-0b (a2) THE LATERAL FLUX ARGUMENT LOCK")
    print("     %d SurfaceCellFlux calls in src/ (%d in MMWSpalling.H, %d in "
          "Removal.H)" % (len(cm) + len(cr), len(cm), len(cr)))
    for tag, path, ln, a in lateral:
        print("       %-10s %-16s :%-5d  %2d args"
              % (tag, os.path.basename(path), ln, len(a)))
    need(len(lateral) == 4,
         "exactly FOUR lateral SurfaceCellFlux sites found (%d) -- kernel, "
         "march, ledger, criterion" % len(lateral))
    if len(lateral) != 4:
        return 1

    # ---- every position is either identical or declared ------------------
    width = max(len(a) for _t, _p, _l, a in lateral)
    need(width <= len(SIG),
         "no call passes more arguments than the signature declares (%d <= %d)"
         % (width, len(SIG)))
    undeclared = [SIG[i] for i in range(min(width, len(SIG)))
                  if SIG[i] not in LOCK]
    need(not undeclared,
         "every argument position reaching a lateral site is DECLARED in the "
         "lock (%s)" % (", ".join(undeclared) if undeclared else "all declared"))

    print("\n     position-by-position, across the four sites:")
    for i in range(min(width, len(SIG))):
        name = SIG[i]
        vals = []
        for tag, _p, _l, a in lateral:
            vals.append(a[i] if i < len(a) else "<default>")
        same = len(set(vals)) == 1
        kind, why = LOCK.get(name, ("?", "UNDECLARED"))
        mark = "identical" if same else "differs"
        print("       %-11s %-10s %s" % (name, mark,
                                         " | ".join(v[:26] for v in vals)))
        if kind == "?":
            need(False, "argument %d (%s) is not declared in the lock" % (i, name))
            continue
        # ⚠ a declared difference that has become identical must be PROMOTED,
        # or the table rots into a list of excuses nobody rechecks.
        if same and kind == "value" and "all four" not in why:
            print("         ⚠ now IDENTICAL -- promote this row to 'all four' in "
                  "the lock")
        if not same:
            print("         condition: %s" % why)

    # ---- (a1) THE CAP: one conjunction, or a stated reason ---------------
    print("\nP1g-0b (a1) THE COEFFICIENT CAP -- one condition at every site")
    COND = r"surface_patch\.side_face_flux\s*&&\s*spall_per_cell_removal"
    sites = [("criterion Removal.H", rem), ("kernel+ledger MMWSpalling.H", mmw)]
    n_rem = len(re.findall(r"side_hmax\s*=\s*\n?\s*\(?" + COND, rem))
    n_mmw = len(re.findall(r"side_hmax\s*=\s*\n?\s*\(?" + COND, mmw))
    print("     `side_hmax` resolved through the conjunction: Removal.H %d, "
          "MMWSpalling.H %d" % (n_rem, n_mmw))
    need(n_rem == 1,
         "the CRITERION resolves the cap through the kernel's conjunction "
         "(%d site) -- P1g-0b deliverable 1" % n_rem)
    need(n_mmw == 2,
         "the KERNEL and the LEDGER still resolve it the same way (%d sites) -- "
