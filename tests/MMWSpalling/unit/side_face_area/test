#!/usr/bin/env python3
# D2x: surface_patch.side_face_r_min and surface_patch.side_face_area_exact.
#
# Geometry is the D2k side_face_flux case verbatim (see ./input): a 4 x 4 x 60
# block at 2 mm, corner column at h = 20000 against 2000 elsewhere, so the
# corner recedes ~10x faster and a STAIRCASE forms whose risers are the faces
# these keys act on.
#
# Variants (4 ranks):
#   ON     side_face_flux = 1, factor 1.0                  the reference
#   DEF    ON + r_min = 0.0 + area_exact = 0               both keys at default
#   RMIN   ON + r_min = 0.005                              gate above the corner
#   RALL   ON + r_min = 0.050                              gate beyond the patch
#   AEX    side_face_flux = 1, area_exact = 1              derived area
#
# Checks:
#   (a) DEFAULT-OFF: DEF is BYTE-IDENTICAL to ON (thermo.dat, removal_events,
#       every Level_0 Cell_D). Setting both keys to their defaults must change
#       nothing at all -- this is what lets the frozen baselines stay valid.
#   (b) r_min GATES: RMIN has strictly fewer side faces than ON, and RALL has
#       exactly zero (no column survives a 50 mm cut in an 8 mm block), with
#       side_P_face == 0 there.
#   (c) THE WEIGHT IS IN RANGE: on AEX, side_w_mean lies in [0.4142, 1.0] on
#       every row with side_faces > 0. 0.4142 = (sqrt(2)-1) is the n = 1 value
#       and is the minimum the geometry permits; reading 0.2 would mean the key
#       is inert.
#   (d) THE WEIGHT IS THE RATIO: at the FIRST row with side_faces > 0,
#           side_P_face(AEX) == side_w_mean(AEX) * side_P_face(ON)
#       which pins the per-edge weight quantitatively, not just its range.
#       NOT exact to round-off, and the bar is 1e-4: the ledger is evaluated
#       AFTER the H update, so by the time this row is written the two runs
#       have already applied one step of different side flux and their
#       temperatures differ by O(dt*dq/rho c). Measured agreement is ~1e-6,
#       i.e. the weight is pinned to six figures.
#   (c2) NOT DILUTED BY ABOVE-PLANE FACES: on AEXA some columns sit above the
#       descending nozzle plane, where side_face_factor_above = 0.0 governs the
#       faces by a different law. side_w_mean must still be in [0.4142, 1] and
#       side_P_face_above must be exactly 0. Counting those zero-weight faces in
#       the average drags it under the 0.4142 floor (0.147 on a Meier run, where
#       they are ~79 % of all faces).
#   (e) THE LEDGER TWIN MIRRORS. Bar 1e-12 on ledger_err, and < 1e-9 J on the
#       ABSOLUTE residual err*|E_src|. ledger_err is RELATIVE to E_src, and
#       gating faces off cuts E_src (RMIN ends at 1179 J against ON's 4880),
#       so identical round-off reads several times larger -- which is why a
#       relative bar alone is the wrong instrument here. A genuine mirror
#       failure (kernel applies flux the ledger does not count) would drift by
#       order the uncounted power x time, tens of joules, ten orders away from
#       the ~1e-10 J actually seen.
#   (f) THE PARSER REFUSES TWO AREA LAWS: area_exact = 1 together with an
#       explicit side_face_factor aborts, and each key alone without
#       side_face_flux aborts.
#
# Usage: test            (runs ALAMO, then checks)
#        test <outdir>   (checks existing outputs under <outdir>)

import filecmp
import glob
import os
import subprocess
import sys

import numpy as np

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, "..", "..", "..", ".."))
BIN = os.path.join(ROOT, "bin", "mmwspalling-3d-g++")
INPUT = os.path.join(HERE, "input")
OUT = sys.argv[1] if len(sys.argv) > 1 else os.path.join(HERE, "output")

W_MIN = np.sqrt(2.0) - 1.0          # 0.41421356..., the n = 1 riser weight
# The D2k exclusion map: the fast corner keeps h = 20000 while every other
# column drops to 1e-30 once the descending plane passes it, so an above-plane
# region exists for the AEXA variant to exercise.
H_EXCL = '"if(s>0.0,if(r<0.003,20000.0,2000.0),1.0e-30)"' 

VARIANTS = {
    "ON":   ["surface_patch.side_face_flux=1", "surface_patch.side_face_factor=1.0"],
    "DEF":  ["surface_patch.side_face_flux=1", "surface_patch.side_face_factor=1.0",
             "surface_patch.side_face_r_min=0.0", "surface_patch.side_face_area_exact=0"],
    "RMIN": ["surface_patch.side_face_flux=1", "surface_patch.side_face_factor=1.0",
             "surface_patch.side_face_r_min=0.005"],
    "RALL": ["surface_patch.side_face_flux=1", "surface_patch.side_face_factor=1.0",
             "surface_patch.side_face_r_min=0.050"],
    "AEX":  ["surface_patch.side_face_flux=1", "surface_patch.side_face_area_exact=1"],
    # AEXA: area_exact WITH an above-plane region. side_face_factor_above = 0.0
    # governs those faces by a DIFFERENT law, so they must not enter the
    # side_w_mean average. Without this variant the dilution is invisible --
    # AEX never sets factor_above, so every face takes the derived branch.
    "AEXA": ["surface_patch.side_face_flux=1", "surface_patch.side_face_area_exact=1",
             "surface_patch.side_face_factor_above=0.0",
             f"surface_patch.h_expr={H_EXCL}",
             "surface_patch.nozzle_z0=0.138", "surface_patch.nozzle_feed=4.0e-3"],
}

# (label, extra keys, substring the abort must mention)
ABORTS = [
    ("area_exact + explicit factor",
     ["surface_patch.side_face_flux=1", "surface_patch.side_face_factor=0.5",
      "surface_patch.side_face_area_exact=1"], "do not set both"),
    ("r_min without side_face_flux",
     ["surface_patch.side_face_flux=0", "surface_patch.side_face_r_min=0.005"],
     "requires surface_patch.side_face_flux"),
    ("area_exact without side_face_flux",
     ["surface_patch.side_face_flux=0", "surface_patch.side_face_area_exact=1"],
     "requires surface_patch.side_face_flux"),
]

FAIL = []


def check(name, cond, detail):
    print(f"  {'PASS' if cond else 'FAIL'}  {name}: {detail}")
    if not cond:
        FAIL.append(name)


def run(name, keys=None, pf_name=None):
    pf = os.path.join(OUT, pf_name or name)
    cmd = (["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "4", BIN, INPUT,
            f"plot_file={pf}"] + (keys if keys is not None else VARIANTS[name]))
    os.makedirs(OUT, exist_ok=True)
    with open(pf + ".log", "w") as log:
        log.write(" ".join(cmd) + "\n")
        log.flush()
        rc = subprocess.call(cmd, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
    return rc


def thermo(name):
    p = os.path.join(OUT, name, "thermo.dat")
    head = open(p).readline().split()
    a = np.loadtxt(p, skiprows=1, ndmin=2)
    return {c: a[:, i] for i, c in enumerate(head)}


def same_bytes(a, b):
    """thermo.dat, the removal log and every Level_0 Cell_D, byte for byte."""
    for rel in ("thermo.dat",):
        if not filecmp.cmp(os.path.join(OUT, a, rel), os.path.join(OUT, b, rel), shallow=False):
            return False, rel
    for suf in ("_removal_events.csv",):
        pa, pb = os.path.join(OUT, a + suf), os.path.join(OUT, b + suf)
        if os.path.exists(pa) != os.path.exists(pb):
            return False, suf
        if os.path.exists(pa) and not filecmp.cmp(pa, pb, shallow=False):
            return False, suf
    ga = sorted(glob.glob(os.path.join(OUT, a, "*cell", "Level_0", "Cell_D_*")))
    gb = sorted(glob.glob(os.path.join(OUT, b, "*cell", "Level_0", "Cell_D_*")))
    if not ga or len(ga) != len(gb):
        return False, f"plotfile count {len(ga)} vs {len(gb)}"
    for x, y in zip(ga, gb):
        if not filecmp.cmp(x, y, shallow=False):
            return False, os.path.relpath(x, OUT)
    return True, f"{len(ga)} Cell_D files + thermo.dat + removal log"


def main():
    if len(sys.argv) == 1:
        for n in VARIANTS:
            rc = run(n)
            print(f"  {n}: rc={rc}")
            if rc != 0:
                check(f"{n} runs", False, f"rc={rc}")
                return 1

    T = {n: thermo(n) for n in VARIANTS}

    # (a) default-off identity
    ok, what = same_bytes("ON", "DEF")
    check("(a) both keys at default are byte-identical to ON", ok, what)

    # (b) the radius gate
    f_on, f_rmin, f_rall = (T[n]["side_faces"].max() for n in ("ON", "RMIN", "RALL"))
    check("(b) r_min = 5 mm removes faces", 0 < f_rmin < f_on,
          f"side_faces max ON {f_on:.0f} -> RMIN {f_rmin:.0f}")
    check("(b) r_min = 50 mm removes all", f_rall == 0.0 and
          np.allclose(T["RALL"]["side_P_face"], 0.0),
          f"side_faces max {f_rall:.0f}, side_P_face max "
          f"{np.abs(T['RALL']['side_P_face']).max():.3e} W")

    # (c) the weight is in range
    a = T["AEX"]
    check("(c) side_w_mean is registered", "side_w_mean" in a,
          "thermo column present" if "side_w_mean" in a else "MISSING")
    if "side_w_mean" in a:
        m = a["side_faces"] > 0
        w = a["side_w_mean"][m]
        check("(c) side_w_mean in [0.4142, 1]",
              bool(m.any()) and w.min() >= W_MIN - 1e-12 and w.max() <= 1.0 + 1e-12,
              f"{w.min():.4f} .. {w.max():.4f} over {int(m.sum())} rows "
              f"(0.2 would mean inert)")

    # (c2) the average must not be diluted by above-plane faces
    x = T["AEXA"]
    if "side_w_mean" in x:
        # Only where the quantity is DEFINED: a row whose faces are all
        # above-plane has no derived-area face, so the mean is undefined and the
        # code reports 0.0. Verified: every w == 0 row has zero below-plane
        # faces. The [0.4142, 1] floor applies where a below-plane face exists.
        mx = (x["side_faces"] - x["side_cols_above"]) > 0
        wx = x["side_w_mean"][mx]
        ab = x["side_P_face_above"] if "side_P_face_above" in x else np.zeros(1)
        n_ab = x["side_cols_above"].max() if "side_cols_above" in x else 0.0
        check("(c2) side_w_mean not diluted by above-plane faces",
              bool(mx.any()) and wx.min() >= W_MIN - 1e-12 and wx.max() <= 1.0 + 1e-12,
              f"{wx.min():.4f} .. {wx.max():.4f} over {int(mx.sum())} rows with a "
              f"below-plane face, while {n_ab:.0f} above-plane faces are present "
              f"(dilution would push it below {W_MIN:.4f}; it read 0.147 on a Meier run)")
        check("(c2) above-plane side power is exactly 0",
              float(np.abs(ab).max()) == 0.0, f"max |side_P_face_above| {np.abs(ab).max():.3e} W")

    # (d) the weight IS the ratio, at the first row with faces
    on, aex = T["ON"], T["AEX"]
    i_on = int(np.argmax(on["side_faces"] > 0))
    i_ae = int(np.argmax(aex["side_faces"] > 0))
    same_row = (on["time"][i_on] == aex["time"][i_ae]
                and on["side_faces"][i_on] == aex["side_faces"][i_ae])
    if same_row and "side_w_mean" in aex:
        lhs = aex["side_P_face"][i_ae]
        rhs = aex["side_w_mean"][i_ae] * on["side_P_face"][i_on]
        rel = abs(lhs - rhs) / max(abs(rhs), 1e-30)
        check("(d) side_P_face(AEX) == side_w_mean * side_P_face(ON)", rel < 1e-4,
              f"{lhs:.6e} vs {rhs:.6e} (rel {rel:.2e}) at t = {on['time'][i_on]:g} s, "
              f"w = {aex['side_w_mean'][i_ae]:.4f}")
    else:
        check("(d) first side-face row is comparable", False,
              f"ON row {i_on} t={on['time'][i_on]:g} faces={on['side_faces'][i_on]:.0f}; "
              f"AEX row {i_ae} t={aex['time'][i_ae]:g} faces={aex['side_faces'][i_ae]:.0f}")

    # (e) the ledger twin -- relative AND absolute, see the header
    for n in ("AEX", "RMIN", "RALL"):
        err = np.abs(T[n]["ledger_err"])
        src = np.abs(T[n]["ledger_E_src"])
        i = int(np.argmax(err))
        absres = err[i] * src[i]
        check(f"(e) {n} ledger twin mirrors", err[i] <= 1e-12 and absres < 1e-9,
              f"max|ledger_err| {err[i]:.2e} (bar 1e-12), absolute residual "
              f"{absres:.2e} J on E_src {src[i]:.3e} J (bar 1e-9)")

    # (f) the parser refuses two area laws
    for lab, keys, want in ABORTS:
        pf = os.path.join(OUT, "ABORT")
        cmd = (["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "1", BIN, INPUT,
                f"plot_file={pf}", "stop_time=0.002"] + keys)
        r = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
        txt = r.stdout + r.stderr
        check(f"(f) aborts: {lab}", r.returncode != 0 and want in txt,
              f"rc={r.returncode}" + ("" if want in txt else f"; '{want}' not in output"))

    print(("FAIL: " + ", ".join(FAIL)) if FAIL else "PASS")
    return 1 if FAIL else 0


if __name__ == "__main__":
    sys.exit(main())
