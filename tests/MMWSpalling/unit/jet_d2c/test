# (d) free surface, energy
def invariants(pf, mdot, signed=False):
    th = thermo(pf)
    s = th["time"] > 0.0
    budget = mdot * CP * (T_NOZ - T_ENT) + th["jet_P_recirc"][s]
    r1 = np.max(np.abs(th["jet_P_face"][s] + th["jet_P_exhaust"][s] - th["jet_P_cap"][s]) / budget)
