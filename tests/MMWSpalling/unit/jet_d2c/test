    low = th["jet_P_face"][s] - (th["jet_P_neg"][s] if signed else 0.0)
    r5 = -min(0.0, low.min()) / np.max(budget)
    good = max(r1, r2, r3, r4, r5) <= TOL_PRINT
    return good, f"face+exhaust-cap {r1:.0e}, budget {r2:.0e}, decay {r3:.0e}, face-cap {r4:.0e}, low {r5:.0e}"


