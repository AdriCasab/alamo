FAIL = []


def check(name, cond, detail):
    print(f"  {'PASS' if cond else 'FAIL'}  {name}: {detail}")
    if not cond:
        FAIL.append(name)


def run(name, keys=None, pf_name=None):
    pf = os.path.join(OUT, pf_name or name)
    cmd = (["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "4", BIN, INPUT,
            f"plot_file={pf}"] + (keys if keys is not None else VARIANTS[name]))
    os.makedirs(OUT, exist_ok=True)
    with open(pf + ".log", "w") as log:
        log.write(" ".join(cmd) + "\n")
        log.flush()
        rc = subprocess.call(cmd, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
    return rc


def thermo(name):
    p = os.path.join(OUT, name, "thermo.dat")
    head = open(p).readline().split()
    a = np.loadtxt(p, skiprows=1, ndmin=2)
    return {c: a[:, i] for i, c in enumerate(head)}


def same_bytes(a, b, thermo_too=True):
    """Byte equality of the run. `thermo_too=False` compares only the SOLVER
    state -- the removal log and every Cell_D -- for pairs that are expected to
    differ in thermo.dat alone because one of them registers extra diagnostic
    columns (the D2z-2 gate pair)."""
    for rel in (("thermo.dat",) if thermo_too else ()):
        if not filecmp.cmp(os.path.join(OUT, a, rel), os.path.join(OUT, b, rel),
                           shallow=False):
            return False, rel
    for suf in ("_removal_events.csv",):
        pa, pb = os.path.join(OUT, a + suf), os.path.join(OUT, b + suf)
        if os.path.exists(pa) != os.path.exists(pb):
            return False, suf
        if os.path.exists(pa) and not filecmp.cmp(pa, pb, shallow=False):
            return False, suf
    ga = sorted(glob.glob(os.path.join(OUT, a, "*cell", "Level_0", "Cell_D_*")))
    gb = sorted(glob.glob(os.path.join(OUT, b, "*cell", "Level_0", "Cell_D_*")))
    if not ga or len(ga) != len(gb):
        return False, f"plotfile count {len(ga)} vs {len(gb)}"
    for x, y in zip(ga, gb):
        if not filecmp.cmp(x, y, shallow=False):
            return False, os.path.relpath(x, OUT)
    return True, (f"{len(ga)} Cell_D files + removal log"
                  + (" + thermo.dat" if thermo_too else " (thermo excluded)"))


def g_of(delta, n, a):
    """D2z-2 deliverable 4, the DERIVED conductance.

    g = (1 - e^{-delta a}) / (1 - e^{-n a}). The grid has already resolved the
    step as n cells, so its own drop across that face goes as 1 - e^{-n a}; the
    true drop goes as 1 - e^{-delta a}. D2z normalised by 1 - e^{-a} regardless
    of n, which double-counted the resolved depth and AMPLIFIED the flux.
    """
    nn = float(max(n, 1))
    if a <= 1e-12:
        return delta / nn if delta < nn else 1.0
    return (1.0 - math.exp(-delta * a)) / (1.0 - math.exp(-nn * a))


def g_d2z(delta, a):
    """The superseded D2z form, kept ONLY so the regression can be stated."""
    if a <= 1e-12:
        return min(delta, 1.0)
    return (1.0 - math.exp(-delta * a)) / (1.0 - math.exp(-a))


def main():
    if len(sys.argv) == 1:
        rc = run("DEF", keys=VARIANTS["ON"], pf_name="DEF")   # (a) control
        print(f"  DEF: rc={rc}")
        for n in VARIANTS:
            rc = run(n)
            print(f"  {n}: rc={rc}")
            if rc != 0:
                check(f"{n} runs", False, f"rc={rc}")
                return 1

    T = {n: thermo(n) for n in list(VARIANTS) + ["DEF"]}

    # ---- (a) default-off identity ---------------------------------------
    ok, what = same_bytes("ON", "DEF")
    check("(a) neither key set is byte-identical to ON", ok, what)

    # ---- (b) the keys reach the code ------------------------------------
    check("(b) ON registers none of the new columns",
          not any(c in T["ON"] for c in NEW_COLS),
          f"present: {[c for c in NEW_COLS if c in T['ON']]}")
    for n in ("STEP", "WET"):
        check(f"(b) {n} registers all three",
              all(c in T[n] for c in NEW_COLS),
              f"missing: {[c for c in NEW_COLS if c not in T[n]]}")

    # ---- (c) the two laws differ, in the right direction -----------------
    ps, pw = T["STEP"]["side_P_face"].max(), T["WET"]["side_P_face"].max()
    check("(c) wetted draws strictly less than step (ramp < delta)",
          pw < ps and pw > 0.0,
          f"side_P_face max: step {ps:.3f} W vs wetted {pw:.3f} W "
          f"(ratio {pw/ps:.4f})" if ps else "step drew nothing")

    # ---- (d) the two laws are reciprocal, AND it is the EXACT ramp --------
    # ⚠ NOT a row-by-row comparison between the two runs: STEP and WET deposit
    # different heat, so their geometries diverge and their delta populations
    # are not the same. Reciprocity is a per-face identity at a given delta,
    # so it is checked in closed form, and the runs are checked only for the
    # sign each law must have by construction.
    rs = T["STEP"]["riser_area_ratio"]; rs = rs[rs > 0]
    rw = T["WET"]["riser_area_ratio"];  rw = rw[rw > 0]
    check("(d) step charges MORE than the other law, wetted LESS",
          rs.size and rw.size and rs.min() > 1.0 and rw.max() < 1.0,
          f"step {rs.min():.4f}-{rs.max():.4f} (all > 1), "
          f"wetted {rw.min():.4f}-{rw.max():.4f} (all < 1)")
    ramp = lambda d: math.sqrt(1.0 + d * d) - 1.0
    worst_r = max(abs((d / ramp(d)) * (ramp(d) / d) - 1.0)
                  for d in (0.05, 0.2, 0.5, 1.0, 2.0, 3.0))
    check("(d2) the two laws are exact reciprocals at equal delta",
          worst_r < 1e-12, f"max |r_step*r_wet - 1| = {worst_r:.3e}")
    # The packet's own numbers, which separate the EXACT ramp from the
    # withdrawn delta^2/2 small-step limit: at delta = 2 the ramp is 1.236 (so
    # the ratio is the golden 1.618), where delta^2/2 would give 2.0 and a
    # ratio of exactly 1. Over half of A's stepped pairs are >= 2 cells apart,
    # which is why the difference matters.
    check("(d3) area_law = wetted is the EXACT ramp, not delta^2/2",
          abs(ramp(2.0) - 1.2360679) < 1e-6 and abs(ramp(3.0) - 2.1622776) < 1e-6
          and abs(2.0 / ramp(2.0) - 1.6180339) < 1e-6,
          f"ramp(2) = {ramp(2.0):.7f} (delta^2/2 would be 2.0), "
          f"ramp(3) = {ramp(3.0):.7f} (vs 4.5), ratio at 2 = {2.0/ramp(2.0):.7f}")

    # ---- (e) g(1) == 1 exactly -------------------------------------------
    worst = max(abs(g_of(1.0, 1, a) - 1.0) for a in (1e-6, 0.1, 1.0, 1.29, 5.0, 50.0))
    check("(e) g(1) = 1 exactly for every a", worst < 1e-12,
          f"max |g(1) - 1| over a in [1e-6, 50] = {worst:.3e}")

    # ---- (j) D2z-2 deliverable 4: the DERIVED conductance -----------------
    # The packet's table, reproduced in closed form. `current` is the D2z form.
    TABLE = [(1.29, 2, 2.3, 1.31, 1.026),
             (0.65, 2, 2.3, 1.62, 1.066),
             (0.65, 3, 3.2, 1.83, 1.020),
             (0.65, 2, 1.8, 1.44, 0.948)]
    bad = [(a, n, d) for a, n, d, cur, der in TABLE
           if abs(g_d2z(d, a) - cur) > 5e-3 or abs(g_of(d, n, a) - der) > 5e-3]
    check("(j) the derived form reproduces the packet's table", not bad,
          "; ".join(f"a={a} n={n} d={d}: D2z {g_d2z(d,a):.2f} -> derived "
                    f"{g_of(d,n,a):.3f}" for a, n, d, _, _ in TABLE))
    # n = 1 must be EXACT, or D2z's r < 25 mm result (0.0 % multi-cell) moves.
    worst1 = max(abs(g_of(d, 1, a) - g_d2z(d, a))
                 for a in (1e-6, 0.1, 0.65, 1.0, 1.29, 5.0, 50.0)
                 for d in (0.01, 0.05, 0.2, 0.5, 0.9, 0.99, 1.0, 2.0))
    check("(j2) n = 1 reproduces the D2z form to machine precision",
          worst1 == 0.0, f"max |derived - D2z| at n = 1 = {worst1:.3e}")
    # a -> 0 degenerates to delta/n, NOT min(delta, 1).
    lim = [(g_of(d, n, 1e-13), d / n) for d, n in ((1.8, 3), (0.5, 2), (2.5, 4))]
    check("(j3) a -> 0 degenerates to delta/n, not min(delta, 1)",
          all(abs(x - y) < 1e-12 for x, y in lim),
          "; ".join(f"{x:.4f} vs delta/n {y:.4f}" for x, y in lim))
    # The never-fired fallback: phi = 1 on BOTH columns => delta = n => g = 1
    # for any a, with no special case. The D2z form ran away with n.
    fb = [(n, a, g_of(float(n), n, a), g_d2z(float(n), a))
          for n in (2, 3, 7) for a in (0.391, 0.778, 1.29)]
    check("(j4) the never-fired fallback (delta = n) is exactly 1 for any a",
          all(abs(g - 1.0) < 1e-12 for _, _, g, _ in fb),
          "D2z gave up to " + f"{max(o for _, _, _, o in fb):.2f} "
          f"(n=3,a=0.778 -> {g_of(3.,3,0.778):.3f} vs {g_d2z(3.,0.778):.3f}; "
          f"n=7,a=0.391 -> {g_of(7.,7,0.391):.3f} vs {g_d2z(7.,0.391):.3f})")
    # ⚠ g is NOT bounded by 1. delta = n + phi_S - phi_T with both phases in
    # [0, 1], so delta spans [n-1, n+1] and g > 1 whenever phi_S > phi_T -- the
    # shorter column is due to fire and the taller has just fired, so the riser
    # really is momentarily taller than the n cells the grid resolved. The
    # derivation's bound is g <= g(n+1, n, a) <= (n+1)/n.
    #
    # THAT is the repair, stated correctly: the residual over-unity is a
    # SUB-CELL effect that FALLS with n (2.00 at n = 1, 1.14 at n = 7), where
    # the D2z form's grew without bound in n (1.99 at n = 1, 7.73 at n = 7 at
    # a = 0.01). At n = 1 the two are identical, as they must be.
    worst_b = max(g_of(float(n) + 1.0, n, a) * n / (n + 1.0) - 1.0
                  for n in (1, 2, 3, 5, 7)
                  for a in (0.01, 0.1, 0.391, 0.778, 1.29, 5.0))
    check("(j5) g is bounded by (n+1)/n -- the sub-cell phase, not amplification",
          worst_b <= 1e-12,
          "max g at delta = n+1: " + ", ".join(
              f"n={n}: {g_of(n+1.0, n, 0.391):.3f} (D2z {g_d2z(n+1.0, 0.391):.3f})"
              for n in (1, 2, 3, 7)))
    # And the bound must FALL with n where D2z's ROSE -- the direction is the
    # whole point of the fix.
    dn = [g_of(n + 1.0, n, 0.391) for n in (1, 2, 3, 5, 7)]
    zn = [g_d2z(n + 1.0, 0.391) for n in (1, 2, 3, 5, 7)]
    check("(j6) the derived bound falls with n; the D2z bound rose",
          all(x > y for x, y in zip(dn, dn[1:])) and all(x < y for x, y in zip(zn, zn[1:])),
          f"derived {[round(x,3) for x in dn]} vs D2z {[round(x,3) for x in zn]}")

    # ---- (k) D2z-2 deliverables 1-3: the repaired columns ------------------
    check("(k) ON registers none of the D2z-2 columns",
          not any(c in T["ON"] for c in D2Z2_COLS),
          f"present: {[c for c in D2Z2_COLS if c in T['ON']]}")
    for n in ("STEP", "WET"):
        check(f"(k) {n} registers all eight D2z-2 columns",
              all(c in T[n] for c in D2Z2_COLS),
              f"missing: {[c for c in D2Z2_COLS if c not in T[n]]}")
    # deliverable 1: delta_mean is the PAIR height, so it is unbounded above,
    # where StepCellWeight's per-cell share was pinned near 1. delta_faces is
    # the stepped-FACE count and must be >= the pair count behind delta_mean.
    dm = T["STEP"]["delta_mean"]
    df = T["STEP"]["delta_faces"]
    check("(k2) delta_faces is registered and counts stepped faces",
          float(df.max()) > 0.0, f"max delta_faces = {float(df.max()):.1f}, "
          f"delta_mean range {float(dm.min()):.4f}-{float(dm.max()):.4f}")
    # deliverable 2: the gate must actually remove faces, and an UNSET gate
    # must be exactly the whole domain (that is what preserves identity).
    check("(k3) step_diag_radius removes faces",
          float(T["GATE"]["wall_step_n_in"].max()) <
          float(T["GATE"]["wall_step_n"].max()),
          f"GATE n_in max {float(T['GATE']['wall_step_n_in'].max()):.1f} "
          f"< n max {float(T['GATE']['wall_step_n'].max()):.1f}")
    ug = T["GATE0"]
    check("(k4) an unset gate is the whole domain, exactly",
          np.array_equal(ug["wall_step_n_in"], ug["wall_step_n"]),
          "GATE0 wall_step_n_in == wall_step_n on every row")
    # THE point of the key: it is a diagnostic gate, so the run must not move.
    # thermo.dat legitimately differs -- GATE's _in columns hold different
    # numbers -- so the comparison is the SOLVER state: removal log + Cell_D.
    okb, detb = same_bytes("GATE", "GATE0", thermo_too=False)
    check("(k4b) the gate is diagnostics-only: GATE == GATE0 in trajectory",
          okb, detb)
    # ...and every column that is NOT gated must be bit-identical between them.
    shared = [c for c in T["GATE"] if c in T["GATE0"]
              and not c.endswith("_in") and c not in ("step_g_mean", "step_g_max",
                                                      "wall_step_f_multi")]
    moved = [c for c in shared if not np.array_equal(T["GATE"][c], T["GATE0"][c])]
    check("(k4c) the gate moves no ungated column",
          not moved, f"{len(shared)} shared columns identical; moved: {moved}")
    # deliverable 2, self-consistency: the meter's own reported mean g must
    # equal the ratio of the two fluxes it reports. This is criterion (d).
    # ⚠ wall_step_q_eff_in / wall_step_q_in is the FLUX-weighted mean of g,
    # while step_g_mean is the FACE-weighted mean. They are equal only when g
    # and q are uncorrelated, and here they are strongly correlated (a tall
    # step has both a large g and a large dT). Criterion (d) pre-registers
    # "within 5 %" between them, which is therefore a statement about that
    # CORRELATION, not self-consistency -- recorded in the completion notes.
    # The genuine self-consistency invariant, which does catch a mismatched
    # face set between the two accumulators, is that the flux-weighted mean
    # must lie inside the observed range of g.
    # ⚠ And the flux-weighted mean is NOT bracketed by the range of g either:
    # q_raw = kc*(Tc - T_nbr)/dx is NEGATIVE wherever the neighbour is hotter,
    # so the weights change sign and a weighted mean can leave [min g, max g].
    #
    # The check with teeth is the EXACT identity: with the gate off, the in-gate
    # accumulators run over the whole domain, so they must reproduce the ungated
    # ones bit for bit. That is what catches the two accumulators drifting onto
    # different face sets -- the failure mode criterion (d) is aimed at.
    ok_id = (np.array_equal(ug["wall_step_q_in"],     ug["wall_step_q"]) and
             np.array_equal(ug["wall_step_q_eff_in"], ug["wall_step_q_eff"]))
    check("(k5) with the gate off the _in accumulators are bit-identical",
          ok_id, "wall_step_q_in == wall_step_q and "
                 "wall_step_q_eff_in == wall_step_q_eff on every row")
    q_in, qe_in = ug["wall_step_q_in"], ug["wall_step_q_eff_in"]
    m = np.abs(q_in) > 1e-9
    if m.any():
        ratio = qe_in[m] / q_in[m]
        gm = ug["step_g_mean"][m]
        print(f"  INFO  flux-weighted g {float(ratio.min()):.4f}-"
              f"{float(ratio.max()):.4f} vs face-weighted step_g_mean "
              f"{float(gm.min()):.4f}-{float(gm.max()):.4f}; "
              f"max |flux - face| = {float(np.abs(ratio - gm).max()):.4f} "
              f"-- criterion (d)'s 5 % bar compares these two DIFFERENT means")
    # deliverable 4 in the LIVE code: g is bounded by 2 (the n = 1, delta = 2
    # corner), and the D2z form had NO such bound -- it grew with n.
    gmx = float(T["GATE0"]["step_g_max"].max())
    check("(k6) live step_g_max respects the derivation's bound of 2",
          gmx <= 2.0 + 1e-12,
          f"max over the run = {gmx:.6f} (D2z's form was unbounded in n: "
          f"{g_d2z(8.0, 0.01):.2f} at n = 7, a = 0.01)")
    # deliverable 3: the multi-cell power share is a share of side_P_face.
    sm, sp = T["STEP"]["side_P_face_multi"], T["STEP"]["side_P_face"]
    ok_share = bool(np.all(sm <= np.abs(sp) + 1e-9)) and bool(np.all(sm >= -1e-9))
    check("(k7) side_P_face_multi is a share of side_P_face",
          ok_share, f"multi max {float(sm.max()):.3f} W of side_P_face max "
          f"{float(sp.max()):.3f} W; f_multi max "
          f"{float(T['STEP']['wall_step_f_multi'].max()):.3f}")

    # ---- (m) D2aa deliverables 1-4 ---------------------------------------
    check("(m) ON registers none of the D2aa columns",
          not any(c in T["ON"] for c in D2AA_COLS),
          f"present: {[c for c in D2AA_COLS if c in T['ON']]}")
    check("(m) STEP registers all seven D2aa columns",
          all(c in T["STEP"] for c in D2AA_COLS),
          f"missing: {[c for c in D2AA_COLS if c not in T['STEP']]}")
    # deliverable 3 / criterion (d): the region split must close on side_P_face
    # EXACTLY -- it is accumulated from the same per-face term, so any gap is a
    # binning bug, not round-off.
    for n in ("STEP", "WET"):
        tot = T[n]["side_P_bore"] + T[n]["side_P_pads"] + T[n]["side_P_wall"]
        ref = T[n]["side_P_face"]
        m = np.abs(ref) > 1e-12
        rel = float(np.abs((tot[m] - ref[m]) / ref[m]).max()) if m.any() else 0.0
        check(f"(m2) {n} region power split closes on side_P_face",
              rel <= 1e-4, f"max rel gap = {rel:.3e} (bar 1e-4)")
    # deliverable 2: the explicit pair must actually change the answer, and must
    # NOT be mistaken for the inherited map.
    okh, deth = same_bytes("HEX", "STEP", thermo_too=False)
    check("(m3) the explicit (h, T) pair reaches the side faces",
          not okh, f"HEX differs from STEP: {deth}")
    check("(m4) HEX draws side power and does not refrigerate",
          float(T["HEX"]["side_P_face"].max()) > 0.0,
          f"HEX side_P_face max {float(T['HEX']['side_P_face'].max()):.3f} W, "
          f"min {float(T['HEX']['side_P_face'].min()):.3f} W "
          f"(STEP max {float(T['STEP']['side_P_face'].max()):.3f} W)")
    # deliverable 1: the shield must cut the pad-ring power, and the pair differs
    # in exactly one key.
    # With the default foot radii the ring is empty, so every charged face must
    # land in `wall` -- the binning's own degenerate case.
    check("(m5) with no pad ring every charged face bins to `wall`",
          float(np.abs(T["STEP"]["side_A_bore"]).max()) == 0.0
          and float(np.abs(T["STEP"]["side_A_pads"]).max()) == 0.0
          and float(T["STEP"]["side_A_wall"].max()) > 0.0,
          f"bore {float(T['STEP']['side_A_bore'].max()):.3e}, "
          f"pads {float(T['STEP']['side_A_pads'].max()):.3e}, "
          f"wall {float(T['STEP']['side_A_wall'].max()):.3e} m2")
    check("(m6) wall_step_f_multi_pads is registered and finite",
          bool(np.all(np.isfinite(T["STEP"]["wall_step_f_multi_pads"]))),
          f"range {float(T['STEP']['wall_step_f_multi_pads'].min()):.3f}-"
          f"{float(T['STEP']['wall_step_f_multi_pads'].max()):.3f}")

    # ---- (f) the ledger twin mirrors -------------------------------------
    for n in ("STEP", "WET", "STEPA"):
        rel = np.abs(T[n]["ledger_err"]).max()
        absj = rel * np.abs(T[n]["ledger_E_src"]).max()
        check(f"(f) {n} ledger twin mirrors the kernel",
              rel <= 1e-12 and absj <= 1e-9,
              f"max|ledger_err| {rel:.3e} rel, {absj:.3e} J abs")

    # ---- (g) not diluted by above-plane faces ----------------------------
    ab = T["STEPA"]["side_P_face_above"]
    check("(g) STEPA puts exactly 0 W on above-plane faces",
          np.all(ab == 0.0), f"max {ab.max():+.3e} W, min {ab.min():+.3e} W")
    dm = T["STEPA"]["delta_mean"]
    live = dm[T["STEPA"]["side_faces"] - T["STEPA"]["side_cols_above"] > 0]
    check("(g2) STEPA delta_mean is a below-plane population mean",
          live.size > 0 and np.all(live > 0.0),
          f"{live.size} rows with below-plane faces, delta_mean "
          f"{live.min():.4f}-{live.max():.4f}" if live.size else "no such rows")

    # ---- (h) flat plate: no step, no area --------------------------------
    check("(h) a single column invents no riser area",
          T["FLAT"]["side_P_face"].max() == 0.0 and T["FLAT"]["delta_mean"].max() == 0.0,
          f"side_P_face max {T['FLAT']['side_P_face'].max():.3e} W, "
          f"delta_mean max {T['FLAT']['delta_mean'].max():.3e}")

    # ---- (n) D2ab: the annulus pair's RADIUS GATE -------------------------
    # The gate has to be shown to select on RADIUS, not merely to do something.
    # The two extremes are what prove it: r_min = 0 must change NOTHING, and an
    # r_min past every column must retire the pair ENTIRELY. A gate that fired
    # on some other predicate could pass one of these but not both.
    ok, what = same_bytes("HEX", "HEXR0")
    check("(n1) side_face_h_r_min = 0 is byte-identical to the key unset",
          ok, what)
    # ⚠ thermo_too = False: HEXRX registers side_T_wall (registration keys off
    # side_face_h being GIVEN, not off the gate) while STEP does not, so the
    # two thermo files legitimately differ by one column. The SOLVER state --
    # the removal log and every Cell_D -- must match exactly.
    ok, what = same_bytes("STEP", "HEXRX", thermo_too=False)
    check("(n2) an r_min beyond every column retires the pair entirely "
          "(== inheriting the map)", ok, what)
    same_hex, _ = same_bytes("HEX", "HEXR", thermo_too=False)
    same_stp, _ = same_bytes("STEP", "HEXR", thermo_too=False)
    check("(n3) a 5 mm gate is a genuine PARTIAL gate, neither extreme",
          not same_hex and not same_stp,
          f"differs from HEX: {not same_hex}, differs from STEP: {not same_stp} "
          f"(columns span r = 1.41-9.90 mm)")

    # ---- (n4/n5) D2ab: the live-temperature witness -----------------------
    for n in ("ON", "STEP"):
        check(f"(n4) {n} registers no side_T_wall (so `S0` gains no column)",
              "side_T_wall" not in T[n], "absent")
    for n in ("HEX", "HEXR", "HEXRX"):
        check(f"(n4) {n} registers side_T_wall", "side_T_wall" in T[n], "present")
    # On a CONSTANT leg the witness must read the key back exactly. Row 0 is
    # logged before the first Advance resolves it, so it carries the -1
    # sentinel; that row is excluded and its value is asserted separately,
    # because a sentinel leaking into a LATER row would mean a face was fed
    # -1 K.
    tw = T["HEX"]["side_T_wall"]
    check("(n5) side_T_wall reads back side_face_T exactly on a constant leg",
          tw[0] == -1.0 and np.all(tw[1:] == 1463.0),
          f"row 0 = {tw[0]:.1f} (pre-Advance sentinel), rows 1.. = "
          f"[{tw[1:].min():.1f}, {tw[1:].max():.1f}] against the key's 1463.0")
    check("(n5b) the sentinel never survives into a later row",
          np.all(tw[1:] > 0.0), f"{int((tw[1:] <= 0).sum())} later rows <= 0")

    # ---- (n6) the gated legs still mirror in the ledger -------------------
    for n in ("HEX", "HEXR", "HEXRX"):
        rel = np.max(np.abs(T[n]["ledger_err"]))
        absj = np.max(np.abs(T[n]["ledger_err"] * T[n]["ledger_E_src"]))
        check(f"(n6) {n} ledger twin mirrors the gated kernel",
              rel <= 1e-12 and absj <= 1e-9,
              f"max|ledger_err| {rel:.3e} rel, {absj:.3e} J abs")

    # ---- (i) the parser ---------------------------------------------------
    for label, keys, want in ABORTS:
        pf = "ABORT_" + label.split()[0].replace("_", "")[:8] + str(len(keys))
        rc = run(pf, keys=keys, pf_name=pf)
        txt = open(os.path.join(OUT, pf + ".log")).read()
        check(f"(i) aborts: {label}", rc != 0 and want in txt,
              f"rc={rc}, {'found' if want in txt else 'MISSING: ' + want}")

    print()
    if FAIL:
        print(f"FAILED ({len(FAIL)}): " + ", ".join(FAIL))
        return 1
    print("all checks passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
