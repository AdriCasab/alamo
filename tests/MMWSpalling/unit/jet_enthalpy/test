    "B1n": (IN_S, ["surface_patch.jet_stagnation=nozzle", PROFILE], 1),
    "B3":  (IN_S, ["surface_patch.jet_dr=0.001", PROFILE], 3),
    "G":   (IN_S, G_COMMON + ['surface_patch.h_expr="100.0/max(0.02, r)"'], 1),
