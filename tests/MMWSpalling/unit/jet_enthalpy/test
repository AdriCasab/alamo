ok = True


def check(name, cond, detail):
    global ok
    print(f"[{'PASS' if cond else 'FAIL'}] {name}: {detail}")
    if not cond:
        ok = False


def run(name, outroot):
    inp, extra, nranks = RUNS[name]
    pf = os.path.join(outroot, name)
    for p in (pf, pf + "_h_col_events.csv", pf + "_removal_events.csv", pf + "_jet_profile.csv"):
        if os.path.isdir(p):
            shutil.rmtree(p)
        elif os.path.exists(p):
            os.remove(p)
    cmd = ([] if nranks == 1 else MPI(nranks)) + [BIN, inp, f"plot_file={pf}"] + extra
    print("Running:", " ".join(cmd), flush=True)
    with open(pf + ".log", "w") as log:
        return subprocess.run(cmd, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT).returncode


def thermo_text(pf):
    lines = [l.split() for l in open(os.path.join(pf, "thermo.dat")) if l.strip()]
    return lines[0], lines[1:]


def thermo(pf):
    names, rows = thermo_text(pf)
    a = np.array(rows, dtype=float)
    return {n: a[:, i] for i, n in enumerate(names)}


def events(pf):
    return np.genfromtxt(pf + "_removal_events.csv", delimiter=",", names=True, ndmin=1)


def fabs(p):
    """[(box lo, box hi, ncomp, bytes)] of a Level_0 plotfile in box-index order."""
    lev = os.path.join(p, "Level_0")
    out = []
    for l in open(os.path.join(lev, "Cell_H")):
        if not l.startswith("FabOnDisk:"):
            continue
        fname, off = l.split()[1], int(l.split()[2])
        with open(os.path.join(lev, fname), "rb") as f:
            f.seek(off)
            hdr = f.readline().decode()
            m = re.search(r"\(\((\d+),(\d+),(\d+)\) \((\d+),(\d+),(\d+)\)", hdr)
            lo = np.array(m.groups()[:3], int)
            hi = np.array(m.groups()[3:], int)
            nc = int(hdr.split()[-1])
            out.append((lo, hi, nc, hdr.encode() + f.read(8 * nc * int(np.prod(hi - lo + 1)))))
    return out


def cell_d_bytes(pf):
    return {os.path.basename(p): b"".join(x[3] for x in fabs(p))
            for p in sorted(glob.glob(os.path.join(pf, "*cell")))}


def field(p, var):
    """{(i, j, k): value} of one plotfile variable at Level_0."""
    names = open(os.path.join(p, "Header")).read().split("\n")
    ic = names[2:2 + int(names[1])].index(var)
    vals = {}
    for lo, hi, nc, blob in fabs(p):
        sh = hi - lo + 1
        data = np.frombuffer(blob[blob.index(b"\n") + 1:], "<f8").reshape(nc, sh[2], sh[1], sh[0])
        for k in range(sh[2]):
            for j in range(sh[1]):
                for i in range(sh[0]):
                    vals[(lo[0] + i, lo[1] + j, lo[2] + k)] = data[ic, k, j, i]
    return vals


def plot_time(p):
    hdr = open(os.path.join(p, "Header")).read().split("\n")
    return float(hdr[int(hdr[1]) + 3])


def same_files(a, b):
    return os.path.exists(a) and os.path.exists(b) and filecmp.cmp(a, b, shallow=False)


def jet_text(pf):
    n, rows = thermo_text(pf)
    idx = [n.index(c) for c in JET_COLS]
    return [[r[i] for i in idx] for r in rows]


def fit_rop(ev, t0, t1):
    cum = np.cumsum(ev["h_applied"])
    sel = (ev["time"] > t0) & (ev["time"] <= t1)
    if sel.sum() < 3:
        return 0.0
    return float(np.polyfit(ev["time"][sel], cum[sel], 1)[0]) * 3600.0


def strip_tgas(pf, h_of_r=None):
    """Per-column T_gas and r from the step-1 top-cell rise (cell form, no losses)."""
    T = field(os.path.join(pf, "00001cell"), "Temp")
    i = np.arange(NX_S)
    dT = np.array([T[(ii, 0, 3)] - T_S for ii in i])
    below = max(abs(T[(ii, 0, k)] - T_S) for ii in i for k in range(3))
    return i, dT, below


def replica(r, h, dr, T_noz, T_s, mcp, dA):
    """The explicit march (cell form, uniform T_s, no losses) -> jet_P_face."""
    b = np.floor(r / dr).astype(int)
    T, P = T_noz, 0.0
    for bb in np.unique(b):
        q = h[b == bb] * (T - T_s)
        Pb = float(np.sum(q[q > 0.0])) * dA
        avail = mcp * (T - 293.15)
        if Pb >= avail:
            P, T = P + avail, 293.15
        else:
            P, T = P + Pb, T - Pb / mcp
    return P, T


outroot = sys.argv[1] if len(sys.argv) > 1 else os.path.join(TEST_DIR, "output")
rcs = {}
if len(sys.argv) <= 1:
    if not os.path.exists(BIN):
        print(f"FAIL: missing binary {BIN}; build first")
        sys.exit(1)
    os.makedirs(outroot, exist_ok=True)
    for n in RUNS:
        rcs[n] = run(n, outroot)
        if rcs[n] != 0 and n not in EXPECT_FAIL:
            print(f"FAIL: run {n} exited with {rcs[n]}")
            sys.exit(1)
P = {n: os.path.join(outroot, n) for n in RUNS}

# (a) jet_closure = none is D2a
c0, c1 = cell_d_bytes(P["N0"]), cell_d_bytes(P["N1"])
check("a Cell_D N1 == N0", len(c0) > 0 and c0.keys() == c1.keys() and all(c0[k] == c1[k] for k in c0),
      f"{len(c0)} plotfiles")
check("a removal_events N1 == N0",
      same_files(P["N0"] + "_removal_events.csv", P["N1"] + "_removal_events.csv"),
      f"{events(P['N0']).size} rows")
nN0, _ = thermo_text(P["N0"])
check("a thermo.dat N1 == N0 and no jet_* column",
      same_files(os.path.join(P["N0"], "thermo.dat"), os.path.join(P["N1"], "thermo.dat"))
      and not any(c.startswith("jet_") for c in nN0), f"{len(nN0)} columns")
nQ, _ = thermo_text(P["Q"])
check("a enthalpy run: jet_* are the last eight columns", nQ[-8:] == JET_COLS,
      f"Q last eight = {nQ[-8:]}")

# (b) analytic decay on the strip
def strip_march(dr, T_stag, m, nb):
    """Discrete explicit march on the aligned strip: per-bin inlet excess."""
    ex = np.empty(nb)
    e = T_stag - T_S
    for k in range(nb):
        ex[k] = e
        rho = min((k + 0.5) * dr, R_CORE_S)
        e = e * (1.0 - 2.0 * np.pi * H_REF_S * rho * dr / (m * CP_S))
    return ex, e


def strip_exact(r, T_stag, m):
    a = np.pi * H_REF_S / (m * CP_S)
    L = m * CP_S / (2.0 * np.pi * H_REF_S * R_CORE_S)
    core = np.exp(-a * np.minimum(r, R_CORE_S) ** 2)
    return (T_stag - T_S) * core * np.exp(-np.maximum(r - R_CORE_S, 0.0) / L), L


lines, errs = [], []
cond_b = True
for n, (dr, T_stag, m) in STRIPS.items():
    i, dT, below = strip_tgas(P[n])
    r = (i + 0.5) * DX_S
    h_col = 2.0 * np.pi * H_REF_S * np.minimum(r, R_CORE_S) / DY_S
    Tg = T_S + dT * DZ_S * RHOCP / (DT_S * h_col)
    nb = int(round(0.08 / dr))
    ex, ex_end = strip_march(dr, T_stag, m, nb)
    k = np.floor(r / dr + 1e-9).astype(int)
    e_disc = float(np.max(np.abs(Tg - (T_S + ex[k])) / ex[k]))
    r_lo = k * dr
    exact, L = strip_exact(r_lo, T_stag, m)
    sel = r_lo <= R_CORE_S + 3.0 * L
    e_ana = float(np.max(np.abs((Tg - T_S) / exact - 1.0)[sel]))
    th = thermo(P[n])
    T_exh = T_S + ex_end
    e_exh = abs(th["jet_T_exhaust"][1] - T_exh) / T_exh
    e_stag = abs(th["jet_T_stag"][1] - T_stag) / T_stag
    prof = np.genfromtxt(P[n] + "_jet_profile.csv", delimiter=",", names=True, ndmin=1)
    mb = np.round(prof["r_lo"] / dr).astype(int)
    e_prof = float(np.max(np.abs(prof["T_gas"] - (T_S + ex[mb])) / prof["T_gas"]))
    e_sum = abs(np.sum(prof["P_share"]) / th["jet_P_face"][1] - 1.0)
    cond_b = (cond_b and e_disc <= 1e-9 and below == 0.0 and e_exh <= TOL_PRINT
              and e_stag <= TOL_PRINT and np.all(prof["time"] == 0.0) and prof.size == nb
              and e_prof <= 1e-12 and e_sum <= TOL_PRINT)
    if n in DRS:
        errs.append(e_ana)
    lines.append(f"{n} dr {dr * 1e3:g} mm, T_stag {th['jet_T_stag'][1]:g}, L {L * 1e3:.2f} mm: "
                 f"vs recursion {e_disc:.1e}, vs continuous {e_ana * 100:.2f} %, "
                 f"T_exhaust {th['jet_T_exhaust'][1]:g} (recursion {T_exh:.3f}), "
                 f"profile {prof.size} bins {e_prof:.0e}, sum P_share {e_sum:.0e}")
ratios = [errs[k] / errs[k + 1] for k in range(len(errs) - 1)]
check("b strip T_gas == discrete march (1e-9), T_stag / T_exhaust (print), profile", cond_b,
      "; ".join(lines))
check("b error vs the continuous march falls at first order",
      all(1.8 <= x <= 2.2 for x in ratios) and errs[-1] <= 0.05,
      f"max excess error over r_core + 3 L (decay, nozzle mass): "
      f"{', '.join(f'{e * 100:.2f} %' for e in errs)}; halving ratios {[round(x, 3) for x in ratios]}")

# (c) conservation on every row, (c2) stagnation decay
lines, lines2 = [], []
cond_c = cond_c2 = True
both_sides = False
ENTH = list(STRIPS) + ["B3", "G", "Gbug", "E", "Eon", "Q", "Qh", "Q3", "QN", "QE", "QF"]
for n in ENTH:
    th = thermo(P[n])
    quarter = n.startswith("Q")
    mdot, T_noz = (MDOT_Q, T_NOZ_Q) if quarter else (MDOT_S, T_NOZ_S)
    P_noz = mdot * CP_S * (T_noz - T_ENT)
    st = th["time"] > 0.0
    cap = th["jet_P_cap"][st]
    r1 = np.abs(th["jet_P_face"] + th["jet_P_exhaust"] - th["jet_P_cap"])[st] / P_noz
    r2 = np.abs(th["jet_P_face"] + th["jet_P_exhaust"] + th["jet_P_decay"] - P_noz)[st] / P_noz
    le = bool(np.all(th["jet_P_face"][st] <= cap * (1.0 + TOL_PRINT)))
    zero_decay = n in NOZZLE_RUNS or n in ENTRAINED_RUNS or n == "E"
    rd = float(np.max(np.abs(th["jet_P_decay"][st]))) / P_noz
    cond_c = (cond_c and r1.max() <= TOL_PRINT and r2.max() <= TOL_PRINT and le
              and (rd <= TOL_PRINT if zero_decay else np.all(th["jet_P_decay"][st] >= 0.0)))
    lines.append(f"{n} {int(st.sum())} rows {max(r1.max(), r2.max()):.0e}"
                 + (f" decay {rd:.0e}" if zero_decay else ""))
    sc = th["jet_s_c"][st]
    if n in NOZZLE_RUNS or n == "E":
        want = np.full_like(sc, T_noz)
    else:
        want = T_ENT + (T_noz - T_ENT) * np.minimum(1.0, L_CORE * JET_D / sc)
    rs = np.abs(th["jet_T_stag"][st] / want - 1.0)
    cond_c2 = cond_c2 and rs.max() <= TOL_PRINT
    if n == "QF":
        inside, outside = int(np.sum(sc <= L_CORE * JET_D)), int(np.sum(sc > L_CORE * JET_D))
        both_sides = inside > 0 and outside > 0
        lines2.append(f"QF rows s_c <= 5D: {inside}, > 5D: {outside}")
    lines2.append(f"{n} {rs.max():.0e}")
check("c jet_P_face + jet_P_exhaust == jet_P_cap; + jet_P_decay == nozzle budget", cond_c,
      "; ".join(lines))
check("c2 jet_T_stag == T_ent + (T_nozzle - T_ent) min(1, 5D/s_c)", cond_c2 and both_sides,
      "; ".join(lines2))

# (d) bin-width independence
evQ, evQh = events(P["Q"]), events(P["Qh"])
lines = []
cond_d = True
for (ci, cj), lab in (((0, 0), "centre r = 1.4 mm"), ((10, 10), "reference r = 29.7 mm")):
    a = fit_rop(evQ[(evQ["col_i"] == ci) & (evQ["col_j"] == cj)], 15.0, 30.0)
    b = fit_rop(evQh[(evQh["col_i"] == ci) & (evQh["col_j"] == cj)], 15.0, 30.0)
    ch = b / a - 1.0 if a > 0 else np.inf
    cond_d = cond_d and a > 0 and abs(ch) <= 0.02
    lines.append(f"{lab}: {a:.4f} -> {b:.4f} m/h ({ch * 100:+.3f} %)")
thQ, thQh = thermo(P["Q"]), thermo(P["Qh"])
lines.append(f"jet_P_face at 30 s {thQ['jet_P_face'][-1]:g} -> {thQh['jet_P_face'][-1]:g} W")
check("d jet_dr 2 -> 1 mm moves ROP <= 2 %", cond_d, "; ".join(lines))

# (e) no jet flux above the nozzle plane
thE, thEon = thermo(P["E"]), thermo(P["Eon"])
TE = field(os.path.join(P["E"], "00001cell"), "Temp")
q_loss = EPS * SIG * (T_S ** 4 - TA ** 4) + HC * (T_S - TA)
dT_loss = -DT_S * q_loss / (DZ_S * RHOCP)
dev = max(abs((TE[(ii, 0, 3)] - T_S) / dT_loss - 1.0) for ii in range(NX_S))
check("e s <= 0: no flame flux, losses kept, not in the march",
      thE["jet_P_face"][1] == 0.0 and thE["patch_P_robin"][1] == 0.0
      and thE["jet_T_exhaust"][1] == T_NOZ_S and thE["jet_T_stag"][1] == T_NOZ_S
      and thE["jet_s_c"][1] == 0.0 and thE["ledger_P_loss"][1] > 0.0 and dev <= 1e-9
      and thEon["jet_P_face"][1] > 0.0,
      f"E (nozzle 4 mm below the top): jet_P_face {thE['jet_P_face'][1]:g}, "
      f"patch_P_robin {thE['patch_P_robin'][1]:g}, T_exhaust {thE['jet_T_exhaust'][1]:g}, "
      f"top-cell rise / loss closed form ({dT_loss:.4e} K) - 1 <= {dev:.1e}, "
      f"ledger_P_loss {thE['ledger_P_loss'][1]:g} W; Eon jet_P_face {thEon['jet_P_face'][1]:g} W")
thF = thermo(P["QF"])
pF = sorted(glob.glob(os.path.join(P["QF"], "*cell")))[-1]
rem = field(pF, "removed")
nzq, dzq = 40, 0.002
t_last = plot_time(pF)
z_n = 0.110 - 0.001 * t_last
n_above = 0
for ci in range(24):
    for cj in range(24):
        ks = [k for k in range(nzq) if rem[(ci, cj, k)] < 0.5]
        if ks and (max(ks) + 1) * dzq - z_n >= 0.0:
            n_above += 1
check("e QF: descending nozzle passes the outer top",
      thF["time"][-1] >= T_QF_END - 2e-3 - 1e-9 and n_above > 0
      and np.all(thF["patch_min_standoff"][thF["time"] > 0] > 0.0),
      f"reached t = {thF['time'][-1]:g} s (crossing at {T_QF_CROSS:g} s); at t = {t_last:g} s "
      f"{n_above}/576 columns have s <= 0; min patch_min_standoff "
      f"{thF['patch_min_standoff'][thF['time'] > 0].min() * 1e3:.1f} mm; "
      f"jet_P_face {thF['jet_P_face'][-1]:g} W, patch_P_robin {thF['patch_P_robin'][-1]:g} W")

# (f) rank identity
for a, b in (("B1", "B3"), ("Q", "Q3")):
    ca, cb = cell_d_bytes(P[a]), cell_d_bytes(P[b])
    check(f"f {b} == {a}",
          same_files(P[a] + "_removal_events.csv", P[b] + "_removal_events.csv")
          and len(ca) > 0 and ca.keys() == cb.keys() and all(ca[k] == cb[k] for k in ca)
          and jet_text(P[a]) == jet_text(P[b])
          and (a != "B1" or same_files(P[a] + "_jet_profile.csv", P[b] + "_jet_profile.csv")),
          f"removal_events ({events(P[a]).size} rows), {len(ca)} plotfiles (FABs in box-index "
          f"order), jet_* thermo text ({len(jet_text(P[a]))} rows)")

# (g) parser trap guard
xg = (np.arange(NX_S) + 0.5) * DX_S
rg = np.abs(xg - 0.02)
dA = DX_S * DY_S
good = replica(rg, 100.0 / np.maximum(0.02, rg), 0.001, T_NOZ_S, T_S, MDOT_S * CP_S, dA)
bad = replica(rg, 100.0 * np.maximum(rg, -0.02), 0.001, T_NOZ_S, T_S, MDOT_S * CP_S, dA)
thG, thGb = thermo(P["G"]), thermo(P["Gbug"])
eg = abs(thG["jet_P_face"][1] / good[0] - 1.0)
check("g h = a/max(c, r) evaluates correctly in ALAMO", eg <= TOL_PRINT,
      f"jet_P_face {thG['jet_P_face'][1]:g} W vs replica {good[0]:.3f} W (rel {eg:.1e})")
eb_good = abs(thGb["jet_P_face"][1] / good[0] - 1.0)
eb_bad = abs(thGb["jet_P_face"][1] / bad[0] - 1.0)
state = ("AMReX rewrite trap still present (a/max(r, c) -> a*max(r, -c)); keep numbers first"
         if eb_bad <= TOL_PRINT else
         "AMReX evaluates a/max(r, c) correctly now (trap fixed upstream)"
         if eb_good <= TOL_PRINT else "matches neither replica")
check("g trap-order form classified", eb_bad <= TOL_PRINT or eb_good <= TOL_PRINT,
      f"Gbug jet_P_face {thGb['jet_P_face'][1]:g} W; correct {good[0]:.3f}, rewritten "
      f"{bad[0]:.3f}: {state}")

# (h) parse aborts
for n, msg in EXPECT_FAIL.items():
    log = open(P[n] + ".log", errors="replace").read()
    rc = rcs.get(n)
    check(f"h {n} aborts", (rc is None or rc != 0) and msg in log,
          f"rc = {rc if rc is not None else '(not rerun)'}; '{msg}' {'found' if msg in log else 'MISSING'}")

print()
print("PASS" if ok else "FAIL")
sys.exit(0 if ok else 1)
