#!/usr/bin/env python3
"""P2-8 (a4) -- unit/face_list: the face list's three rules, checked against an
INDEPENDENT Python construction of the same geometry (never the code's own output).

Geometry: ./input (generated by ./make_input.py) -- a 12 mm cube at 1 mm, Hoeser
lab configuration, h = 1000 + 20000 r + 5000 s, TWO steps (thermo writes step 1
at the next; the plotfile 00001 is after step 1), -np 4 on 8 boxes (so the
list is gathered across ranks). Cavities are seeded with spall.seed_void.

LEGS
  CAV    face_list = 1. An open pit (i 2-5, j 2-5, k 9-11), an UNDERCUT off its +x
         wall under a one-cell roof (i 6, j 3-4, k 9-10), and a CLOSED BUBBLE
         (i 7-9, j 6-8, k 3-5) -- faces in all six directions, every class.
  STAIR  face_list = 1. A 45 deg staircase in x (k_top = 13 - i for i >= 3), flat
         at i = 0-2.
  (OFF0 / CAVU, the key at 0 and unset, retired in P2-28: removal now requires the face list, so both abort)

CHECKS
  (i)   CAV: the class census (top / up / side / down) at step 1 equals the
        analytic census; every one of the six directions is present; and per
        CELL the plotfile's fl_w (sum of w over the cell's faces) equals the
        Python sum -- so a missing or extra face in ANY direction shows.
  (ii)  CAV: per cell, fl_h (the cell's largest face h) equals max over the
        cell's faces of h_expr at the FACE CENTRE, rel <= 1e-12. The top face's
        h equals the column map exactly: fl_h_top_mismatch == 0.
  (iii) CAV: w == 1 EXACTLY on a flat floor >= 3 cells from any step (P2-9 rev 2's
        smoothed normal reaches 3 cells; STAIR's flat run is too narrow); STAIR: on the interior
        staircase (i 4-9, j 2-9) sum w * dx^2 is within 2 % of the 45 deg plane's
        area (sqrt2 dx^2 per surface cell); no fallback there.
  ((iv), OFF0 == CAVU, retired in P2-28 with the legs)
Usage: test            (runs ALAMO, then checks)
       test --check    (checks existing outputs)
"""
import glob
import math
import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, "..", "..", "..", ".."))
sys.path.insert(0, os.path.join(ROOT, "tests", "MMWSpalling", "studies", "p2_2_props"))
import fabcmp                                                     # noqa: E402

BIN = os.path.join(ROOT, "bin", "mmwspalling-3d-g++")
INPUT = os.path.join(HERE, "input")
OUT = os.path.join(HERE, "output")
N, DX = 12, 0.001
Z_N, X0, Y0 = 0.0752, 0.0, 0.0
KHI = N - 1

CAV_BOXES = [(2, 2, 9, 5, 5, 11), (6, 3, 9, 6, 4, 10), (7, 6, 3, 9, 8, 5)]
STAIR_BOXES = [(i, 0, 14 - i, i, N - 1, KHI) for i in range(3, N)]   # k_top = 13 - i
LEGS = {
    "CAV":   (CAV_BOXES, ["surface_patch.face_list=1"]),
    "STAIR": (STAIR_BOXES, ["surface_patch.face_list=1"]),
}
FAIL = []


def check(name, cond, detail):
    print(f"  {'PASS' if cond else 'FAIL'}  {name}: {detail}")
    if not cond:
        FAIL.append(name)


def run(leg):
    boxes, keys = LEGS[leg]
    d = os.path.join(OUT, leg)
    if os.path.exists(d):
        shutil.rmtree(d)
    os.makedirs(d)
    sv = " ".join(str(v) for b in boxes for v in b)
    cmd = (["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "4", BIN, INPUT,
            f"plot_file={d}/run", f"spall.seed_void={sv}"] + keys)
    with open(os.path.join(d, "run.log"), "w") as f:
        return subprocess.call(cmd, cwd=ROOT, stdout=f, stderr=subprocess.STDOUT)


def solid_of(boxes):
    s = {(i, j, k): 1 for i in range(N) for j in range(N) for k in range(N)}
    for (a, b, c, d, e, f) in boxes:
        for i in range(a, d + 1):
            for j in range(b, e + 1):
                for k in range(c, f + 1):
                    s[(i, j, k)] = 0
    return s


def S_at(s, i, j, k):
    """P2-9 rev 2: the solid FRACTION (= the indicator before any firing) with the
    code's ghost rule, written independently: above the domain top is gas; a
    SYMMETRY PLANE (the patch centre X0 = Y0 = 0 sits on the low x and low y
    sides) is mirrored; every other side the nearest in-domain cell."""
    if k > KHI:
        return 0
    i = -1 - i if i < 0 else min(i, KHI)          # mirrored at x = 0 (X0 = 0)
    j = -1 - j if j < 0 else min(j, KHI)          # mirrored at y = 0 (Y0 = 0)
    k = max(k, 0)
    return s[(i, j, k)]


_E1, _E2 = math.exp(-0.5), math.exp(-2.0)
_GS = 1.0 + 2.0 * _E1 + 2.0 * _E2


def G(a):
    b = abs(a)
    return (1.0 if b == 0 else (_E1 if b == 1 else _E2)) / _GS


def smooth(s, i, j, k):
    """the fraction smoothed by the normalised Gaussian, sigma = 1 cell, +-2
    cells -- the code's summation order (c outer, a inner)."""
    t = 0.0
    for c in range(-2, 3):
        for b in range(-2, 3):
            for a in range(-2, 3):
                t += G(a) * G(b) * G(c) * S_at(s, i + a, j + b, k + c)
    return t


def expected(s):
    """per solid cell: [(dir, cls, w, h)] -- F1, F2, F3 from first principles."""
    ktop = {}
    for i in range(N):
        for j in range(N):
            ktop[(i, j)] = max(k for k in range(N) if s[(i, j, k)])
    out = {}
    for (i, j, k), v in s.items():
        if not v:
            continue
        op = [i > 0 and not s[(i - 1, j, k)], i < KHI and not s[(i + 1, j, k)],
              j > 0 and not s[(i, j - 1, k)], j < KHI and not s[(i, j + 1, k)],
              k > 0 and not s[(i, j, k - 1)], k == KHI or not s[(i, j, k + 1)]]
        if not any(op):
            continue
        # P2-9 rev 2: central differences of the SMOOTHED fraction
        gx = (smooth(s, i + 1, j, k) - smooth(s, i - 1, j, k)) / (2.0 * DX)
        gy = (smooth(s, i, j + 1, k) - smooth(s, i, j - 1, k)) / (2.0 * DX)
        gz = (smooth(s, i, j, k + 1) - smooth(s, i, j, k - 1)) / (2.0 * DX)
        gn = math.sqrt(gx * gx + gy * gy + gz * gz)
        if gn > 0:
            nx, ny, nz = -gx / gn, -gy / gn, -gz / gn
            w, fb = 1.0 / (abs(nx) + abs(ny) + abs(nz)), 0
        else:
            w, fb = 1.0, 1
        faces = []
        for d in range(6):
            if not op[d]:
                continue
            cls = ("top" if k == ktop[(i, j)] else "up") if d == 5 else \
                  ("down" if d == 4 else "side")
            xf = (i + (0.0 if d == 0 else 1.0 if d == 1 else 0.5)) * DX
            yf = (j + (0.0 if d == 2 else 1.0 if d == 3 else 0.5)) * DX
            zf = (k + 1) * DX if d == 5 else (k * DX if d == 4 else (k + 0.5) * DX)
            r = math.hypot(xf - X0, yf - Y0)
            sf = Z_N - zf
            h = 1000.0 + 20000.0 * r + 5000.0 * sf
            faces.append((d, cls, w, h, fb))
        out[(i, j, k)] = faces
    return out


def plotfile(leg, tag="00001cell"):
    d = os.path.join(OUT, leg, "run", tag)
    lvl = os.path.join(d, "Level_0")
    files = sorted(f for f in os.listdir(lvl) if f.startswith("Cell_D_"))
    first = fabcmp.read_fabs_boxed(os.path.join(lvl, files[0]))
    names = fabcmp.var_names(os.path.join(d, "Header"), first[0]["ncomp"])
    want = {n: names.index(n) for n in ("removed", "fl_w", "fl_h")}
    vals = {n: {} for n in want}
    for fn in files:
        for fab in fabcmp.read_fabs_boxed(os.path.join(lvl, fn)):
            lo, hi = fab["lo"], fab["hi"]
            nxb, nyb, nzb = (hi[q] - lo[q] + 1 for q in range(3))
            for kk in range(nzb):
                for jj in range(nyb):
                    for ii in range(nxb):
                        o = ii + nxb * (jj + nyb * kk)
                        key = (lo[0] + ii, lo[1] + jj, lo[2] + kk)
                        for n, c in want.items():
                            vals[n][key] = fab["comp"][c][o]
    return vals


def thermo_row(leg, t):
    L = open(os.path.join(OUT, leg, "run", "thermo.dat")).read().split("\n")
    h = L[0].split()
    rows = [l.split() for l in L[1:] if l.strip()]
    r = min(rows, key=lambda x: abs(float(x[h.index("time")]) - t))
    return {c: float(r[h.index(c)]) for c in h}


def main():
    if "--check" not in sys.argv:
        for leg in LEGS:
            rc = run(leg)
            print(f"  {leg}: rc={rc}")
            if rc != 0:
                check(f"{leg} runs", False, f"rc={rc}")
                return 1

    print("\n(i) CAV: the census, all six directions, and the per-cell sum of w")
    s = solid_of(CAV_BOXES)
    ex = expected(s)
    cnt = {"top": 0, "up": 0, "side": 0, "down": 0}
    dirs = set()
    for faces in ex.values():
        for (d, cls, w, h, fb) in faces:
            cnt[cls] += 1
            dirs.add(d)
    th = thermo_row("CAV", 0.008)
    for cls in cnt:
        got = th[f"fl_n_{cls}"]
        check(f"(i) census {cls}", got == cnt[cls], f"code {got:.0f} vs analytic {cnt[cls]}")
    check("(i) all six directions present in the analytic list", dirs == set(range(6)),
          f"directions {sorted(dirs)}")
    pf = plotfile("CAV")
    m_rem = [c for c in s if (pf["removed"][c] > 0.5) == bool(s[c])]
    check("(i) the plotfile mask IS the seeded geometry", not m_rem, f"{len(m_rem)} cells differ")
    bad_w, n_c = [], 0
    for c in s:
        want = 0.0
        for (d, cls, w, h, fb) in ex.get(c, []):
            want += w
        got = pf["fl_w"][c]
        n_c += 1 if want > 0 else 0
        if abs(got - want) > 1e-12 * max(1.0, abs(want)):
            bad_w.append((c, got, want))
    check("(i) per-cell sum of w (fl_w) == analytic, every cell", not bad_w,
          f"{n_c} surface cells; mismatches {bad_w[:3]}")
    fb_an = sum(fb for faces in ex.values() for (_, _, _, _, fb) in faces)
    check("(i) fl_w_fallback == analytic", th["fl_w_fallback"] == fb_an,
          f"code {th['fl_w_fallback']:.0f} vs analytic {fb_an}")

    print("\n(ii) CAV: h at the face centre")
    worst = 0.0
    for c, faces in ex.items():
        want = max(h for (_, _, _, h, _) in faces)
        got = pf["fl_h"][c]
        worst = max(worst, abs(got - want) / want)
    check("(ii) fl_h == max_face h_expr(face centre), rel <= 1e-12", worst <= 1e-12,
          f"worst rel {worst:.2e} over {len(ex)} cells")
    check("(ii) the top face reproduces the column map exactly",
          th["fl_h_top_mismatch"] == 0.0, f"fl_h_top_mismatch {th['fl_h_top_mismatch']:.0f}")
    # non-vacuity: the face centre MATTERS on this map -- the cell-centre h would differ
    side_cells = [c for c, f in ex.items() if any(x[1] == "side" for x in f)]
    c0 = side_cells[0]
    i, j, k = c0
    h_cc = 1000.0 + 20000.0 * math.hypot((i + .5) * DX, (j + .5) * DX) + 5000.0 * (Z_N - (k + .5) * DX)
    check("(ii) non-vacuous: a cell-centre h differs from the face-centre value",
          abs(h_cc - pf["fl_h"][c0]) / h_cc > 1e-6, f"cell {c0}: {h_cc:.6f} vs {pf['fl_h'][c0]:.6f}")

    print("\n(iii) the area rule")
    # P2-9 rev 2: the smoothed normal reaches 3 cells, so "flat" means a floor cell
    # >= 3 cells from every step -- CAV's flat top at i, j 9-11 (STAIR has none:
    # its flat run is 3 cells wide).
    pf_c = plotfile("CAV")
    flat = [pf_c["fl_w"][(i, j, KHI)] for i in (9, 10, 11) for j in (9, 10, 11)]
    check("(iii) w == 1 EXACTLY on a flat floor >= 3 cells from any step (CAV i, j 9-11)",
          all(v == 1.0 for v in flat), f"{len(flat)} cells, values {sorted(set(flat))}")
    pf = plotfile("STAIR")
    area, plane = 0.0, 0.0
    for i in range(4, 10):
        kt = 13 - i
        for j in range(2, 10):
            area += pf["fl_w"][(i, j, kt)] * DX * DX
            plane += math.sqrt(2.0) * DX * DX
    rel = abs(area - plane) / plane
    check("(iii) interior staircase: sum w dx^2 within 2 % of the 45 deg plane", rel <= 0.02,
          f"{area:.6e} vs {plane:.6e} m2 (rel {rel:.2e})")
    th_s = thermo_row("STAIR", 0.008)
    check("(iii) no fallback on the staircase leg", th_s["fl_w_fallback"] == 0.0,
          f"fl_w_fallback {th_s['fl_w_fallback']:.0f}")

    print("\n" + ("PASS" if not FAIL else f"FAIL: {FAIL}"))
    return 1 if FAIL else 0


if __name__ == "__main__":
    sys.exit(main())
