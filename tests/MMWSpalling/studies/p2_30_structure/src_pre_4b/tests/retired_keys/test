def source_half(pre):
    src = read_src()
    bad = 0
    print("SOURCE HALF (a0) -- POST-CHANGE src/ (must be GREEN):")
    res = clauses(src)
    for nm, ok in res:
        print("  %s  %s" % ("ok  " if ok else "FAIL", nm))
        bad += 0 if ok else 1
    print("\nMUTATION CONTROLS (each must turn its own clause RED):")
    s_all = src
    for tgt, label, fn in MUTATIONS:
        s2 = fn(src)
        changed = s2 != src
        rr = dict((k.split()[0], v) for k, v in clauses(s2))
        was = dict((k.split()[0], v) for k, v in res).get(tgt, False)
        ok = changed and was and not rr.get(tgt, True)
        print("  %s  %s: %s" % ("ok  " if ok else "FAIL", label,
              "source unchanged" if not changed else (tgt + (" goes RED" if not rr.get(tgt, True) else " STAYS GREEN"))))
        bad += 0 if ok else 1
        s_all = fn(s_all)
    still = [k.split()[0] for k, v in clauses(s_all) if v]
    print("  %s  full revert of every mutation: %s" % ("ok  " if not still else "FAIL",
          "every clause RED" if not still else "still GREEN: " + ", ".join(still)))
    bad += 1 if still else 0
    if pre:
        red = (sys.argv[sys.argv.index("--red") + 1] if "--red" in sys.argv else "R1,R2,R3").split(",")
        rp = clauses(read_src(pre))
        print("\nPRE-CHANGE headers (%s) -- %s must be RED, every other clause GREEN:" % (pre, ",".join(red)))
        for nm, ok in rp:
            want = nm.split()[0] not in red
            print("  %s  %s" % (("GRN " if ok else "RED ") + ("    " if ok == want else "!!  "), nm[:100]))
            bad += 0 if ok == want else 1
    return bad


