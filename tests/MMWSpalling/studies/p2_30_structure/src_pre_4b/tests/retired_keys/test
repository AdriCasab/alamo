def clauses(src):
    out = []

    def need(name, ok):
        out.append((name, bool(ok)))

    left = ["%s:%d" % (rel, ln) for rel, t in src.items()
            for ln, line in enumerate(t.split("\n"), 1) if DELETED.search(line)]
    need("R1 no deleted constraint-depth name anywhere in src/ (%d line(s)%s)"
         % (len(left), (": " + ", ".join(left[:4])) if left else ""), not left)

    m = _src.header(src)              # P2-30: the header's text, slices expanded
    total = sum(t.count(KEY) for t in src.values())
    body = re.search(r"static void Parse\(MMWSpalling& value, IO::ParmParse& pp\)\s*\{([\s\S]*?)\n    \}\n", m)
    body = body.group(1) if body else ""
    lst = re.search(r'for \(const char\* k : \{"%s"\}\)\s*if \(pp\.contains\(k\)\)\s*Util::Abort\(INFO, k,'
                    % re.escape(KEY), body)
    first_q = re.search(r"pp\.(?:query|queryclass|select|get|contains\(\"(?!%s))" % re.escape(KEY),
                        body[:lst.start()] if lst else "")
    # the P2-10 loop's own `pp.contains(k)` is the only query allowed before it
    pre_q = [x for x in re.finditer(r"pp\.\w+\(", body[:lst.start()] if lst else "")
             if not x.group(0).startswith("pp.contains(")]
    need("R2 the key appears in src/ exactly once, in the P2-16 retired-key list, which runs in Parse before any "
         "key is queried (%d occurrence(s))" % total,
         total == 1 and lst is not None and not pre_q and first_q is None)

    msg = re.search(r'for \(const char\* k : \{"%s"\}\)[\s\S]*?remove "\s*"it from the input"\);' % re.escape(KEY), m)
    need("R3 the abort names the key (the loop variable k) and P2-16",
         msg is not None and "P2-16" in msg.group(0) and "Util::Abort(INFO, k," in msg.group(0))

    probes = ['"spall.lateral_drive"', '"surface_patch.side_face_flux"', '"surface_patch.jet_wall_march"']
    need("R4 P2-10's retired-key list is intact (3 probes) and its message unchanged",
         all(m.count(p) == 1 for p in probes)
         and 'was retired in P2-10 (the flame wall machinery: "' in m)

    bm = src[SUBST["MMWBeam.H"]]
    bm_code = "\n".join(l.split("//")[0] for l in bm.split("\n"))
    idents = sum(len(re.findall(r"\b(?:alpha_parser|alpha_f)\b", t)) for t in src.values())
    nstr = {k: sum(t.count('"%s"' % k) for t in src.values()) for k in ("beam.alpha_expr", "beam.R")}
    lst20 = re.search(r'for \(const char\* k : \{"beam\.alpha_expr", "beam\.R"\}\)\s*if \(pp\.contains\(k\)\)'
                      r'\s*Util::Abort\(INFO, k, " was retired in P2-20', m)
    i_beam = m.find('pp.queryclass<Numeric::MMWBeam>("beam"')
    i_lam = bm_code.find('pp.query_default("lambda"')
    i_eps = bm_code.find('pp.query_default("eps_r"')
    i_td = bm_code.find('pp.query_default("tan_delta"')
    i_a = bm_code.find("v.alpha = ")
    i_r = bm_code.find("v.R = ")
    need("R5 (P2-20) no alpha_parser/alpha_f in src/ (%d); MMWBeam.H has no parser and no alpha_expr/R query; "
         "eps_r, tan_delta parsed after lambda, alpha and R formed after both; each key string once (%s), in the "
         "P2-20 list before the beam parse" % (idents, nstr),
         idents == 0 and "registerVariables" not in bm_code and "amrex::Parser" not in bm_code
         and '"alpha_expr"' not in bm_code and 'query_default("R"' not in bm_code
         and 0 <= i_lam < i_eps < i_td < min(i_a, i_r) and i_a >= 0 and i_r >= 0
         and nstr == {"beam.alpha_expr": 1, "beam.R": 1} and lst20 is not None and 0 <= lst20.start() < i_beam)

    want = "v.alpha = 2.0 * M_PI * std::sqrt(v.eps_r) * (v.tan_delta / v.lambda);"
    n_assign = len(re.findall(r"\bv\.alpha\s*=[^=]", bm_code))
    need("R6 (P2-21) MMWBeam.H forms alpha in the locked association `%s` (%d assignment(s) of v.alpha)"
         % (want[10:-1], n_assign), bm_code.count(want) == 1 and n_assign == 1)

    tab = re.search(r"static const RetiredAtDefault retired_at_default\[\] = \{([\s\S]*?)\n        \};", m)
    tab = tab.group(1) if tab else ""
    for tag, keys in P2_26.items():
        cnt = {k: sum(t.count('"%s"' % k) for t in src.values()) for k in keys}   # P2-28: quoted literals
        inn = {k: re.search(r'\{"%s",\s*"%s",' % (re.escape(k), re.escape(v)), tab) is not None
               for k, v in keys.items()}
        need("%s (P2-26) each key string appears in src/ exactly once, as its retired-at-default entry with the "
             "old default (%s)" % (tag, ", ".join("%s %d%s" % (k, cnt[k], "" if inn[k] else " NOT IN TABLE")
                                                 for k in keys)),
             all(c == 1 for c in cnt.values()) and all(inn.values()))
    # P2-27 R10 (census C1b): the three fields are deregistered
    left10 = ["%s:%d" % (rel, ln) for rel, t in src.items()
              for ln, line in enumerate(t.split("\n"), 1) if C1B.search(line)]
    reg10 = sum(len(re.findall(r'RegisterNewFab\([^;]*"(?:D|kappa_eff|k_eff)"', t)) for t in src.values())
    need("R10 (P2-27) D, kappa_eff, k_eff deregistered: no identifier (%d line(s)%s), no registration (%d)"
         % (len(left10), (": " + ", ".join(left10[:4])) if left10 else "", reg10), not left10 and reg10 == 0)
    # P2-27 R9 (census C1a): the damage lineage
    left9 = ["%s:%d" % (rel, ln) for rel, t in src.items()
             for ln, line in enumerate(t.split("\n"), 1) if C1A.search(line)]
    hdrs = [h for h in ("Numeric/DruckerPrager.H", "Numeric/CohesiveZone.H") if h in src]
    cnt9 = {k: sum(t.count('"%s"' % k) for t in src.values()) for k in P2_27_TABLE}
    inn9 = {k: re.search(r'\{"%s",\s*"%s",' % (re.escape(k), re.escape(v)), tab) is not None
            for k, v in P2_27_TABLE.items()}
    lst27 = re.search(r"P2-27 \(census C1a\)[\s\S]*?for \(const char\* k : \{([^}]*)\}\)", m)
    keys27 = re.findall(r'"([\w.]+)"', lst27.group(1)) if lst27 else []
    fam = all(('"%s"' % f) in m for f in ("damage", "cohesive")) and "P2-27" in m
    # damage.enabled appears TWICE by design: its table row, and the family loop's exemption `k != "damage.enabled"`
    want9 = {k: (2 if k == "damage.enabled" else 1) for k in P2_27_TABLE}
    exempt = 'k != "damage.enabled"' in m
    need("R9 (P2-27) no damage-lineage identifier in src/ (%d line(s)%s), DruckerPrager.H / CohesiveZone.H gone (%s); "
         "the three table keys in the table, once each (damage.enabled twice: + the family exemption) (%s); the P2-27 "
         "list names the eight spall.* keys (%d) and the damage / cohesive families"
         % (len(left9), (": " + ", ".join(left9[:4])) if left9 else "", hdrs or "gone",
            ", ".join("%s %d%s" % (k, cnt9[k], "" if inn9[k] else " NOT IN TABLE") for k in P2_27_TABLE), len(keys27)),
         not left9 and not hdrs and cnt9 == want9 and exempt and all(inn9.values())
         and sorted(keys27) == sorted(P2_27_SPALL) and fam)
    # P2-28 R11 (census H): the column path is gone -- no column-only name in src/ (comments included, string
    # literals excluded), Removal.H absent, each retired key string once as a QUOTED literal in its table row or
    # abort list, the three families in the P2-28 family loop
    nolit = {rel: re.sub(r'"(?:[^"\\\n]|\\.)*"', '""', t) for rel, t in src.items()}
    left11 = sorted({n for n in P2_28_NAMES for t in nolit.values()
                     if re.search(r"(?<![A-Za-z_])%s" % re.escape(n), t)})
    rem_there = SUBST["Removal.H"] in src
    cnt11 = {k: sum(t.count('"%s"' % k) for t in src.values()) for k in list(P2_28_TABLE) + P2_28_ABORT}
    inn11 = {k: re.search(r'\{"%s",\s*"%s",' % (re.escape(k), re.escape(v)), tab) is not None
             for k, v in P2_28_TABLE.items()}
    lst28 = re.search(r"P2-28 \(census H\)[\s\S]*?for \(const char\* k : \{([^}]*)\}\)", m)
    keys28 = re.findall(r'"([\w.]+)"', lst28.group(1)) if lst28 else []
    fam28 = re.search(r"for \(const char\* family : \{([^}]*)\}\)[\s\S]{0,400}?retired in P2-28", m)
    fams = re.findall(r'"([\w.]+)"', fam28.group(1)) if fam28 else []
    need("R11 (P2-28) the column path is gone: column-only names left %s; Removal.H %s; the retired key strings once "
         "each as quoted literals (%s), the table rows with their value (%s), the presence list %s, the families %s"
         % (left11 or "none", "PRESENT" if rem_there else "deleted",
            ", ".join("%s %d" % (k, c) for k, c in cnt11.items() if c != 1) or "all once",
            "ok" if all(inn11.values()) else [k for k, v in inn11.items() if not v], sorted(keys28), sorted(fams)),
         not left11 and not rem_there and all(c == 1 for c in cnt11.values()) and all(inn11.values())
         and sorted(keys28) == sorted(P2_28_ABORT) and sorted(fams) == sorted(P2_28_FAMILY))
    # P2-29 R12 (census D): one heat path -- the separate kernels' names gone (comments included), the half-conductance
    # prescribed term gone everywhere in src/ (b4), the three table rows at their values, the presence list + families
    left12 = sorted({n for n in P2_29_NAMES for t in nolit.values()
                     if re.search(r"(?<![A-Za-z_])%s(?![A-Za-z_])" % re.escape(n), t)})
    half = sum(len(re.findall(r"(?<!2\.0 \* )\bkc \* \(sp_T - Tc\) \* inv_dz2", t)) for t in src.values())
    inn12 = {k: re.search(r'\{"%s",\s*"%s",' % (re.escape(k), re.escape(v)), tab) is not None
             for k, v in P2_29_TABLE.items()}
    lst29 = re.search(r"P2-29 \(census D\)[\s\S]*?for \(const char\* k : \{([^}]*)\}\)", m)
    keys29 = re.findall(r'"([\w.]+)"', lst29.group(1)) if lst29 else []
    fam29 = re.search(r"P2-29 \(census D\)[\s\S]*?for \(const char\* family : \{([^}]*)\}\)", m)
    fams29 = re.findall(r'"([\w.]+)"', fam29.group(1)) if fam29 else []
    nph = re.search(r'if \(!pp\.contains\("microstructure\.nphases"\)\)[\s\S]{0,120}?P2-29', m) is not None
    need("R12 (P2-29) one heat path: the separate kernels' names left %s; half-conductance terms %d; the table rows %s; "
         "the presence list %s, the families %s; a deck without nphases aborts: %s"
         % (left12 or "none", half, "ok" if all(inn12.values()) else [k for k, v in inn12.items() if not v],
            sorted(keys29), sorted(fams29), nph),
         not left12 and half == 0 and all(inn12.values()) and sorted(keys29) == sorted(P2_29_ABORT)
         and sorted(fams29) == sorted(P2_29_FAMILY) and nph)
    return out


def _mmw(fn):
    """a mutation is an edit of ONE file: apply `fn` to the class file (the parent, then each slice) holding its target"""
    def go(s):
        for nm in [MMW] + [_src.SLICE_PREFIX + n for n in _src.slices(s) if n not in _src.FRAGMENTS]:
            t = fn(s[nm])
            if t != s[nm]:
                return dict(s, **{nm: t})
        return s
    return go


