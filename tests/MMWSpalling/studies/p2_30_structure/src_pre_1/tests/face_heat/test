# ------------------------------------------------------------------ geometry ----
def plane_seeds(theta=35.0, z0=0.13):
    """void above the plane through (0, 0, z0) tilted theta in x-z (downhill +x): one y-strip per column i"""
    t = math.radians(theta)
    out = []
    for i in range(NX):
        zs = z0 - math.tan(t) * (i + 0.5) * DX
        ks = max(int(math.floor(zs / DX + 1e-9 - 0.5)) + 1, 0)
        if ks <= NZ - 1:
            out.append((i, 0, ks, i, NX - 1, NZ - 1))
    return out


def bore_seeds(R=12, dep=24):
    out = []
    for i in range(NX):
        for j in range(NX):
            if math.hypot(i + 0.5, j + 0.5) < R:
                out.append((i, j, NZ - dep, i, j, NZ - 1))
    return out


def exact(name, I, J, K):
    """the analytic surface distance [m] at cell centres"""
    x, y, z = (I + 0.5) * DX, (J + 0.5) * DX, (K + 0.5) * DX
    if name.startswith("FLAT") or name.startswith("FLANGE"):
        return np.hypot(x, y)
    if name.startswith("PLANE"):
        t = math.radians(35.0)
        n = np.array([math.sin(t), 0.0, math.cos(t)])
        d = np.stack([x, y, z - 0.13], -1)
        d = d - (d @ n)[..., None] * n
        return np.sqrt((d ** 2).sum(-1))
    R, top, dep = 0.012, 0.15, 0.024
    r = np.hypot(x, y)
    return np.where(z > top - DX, R + dep + np.maximum(0.0, r - R),
                    np.where(r < R - 0.5 * DX, r, R + np.maximum(0.0, z - (top - dep))))


