def p210_window(evs, nx, planner=False):
    """interior firings in [5, 20] s -- phase_rate's own filter; `planner`: the
    packet's baseline table's filter (col_i >= 4 only), for the reconciliation row."""
    out = []
    for e in evs:
        t = float(e["time"])
        i, j = int(e["col_i"]), int(e["col_j"])
        if not (T0_WIN <= t <= T1_WIN):
            continue
        if (i >= 4) if planner else (4 <= i <= nx - 5 and 4 <= j <= nx - 5):
            out.append(e)
    return out


def p210_fire_stats(evs, dxk, n, planner=False):
    """b2 + b3 on one leg: per-firing normal recession, firings per line, dir
    shares, flips and the logged-mu lean per direction."""
    nx = MESH[dxk][0]
    w = p210_window(evs, nx, planner)
    if not w:
        return None
    rec = [float(e["h_line"]) * abs(n[int(e["dir"]) // 2]) for e in w]
    by = {}
    for e in sorted(w, key=lambda e: float(e["time"])):
        by.setdefault((int(e["col_i"]), int(e["col_j"])), []).append(int(e["dir"]))
    nflip = sum(1 for v in by.values() for a, b in zip(v, v[1:]) if a != b)
    npair = sum(max(len(v) - 1, 0) for v in by.values())
    dirs = {}
    for e in w:
        dirs.setdefault(int(e["dir"]), []).append(float(e["mu"]))
    lean = {}
    for d, mus in dirs.items():
        true = abs(n[d // 2])
        lean[d] = (len(mus), math.degrees(math.acos(min(1.0, true)))
                   - math.degrees(math.acos(min(1.0, float(np.median(mus))))))
    return {"n": len(w), "rec": float(np.mean(rec)), "lines": len(by),
            "per_line": len(w) / len(by), "flips": nflip / npair if npair else float("nan"),
            "dir": {d: len(v) / len(w) for d, v in dirs.items()}, "lean": lean}


def p210_normal_field(pf, dxk):
    """the code's normal, OFFLINE: the plotfile fraction with the code's ghost rule
    (x0 = y0 = 0: the low x and y sides mirrored, above the top gas, other sides the
    nearest cell), smoothed by the normalised Gaussian (sigma 1 cell, +-2), central
    differences. Returns n (3, nx, nx, nz), the zero-gradient mask, fl_w and the
    open-face count per cell (in-domain void neighbours + the domain top)."""
    nx, nz = MESH[dxk][0], MESH[dxk][1]
    dx = DXM[dxk]
    d = read_pf(pf, ["fr_f", "fl_w", "removed"], (nx, nx, nz))
    F = d["fr_f"]
    P = np.pad(F, ((3, 0), (0, 0), (0, 0)), mode="symmetric")
    P = np.pad(P, ((0, 3), (0, 0), (0, 0)), mode="edge")
    P = np.pad(P, ((0, 0), (3, 0), (0, 0)), mode="symmetric")
    P = np.pad(P, ((0, 0), (0, 3), (0, 0)), mode="edge")
    P = np.pad(P, ((0, 0), (0, 0), (3, 0)), mode="edge")
    P = np.pad(P, ((0, 0), (0, 0), (0, 3)), mode="constant", constant_values=0.0)
    e1, e2 = math.exp(-0.5), math.exp(-2.0)
    gs = 1.0 + 2.0 * e1 + 2.0 * e2
    g = {0: 1.0 / gs, 1: e1 / gs, 2: e2 / gs}
    S = P.copy()
    for ax in range(3):            # separable: 5 taps per axis; trims 2 per side
        L = S.shape[ax] - 4
        acc = 0.0
        for a in range(-2, 3):
            sl = [slice(None)] * 3
            sl[ax] = slice(2 + a, 2 + a + L)
            acc = acc + g[abs(a)] * S[tuple(sl)]
        S = acc
    # S now spans indices -1 .. n (one ghost per side)
    gx = (S[2:, 1:-1, 1:-1] - S[:-2, 1:-1, 1:-1]) / (2.0 * dx)
    gy = (S[1:-1, 2:, 1:-1] - S[1:-1, :-2, 1:-1]) / (2.0 * dx)
    gz = (S[1:-1, 1:-1, 2:] - S[1:-1, 1:-1, :-2]) / (2.0 * dx)
    gn = np.sqrt(gx * gx + gy * gy + gz * gz)
    zero = ~(gn > 0)
    gn_s = np.where(zero, 1.0, gn)
    N = np.stack([-gx / gn_s, -gy / gn_s, -gz / gn_s])
    void = d["removed"] > 0.5
    V = np.pad(void, 1, mode="constant", constant_values=False)
    nf = np.zeros(F.shape, dtype=int)
    for ax in range(3):
        for s_ in (-1, 1):
            sl = [slice(1, -1)] * 3
            sl[ax] = slice(1 + s_, V.shape[ax] - 1 + s_)
            nf += V[tuple(sl)].astype(int)
    nf[:, :, -1] += 1              # the domain top is a face
    nf[void] = 0
    return N, zero, d["fl_w"], nf


def p210_field(lg, dxk, n_true, t):
    """b4w and b4 at plotfile time t."""
    pfs = [p for p in p210_plotfiles(lg) if round(pf_time(p)) == t]
    if not pfs:
        return None
    N, zero, flw, nf = p210_normal_field(pfs[0], dxk)
    w_off = np.where(zero, 1.0, 1.0 / (np.abs(N).sum(axis=0) + np.where(zero, 1.0, 0.0)))
    listed = flw > 0
    agree = np.abs(flw - nf * w_off) <= 1e-9
    nx, nz = MESH[dxk][0], MESH[dxk][1]
    I, J, K = np.meshgrid(np.arange(nx), np.arange(nx), np.arange(nz), indexing="ij")
    interior = listed & (I >= 4) & (I <= nx - 5) & (J >= 4) & (J <= nx - 5) & (K >= 4) & (K <= nz - 5) & ~zero
    # fired = listed interior cells that FIRE in (t, t + 1] -- the state the logged
    # mu is taken from (a cell that fired before t is usually void by t at 0.5 mm)
    fired = np.zeros(listed.shape, dtype=bool)
    for e in p210_events(lg):
        te = float(e["time"])
        if t + 1e-9 < te <= t + 1.0 + 1e-9:
            i, j, k = int(e["col_i"]), int(e["col_j"]), int(e["k"])
            if 0 <= i < nx and 0 <= j < nx and 0 <= k < nz:
                fired[i, j, k] = True
    nzt = abs(n_true[2])
    lean = math.degrees(math.acos(min(1.0, nzt))) - np.degrees(np.arccos(np.clip(np.abs(N[2]), 0, 1)))
    ax_true = dominant(n_true)
    ax = np.argmax(np.abs(N), axis=0)

    def q(m):
        v = lean[m]
        if v.size == 0:
            return (0, float("nan"), float("nan"), float("nan"))
        return (int(v.size), float(np.median(v)), float(np.percentile(v, 25)), float(np.percentile(v, 75)))
    return {"listed": int(listed.sum()), "agree": float(agree[listed].mean()) if listed.any() else float("nan"),
            "all": q(interior), "fired": q(interior & fired), "unfired": q(interior & ~fired),
            "z_share": float((ax[interior] == 2).mean()) if interior.any() else float("nan"),
            "off_axis": float((ax[interior] != ax_true).mean()) if interior.any() else float("nan")}


