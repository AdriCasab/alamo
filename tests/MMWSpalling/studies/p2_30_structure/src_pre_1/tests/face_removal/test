                         nm, dxk, t, f["listed"], f["agree"], "ok" if f["agree"] >= 0.99 else "NOT QUOTABLE",
                         "%d: %+.2f [%+.2f, %+.2f]" % f["all"], "%d: %+.2f [%+.2f, %+.2f]" % f["fired"],
                         "%d: %+.2f [%+.2f, %+.2f]" % f["unfired"], f["z_share"], f["off_axis"]))
    txt = "\n".join(L)
    print(txt)
    open(os.path.join(P210, "TILT45.txt"), "w").write(txt + "\n")


def run_curved():
    for nm in ("SPH", "BORE"):
        for dxk in ("1", "2"):
            dx = DXM[dxk]
            run_leg("%s_%s" % (nm, dxk), dict(MI.curved_keys(nm, dx), **{"surface_patch.face_list": "1",
                                                                           "stop_time": "20.0"}),
                    seeds=MI.curved_seeds(nm, dx))


def check_curved(R=None):
    if R is None:
        R = floor_rates()
    print("\n(a6) SPH and BORE: rate vs T00 key 1; per-bin / per-sector recession")
    for nm in ("SPH", "BORE"):
        for dxk in ("1", "2"):
            if not plotfiles("%s_%s" % (nm, dxk)):
                print("  REPORT  %s_%s missing" % (nm, dxk))
                continue
            r, bins = curved_rate(nm, dxk)
            ref = R.get((dxk, 1), (float("nan"), 0))[0]
            b = np.array(bins)
            print("  REPORT  %s %s mm: rate %.6e vs T00 %.6e m/s (rel %+.4f); %s %d: min %.4e max %.4e "
                  "spread %.3f of mean" % (nm, dxk, r, ref, r / ref - 1, "bins" if nm == "SPH" else "sectors",
                                           len(b), b.min(), b.max(), (b.max() - b.min()) / b.mean()))
            mm, idr = witness_rows("%s_%s" % (nm, dxk))
            print("          fr_multi max %g, fr_id_remap max %.2e" % (mm, idr))


def floor_rates():
    R = {}
    for dxk in ("2", "1", "05"):
        lg = leg_T00(dxk, 1)
        if plotfiles(lg):
            R[(dxk, 1)] = rate(lg, dxk, np.array([0.0, 0.0, 1.0]))
    return R


def check_floor():
    # P2-28: the key-0 reference (the column path) is retired, so a4's key 0 vs key 1 bars are retired with it;
    # the key-1 floor is reported and c4's mesh spread below stays
    print("\n(a4) T00 on the face list at each dx (REPORT; the key-0 comparison is retired, P2-28)")
    R = floor_rates()
    for dxk in ("2", "1", "05"):
        if (dxk, 1) not in R:
            need(False, "T00 %s mm: key-1 leg missing" % dxk)
            continue
        r1, n1 = R[(dxk, 1)]
        e1 = events(leg_T00(dxk, 1))
        m1 = float(np.median([float(e["T_surf"]) for e in e1])) if e1 else float("nan")
        h1, D1 = thermo(leg_T00(dxk, 1))
        E1 = D1[-1, h1.index("ledger_E_flake")]
        print("  REPORT  T00 %s mm: rate %.6e m/s (%d lines), median firing T_s %.4f K, ledger_E_flake %.6e J"
              % (dxk, r1, n1, m1, E1))
    print("\n(c4, first half) T00 key-1 rate spread over 2 / 1 / 0.5 mm")
    rs = [R[(d, 1)][0] for d in ("2", "1", "05") if (d, 1) in R]
    if len(rs) == 3:
        spread = (max(rs) - min(rs)) / np.mean(rs)
        print("  REPORT  rates %s m/s, spread %.4f (bar 0.02) %s"
              % (", ".join("%.6e" % r for r in rs), spread, "within" if spread <= 0.02 else "OUTSIDE"))
    return R


def check_tilt(R=None):
    if R is None:
        R = floor_rates()
    print("\n(a5) tilted planes at 1 mm vs T00 key 1 at 1 mm")
    ref = R.get(("1", 1), (float("nan"), 0))[0]
    for nm, (th, ph) in TILTS_P29.items():
        lg = leg_tilt(nm, "1")
        if not plotfiles(lg):
            need(False, "%s missing" % lg)
            continue
        n = normal(th, ph)
        r, nl = rate(lg, "1", n)
        rel = r / ref - 1
        need(abs(rel) <= 0.04, "%s (theta %.1f az %.0f): normal rate %.6e vs %.6e m/s over %d lines, rel %+.4f (bar 0.04)"
             % (nm, th, ph, r, ref, nl, rel))
        mm, idr = witness_rows(lg)
        need(mm == 0, "%s fr_multi max %g" % (nm, mm))
        ev = events(lg)
        ns = [e for e in ev if int(e["ts_fb"]) == 0 or float(e["mu"]) < 0.999999]
        # non-sheet firings: a sheet reads mu = 1 exactly with its line behind a face
        share = (sum(1 for e in ev if float(e["mu"]) >= 0.57) / len(ev)) if ev else float("nan")
        need(share >= 0.99, "%s share of firings with mu >= 0.57: %.4f of %d (bar 0.99)" % (nm, share, len(ev)))
    print("\n(c4, second half) tilted planes at 2 mm vs T00 key 1 at 2 mm")
    ref2 = R.get(("2", 1), (float("nan"), 0))[0]
    for nm, (th, ph) in TILTS_P29.items():
        lg = leg_tilt(nm, "2")
        if not plotfiles(lg):
            print("  REPORT  %s missing" % lg)
            continue
        r, nl = rate(lg, "2", normal(th, ph))
        rel = r / ref2 - 1
        print("  REPORT  %s 2 mm: %.6e vs %.6e m/s over %d lines, rel %+.4f (bar 0.04) %s"
              % (nm, r, ref2, nl, rel, "within" if abs(rel) <= 0.04 else "OUTSIDE"))


def main():
    args = set(sys.argv[1:])
    os.makedirs(OUT, exist_ok=True)
    check_only = "--check" in args
    if "--offline" in args or check_only:
        if not check_only:
            run_offline()
        check_offline()
        check_rev2()
    R = None
    if "--floor" in args or check_only:
        if not check_only:
            run_floor()
        R = check_floor()
    if "--tilt" in args or check_only:
        if not check_only:
            run_tilt()
        check_tilt(R)
    if "--a5b" in args:
        if not check_only:
            run_a5b()
        check_a5b()
    if "--p2_10" in args:          # P2-10 b1-b4: runs only legs without a .done, then reports
        if "--report" not in args:
            run_p2_10()
        check_p2_10()
    if "--curved" in args or check_only:
        if not check_only:
            run_curved()
        check_curved(R)
    print("\n" + ("PASS" if not FAIL else "FAIL (%d)" % len(FAIL)))
    sys.exit(0 if not FAIL else 1)


if __name__ == "__main__":
    main()
