def check_source():
    # P2-28: the column half (Removal.H and the column reconstruction, both deleted) is retired; what stays is the
    # ONE-declaration rule and the line path's calls
    print("\n(a3 i) one reconstruction, one scan, one remap -- declared once, called by the line path")
    rd = lambda *q: open(os.path.join(ROOT, "src", "Integrator", *q)).read()
    code = lambda t: "\n".join(l.split("//")[0] for l in t.split("\n"))
    frm, mmw, shr = code(rd("MMWSpalling", "FaceRemoval.H")), code(rd("MMWSpalling.H")), \
        code(rd("MMWSpalling", "Shared.H"))
    line = frm[frm.index("void RecedeAlongLines("):]                     # the line path
    line_all = frm                                                       # incl. RecedeAlongLine
    for fn, decl in (("ReconFromX(", "static SurfaceRecon ReconFromX("),
                     ("ScanTAtZv(", "static Set::Scalar ScanTAtZv("),
                     ("ScanKIcPa(", "Set::Scalar ScanKIcPa("),
                     ("ScanSigmaT(", "Set::Scalar ScanSigmaT("),
                     ("DepthScanH(", "static Set::Scalar DepthScanH("),
                     ("RemapProfile(", "static Set::Scalar RemapProfile(")):
        n_decl = len(re.findall(re.escape(decl), frm + mmw + shr))
        in_line = fn in line_all
        need(n_decl == 1 and in_line, "`%s` declared once (%d), called by the line path (%s)"
             % (fn[:-1], n_decl, in_line))
    for fn in ("RecedeAlongLine(", "DepthScanH(", "ReduceRealSum(G.data()"):
        need(line.count(fn) == 1, "the line path makes ONE `%s` call (%d)" % (fn, line.count(fn)))


def check_offline():
    check_source()
    print("\n(a3 ii) a one-cell sheet over a void: run = 1, h <= dx")
    ev = events("SHEET")
    roof = [e for e in ev if 6 <= int(e["col_i"]) <= 17 and 6 <= int(e["col_j"]) <= 17 and int(e["k"]) == 63]
    # ⚠ rev 2: the smoothed normal of a one-cell roof is NOT zero (the solid below
    # the void sits within the +-2 stencil), so the roof is no longer an F3 sheet;
    # (ii) is about the GEOMETRY -- a roof cell whose line meets the void at once
    sh = [e for e in roof if e["run"] == "1"]
    print("        roof firings %d, of them with run 1 (the one-cell roof over the void) %d; "
          "F3-sheet flag on %d" % (len(roof), len(sh), sum(1 for e in roof if e["sheet"] == "1")))
    need(len(sh) > 0, "the roof fires along lines into the void (%d run-1 firings)" % len(sh))
    if sh:
        need(all(e["through"] == "1" for e in sh), "every run-1 roof firing breaks THROUGH (%s)"
             % sorted(set(e["through"] for e in sh)))
        hmax = max(float(e["h_line"]) for e in sh)
        need(hmax <= 0.001 * (1 + 1e-12), "h_line <= dx on every run-1 roof firing (max %.6e m)" % hmax)
    print("\n(a3 iii) h = 0.001 everywhere for 5 s => no firing")
    need(len(events("COLD")) == 0, "COLD: %d firings" % len(events("COLD")))
    print("\n(a3 iv) the event log does not depend on the decomposition")
    ref = os.path.join(OUT, "DEC_np4_m16", "run_removal_events.csv")
    for nm in ("DEC_np1_m16", "DEC_np4_m8"):
        p = os.path.join(OUT, nm, "run_removal_events.csv")
        same = os.path.exists(ref) and os.path.exists(p) and open(ref, "rb").read() == open(p, "rb").read()
        need(same, "%s == DEC_np4_m16 byte for byte (%d rows)" % (nm, len(events(nm))))
    lat = [e for e in events("DEC_np4_m16") if e["dir"] != "5"]
    need(len(lat) > 0, "non-vacuous: the cavity fires off +z lines too (%d wall/roof firings)" % len(lat))
    print("\n(a3 v) fr_multi = 0 and fr_id_remap <= 1e-12 on every row of every leg run here")
    for nm in sorted(os.listdir(OUT)):
        if not os.path.exists(os.path.join(OUT, nm, "run", "thermo.dat")):
            continue
        hdr, _ = thermo(nm)
        if "fr_multi" not in hdr:
            continue
        mm, idr = witness_rows(nm)
        need(mm == 0 and idr <= 1e-12, "%-12s fr_multi max %g, fr_id_remap max %.3e" % (nm, mm, idr))
    print("\n(a3 vi) the area rule at every tilt: sum w dx^2 over the initial interior faces")
    for nm, (th, ph) in TILTS_P29.items():
        lg = "AREA_" + nm
        pfs = plotfiles(lg)
        if len(pfs) < 2:
            need(False, "%s has no 1 s plotfile" % lg)
            continue
        n = normal(th, ph)
        a = dominant(n)
        mu = abs(n[a])
        nx, nz = MESH["1"][0], MESH["1"][1]
        d = read_pf(pfs[1], ["fl_w", "removed"], (nx, nx, nz))
        w = d["fl_w"]
        other = [q for q in range(3) if q != a]
        sides = [nx, nx, nz]
        s = w.sum(axis=a)
        tot, nlines = 0.0, 0
        for u in range(s.shape[0]):
            for v in range(s.shape[1]):
                if u < 4 or u > sides[other[0]] - 5 or v < 4 or v > sides[other[1]] - 5:
                    continue
                if s[u, v] <= 0:
                    continue
                tot += s[u, v]
                nlines += 1
        rel = tot / (nlines / mu) - 1 if nlines else float("nan")
        need(nlines > 0 and abs(rel) <= 0.04,
             "%s (theta %.1f): sum w = %.3f over %d interior lines vs plane %.3f (rel %+.4f)"
             % (nm, th, tot, nlines, nlines / mu, rel))


def check_rev2():
    import math as _m
    print("\n(a3 vi, SPH) the area rule on a closed sphere: sum w dx^2 vs 4 pi R^2")
    pfs = plotfiles("AREA_SPH")
    if len(pfs) >= 2:
        n = int(round(MI.CURVED["SPH"]["L"] / 0.001))
        w = read_pf(pfs[1], ["fl_w"], (n, n, n))["fl_w"]
        xc = (np.arange(n) + 0.5) * 0.001 - MI.CURVED["SPH"]["L"] / 2
        X, Y, Z = np.meshgrid(xc, xc, xc, indexing="ij")
        near = np.sqrt(X ** 2 + Y ** 2 + Z ** 2) < MI.CURVED["SPH"]["R"] + 0.004
        tot = w[near].sum() * 1e-6
        A = 4 * _m.pi * MI.CURVED["SPH"]["R"] ** 2
        need(abs(tot / A - 1) <= 0.04, "SPH: sum w dx^2 %.6e vs 4 pi R^2 %.6e m2 (rel %+.4f, bar 0.04)"
             % (tot, A, tot / A - 1))
    else:
        need(False, "AREA_SPH has no 1 s plotfile")

    print("\n(a3 vii) the fallback flake = c_f k_c (T_s - T0) / q_net, and no skin => no recession")
    rows = []
    for nm in sorted(os.listdir(OUT)):
        for e in events(nm):
            if e.get("ts_fb") == "1" and e.get("through") == "0":
                rows.append((nm, e))
    need(len(rows) > 0, "non-vacuous: %d fallback firings that are not `through` (legs %s)"
         % (len(rows), sorted({nm for nm, _ in rows})))
    worst, n_ok = 0.0, 0
    for nm, e in rows:
        mu = float(e["mu"])
        want = C_F * float(e["k_c"]) * (float(e["T_surf"]) - T0_ROCK) / float(e["q_net"])
        want = min(want, H_SPALL_MAX / mu, FLAKE_H_MAX / mu)
        dxl = 0.002 if nm.endswith("_2") else (0.0005 if nm.endswith("_05") else 0.001)
        # the solid clip could bind: skip (the leg's own cell size; a run that
        # was voided whole is a clip by definition)
        if want > (int(e["run"]) - 1) * dxl or int(e["n_voided"]) == int(e["run"]):
            continue
        n_ok += 1
        worst = max(worst, abs(float(e["h_line"]) / want - 1))
    need(n_ok > 0 and worst <= 1e-12, "h_line = the flake from the logged inputs on %d unclipped rows, "
         "worst rel %.2e (bar 1e-12)" % (n_ok, worst))
    hdr, D = thermo("NOSKIN")
    ns = sum(D[:, hdr.index(c)].max() for c in ("fr_noskin_floor", "fr_noskin_wall", "fr_noskin_roof"))
    need(ns > 0 and len(events("NOSKIN")) == 0,
         "NOSKIN (gas 250 K, colder than the rock): fr_noskin max %g, %d firings" % (ns, len(events("NOSKIN"))))

    print("\n(a3 viii) THROUGH MEANS THROUGH: a `through` firing voids its whole run in ONE firing")
    # ⚠ RESTATED (user, 2026-10-27): the packet's three-cell slab never fires
    # `through` -- under any heating tried (h 50 / 60 / 75 / 100 / 150 / 700, and a
    # lidded top heated from below; studies/p2_9_face_removal/SLAB3_ATTEMPTS.txt) a
    # cell fires as its SURFACE first crosses, while a deeper cell is colder (or the
    # far face fires first), so the walk fails inside the run. What the code
    # guarantees is checked instead, on every leg: n_voided == run and h_line = the
    # solid along the run, for every `through` firing (SHEET's roofs: run 1).
    th = [(nm, e) for nm in sorted(os.listdir(OUT)) for e in events(nm) if e.get("through") == "1"]
    bad = [(nm, e["run"], e["n_voided"]) for nm, e in th if int(e["n_voided"]) != int(e["run"])]
    need(len(th) > 0 and not bad, "%d `through` firings over all legs, every one voids its whole run "
         "(runs %s); violations %s" % (len(th), sorted({e["run"] for _, e in th}), bad[:3]))
    s3 = [e for e in events("SLAB3") if int(e["run"]) == 3]
    print("        REPORT SLAB3 (the packet's slab, h 700): %d run-3 firings, `through` on %d"
          % (len(s3), sum(1 for e in s3 if e["through"] == "1")))

    print("\n(a3 ix) the edge cells: rev 1's ghost_repro fixture at key 0 AND key 1")
    gp = os.path.join(ROOT, "tests", "MMWSpalling", "studies", "p2_9_face_removal", "GHOST_REPRO.txt")
    txt = open(gp).read() if os.path.exists(gp) else ""
    vals = [float(x) for x in re.findall(r"(-?\d+\.\d+)", "\n".join(
        l.split(":", 1)[1] for l in txt.split("\n") if "max - min" in l))]
    need(len(vals) == 24 and max(vals) == 0.0,
         "every column identical at steps 305-307, both keys: max spread %s K over %d values"
         % (max(vals) if vals else "n/a", len(vals)))

    print("\n(a3 x) fr_misaligned and fr_sheet are separate thermo columns")
    hdr, _ = thermo("SHEET")
    need("fr_misaligned" in hdr and "fr_sheet" in hdr, "both present (SHEET leg header)")


def curved_rate(name, dxk):
    """(removed volume rate) / initial analytic area over [5, 20] s, and the
    per-bin (SPH) or per-sector (BORE) normal recession."""
    import math as _m
    dx = DXM[dxk]
    c = MI.CURVED[name]
    n = int(round(c["L"] / dx))
    lg = "%s_%s" % (name, dxk)
    pfs = plotfiles(lg)
    xc = (np.arange(n) + 0.5) * dx - c["L"] / 2
    X, Y, Z = np.meshgrid(xc, xc, xc, indexing="ij")
    if name == "SPH":
        A = 4 * _m.pi * c["R"] ** 2
        dom = np.argmax(np.abs(np.stack([X, Y, Z])), axis=0) * 2 + \
            (np.take_along_axis(np.stack([X, Y, Z]), np.argmax(np.abs(np.stack([X, Y, Z])), axis=0)[None], 0)[0] > 0)
        nb = 6
        A_bin = A / nb
    else:
        A = 2 * _m.pi * c["R"] * c["depth"] + _m.pi * c["R"] ** 2
        zmid = c["L"] / 2 - c["depth"] / 2                    # mid-depth, centred coordinates
        band = np.abs(Z - zmid) <= 0.004
        az = (np.degrees(np.arctan2(Y, X)) % 360.0) // 30.0
        dom = np.where(band & (np.sqrt(X ** 2 + Y ** 2) > c["R"] - 2 * dx), az, -1)
        nb = 12
        A_bin = c["R"] * _m.radians(30.0) * 0.008
    ts, Vs, per = [], [], []
    for pf in pfs:
        t = pf_time(pf)
        f = read_pf(pf, ["fr_f"], (n, n, n))["fr_f"]
        ts.append(t)
        Vs.append(f.sum() * dx ** 3)
        per.append([f[dom == b].sum() * dx ** 3 for b in range(nb)])
    ts, Vs, per = np.array(ts), np.array(Vs), np.array(per)
    win = (ts >= T0_WIN - 1e-9) & (ts <= T1_WIN + 1e-9)
    if win.sum() < 3:
        return float("nan"), []
    slope = -np.polyfit(ts[win], Vs[win], 1)[0]
    bins = [-np.polyfit(ts[win], per[win, b], 1)[0] / A_bin for b in range(nb)]
    return slope / A, bins


A5B = ("TL20", "TL35", "TL45", "TR")


def phase_rate(lg, dxk, n, evs=None):
    """rev 2.1 (a5b) -- the PHASE-IMMUNE rate: per interior line (a column, >= 4
    cells from every side, z-dominant planes), the normal recession accrued after
    its first firing in [5, 20] s -- sum over its later firings of h_line x
    |n_true . e_axis| (e_axis = that firing's line axis) -- divided by the time
    from its first to its last firing; mean over lines with >= 2 firings."""
    nx = MESH[dxk][0]
    by = {}
    for e in (events(lg) if evs is None else evs):
        t = float(e["time"])
        if not (T0_WIN <= t <= T1_WIN):
            continue
        i, j = int(e["col_i"]), int(e["col_j"])
        if not (4 <= i <= nx - 5 and 4 <= j <= nx - 5):
            continue
        d = int(e.get("dir", "5"))
        by.setdefault((i, j), []).append((t, float(e["h_line"]) * abs(n[d // 2])))
    rates = []
    for k, v in by.items():
        v.sort()
        if len(v) < 2 or v[-1][0] <= v[0][0]:
            continue
        rates.append(sum(h for _, h in v[1:]) / (v[-1][0] - v[0][0]))
    return (float(np.mean(rates)), len(rates)) if rates else (float("nan"), 0)


