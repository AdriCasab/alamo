# ------------------------------------------------------------------ geometry --
def normal(theta, phi):
    t, p = math.radians(theta), math.radians(phi)
    return np.array([math.sin(t) * math.cos(p), math.sin(t) * math.sin(p), math.cos(t)])


def tilt_seeds(theta, phi, dxk):
    """Void above the plane through the block centre (cell-centre test), one
    6-int box per column strip: a strip in y when the plane does not depend on y,
    else one box per column."""
    nx, nz = MESH[dxk][0], MESH[dxk][1]
    dx = DXM[dxk]
    n = normal(theta, phi)
    boxes = []
    per_col = abs(n[1]) > 1e-12
    for i in range(nx):
        for j in (range(nx) if per_col else [0]):
            x = (i + 0.5) * dx
            y = (j + 0.5) * dx
            # void iff n . (p - c) > 0  <=>  z > ZC - (n_x (x - XC) + n_y (y - YC)) / n_z
            zs = ZC - (n[0] * (x - XC) + n[1] * (y - YC)) / n[2]
            # first k with z_c > zs, in index units; a tie (a centre ON the
            # plane, everywhere along a 45 deg diagonal) stays solid
            ks = int(math.floor(zs / dx + 1e-9 - 0.5)) + 1
            ks = max(ks, 0)
            if ks > nz - 1:
                continue
            j0, j1 = (j, j) if per_col else (0, nx - 1)
            boxes.append((i, j0, ks, i, j1, nz - 1))
    return boxes


def mesh_keys(dxk):
    nx, nz, dt, mgs, pint = MESH[dxk]
    return {"amr.n_cell": "%d %d %d" % (nx, nx, nz), "timestep": repr(dt),
            "amr.max_grid_size": str(mgs), "amr.plot_int": str(pint)}


# ------------------------------------------------------------------ running ---
def run_leg(name, keys, np_=4, seeds=None):
    d = os.path.join(OUT, name)
    if os.path.isdir(d):
        shutil.rmtree(d)
    os.makedirs(d)
    kv = dict(keys)
    kv["plot_file"] = os.path.join(d, "run")
    if seeds:
        kv["spall.seed_void"] = " ".join(str(v) for b in seeds for v in b)
    argv = MPI + ["-np", str(np_), BIN, INPUT] + ["%s=%s" % (k, v) for k, v in kv.items()]
    with open(os.path.join(d, "argv.sh"), "w") as f:
        f.write(" ".join("'%s'" % a if " " in a else a for a in argv) + "\n")
    with open(os.path.join(d, "run.log"), "w") as log:
        rc = subprocess.call(argv, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
    print("  ran %-12s rc=%d" % (name, rc))
    return rc


# ------------------------------------------------------------------ reading ---
def thermo(name):
    p = os.path.join(OUT, name, "run", "thermo.dat")
    rows = [ln.rstrip("\n").split("\t") for ln in open(p)]
    hdr = [h.strip() for h in rows[0]]
    data = [[float(x) for x in r[:len(hdr)]] for r in rows[1:] if len(r) >= len(hdr)]
    return hdr, np.array(data)


def events(name):
    p = os.path.join(OUT, name, "run_removal_events.csv")
    return list(csv.DictReader(open(p))) if os.path.exists(p) else []


def plotfiles(name):
    return sorted(glob.glob(os.path.join(OUT, name, "run", "[0-9]" * 5 + "cell")))


def pf_time(pf):
    h = open(os.path.join(pf, "Header")).read().split("\n")
    n = int(h[1])
    return float(h[2 + n + 1])


def read_pf(pf, comps, shape):
    lvl = os.path.join(pf, "Level_0")
    hdr = open(os.path.join(pf, "Header")).read().split("\n")
    names = hdr[2:2 + int(hdr[1])]
    out = {c: np.zeros(shape) for c in comps}
    for fn in sorted(f for f in os.listdir(lvl) if f.startswith("Cell_D_")):
        blob = open(os.path.join(lvl, fn), "rb").read()
        pos = 0
        while True:
            m = fabcmp.HDR.search(blob, pos)
            if not m:
                break
            lo = [int(m.group(i)) for i in (2, 3, 4)]
            hi = [int(m.group(i)) for i in (5, 6, 7)]
            nc = int(m.group(11))
            shp = [hi[q] - lo[q] + 1 for q in range(3)]
            npts = shp[0] * shp[1] * shp[2]
            st = m.end()
            for c in comps:
                ci = names.index(c)
                a = np.frombuffer(blob, dtype="<f8", count=npts, offset=st + ci * npts * 8)
                out[c][lo[0]:hi[0] + 1, lo[1]:hi[1] + 1, lo[2]:hi[2] + 1] = \
                    a.reshape(shp[2], shp[1], shp[0]).transpose(2, 1, 0)
            pos = st + nc * npts * 8
    return out


def dominant(n):
    return int(np.argmax(np.abs(n)))


def positions(name, dxk, n, key0=False):
    """[(t, {line: normal position [m]})] over the plotfiles. A line runs along
    the dominant axis a; its position is (sum of solid fraction) dx mu_true, or,
    key 0, the column level set."""
    nx, nz = MESH[dxk][0], MESH[dxk][1]
    dx = DXM[dxk]
    shape = (nx, nx, nz)
    a = dominant(n)
    mu = abs(n[a])
    out = []
    for pf in plotfiles(name):
        t = pf_time(pf)
        if key0:
            d = read_pf(pf, ["removed", "phi"], shape)
            sol = d["removed"] < 0.5
            pos = {}
            for i in range(nx):
                for j in range(nx):
                    ks = np.nonzero(sol[i, j, :])[0]
                    if len(ks) == 0:
                        continue
                    kt = ks.max()
                    pos[(i, j)] = ((kt + 0.5) * dx + d["phi"][i, j, kt]) * mu
        else:
            d = read_pf(pf, ["fr_f"], shape)
            f = d["fr_f"]
            s = f.sum(axis=a) * dx * mu
            pos = {}
            other = [q for q in range(3) if q != a]
            for u in range(s.shape[0]):
                for v in range(s.shape[1]):
                    pos[(u, v)] = s[u, v]
        out.append((t, pos))
    return out


def rate(name, dxk, n, key0=False):
    """The normal recession rate over [5, 20] s: mean over INTERIOR lines (along
    the dominant axis, >= 4 cells from every side) of (position(5 s) -
    position(20 s)) / 15 s. A line is kept only if its surface lies strictly
    inside it at 5 s (not a still-full or already-empty line) and stays >= 4
    cells off its solid end at 20 s -- rev 2: the (1,1,1) and 45 deg planes run
    some corner columns down to the block's floor within 20 s, and those read
    zero recession (cross-checked against the event log, TILT_CROSSCHECK.txt)."""
    nx, nz = MESH[dxk][0], MESH[dxk][1]
    dx = DXM[dxk]
    a = dominant(n)
    mu = abs(n[a])
    sides = [nx, nx, nz]
    L = sides[a] * dx
    other = [q for q in range(3) if q != a]
    pos = dict((round(t), p) for t, p in positions(name, dxk, n, key0))
    if 5 not in pos or 20 not in pos:
        return float("nan"), 0
    P5, P20 = pos[5], pos[20]
    keep = [k for k in P5 if all(4 <= k[q] <= sides[other[q]] - 5 for q in range(2))
            and k in P20 and 0.0 < P5[k] / mu < L - 1e-12 and P20[k] / mu >= 4 * dx]
    if not keep:
        return float("nan"), 0
    return float(np.mean([(P5[k] - P20[k]) / 15.0 for k in keep])), len(keep)


def witness_rows(name):
    """fr_multi max and fr_id_remap max over every thermo row."""
    hdr, D = thermo(name)
    if len(D) == 0:
        return float("nan"), float("nan")
    return D[:, hdr.index("fr_multi")].max(), D[:, hdr.index("fr_id_remap")].max()


