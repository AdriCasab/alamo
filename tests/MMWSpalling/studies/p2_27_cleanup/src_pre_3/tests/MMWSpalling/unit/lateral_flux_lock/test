    # The hazard Grimsel.H's header records: three independent attempts at the
    # SAME thermoelastic stress produced three different wrong answers, because
    # each site wrote its own formula. A relief factor R fitted downstream
    # absorbs the error silently, so no run can detect it. ⇒ the rule is
    # structural: ONE formula, ONE caller, and the law's raw pieces are off
    # limits to everyone but the cache writer.
    print("\nP2-2b (b4) deliverable 7: ONE THERMOELASTIC STRESS")

    both = mmw + "\n" + rem

    need(both.count("sigma_thermal(") == 1,
         "`sigma_thermal` is called from exactly ONE place in the integrator "
         "(%d)" % both.count("sigma_thermal("))
    need(len(re.findall(r"static Set::Scalar LawSigma\(", mmw)) == 1,
         "`LawSigma` -- the one entry point -- is defined exactly once")
    need(len(re.findall(r"const Numeric::Material::Grimsel \*RockLaw\(\) const",
                        mmw)) == 1,
         "`RockLaw()` decides law-on/law-off in exactly one place, so the two "
         "firing sites cannot answer it differently")

    # ⚠⚠ THE TWO HALVES OF THE PROPERTY SET ARE SEPARATELY KEYED.
    # The first implementation gated the criterion on the PHASE's thermal law
    # (`phases[0].grimsel_law`), so `law = grimsel` switched conduction and
    # mechanics on together. Deliverable 9's Kant ladder then had three rungs
    # with two distinct states -- K1 (thermal only) and K2 (+ mechanical) would
    # have been the SAME RUN -- and (c1) could not have attributed the onset
    # shift to either half. Nothing in the packet's own criteria would have
    # failed; the ladder would simply have reported a coincidence.
    need("spall.stress_law" in mmw,
         "`spall.stress_law` exists -- the MECHANICAL half has its own key")
    need("sp_stress_law_grimsel" in mmw,
         "the mechanical half has its own flag, not the phase's thermal one")
    m_rl = re.search(r"RockLaw\(\) const[\s\S]*?\n    \}", mmw)
    need(m_rl is not None, "RockLaw's body is locatable")
    if m_rl:
        need("grimsel_law" not in m_rl.group(0),
             "RockLaw does NOT read the phase's thermal `grimsel_law` -- the "
             "criterion and conduction are independently switchable")
        need("sp_stress_law_grimsel" in m_rl.group(0),
             "RockLaw gates on `spall.stress_law` alone")
    # ⚠ and the law's coefficients must bind under EITHER half, or a leg
    # running the mechanical set alone gets a default-constructed law and
    # `grimsel.alpha_cap_theta` -- (c7)'s whole sensitivity -- is silently
    # ignored, reporting "no sensitivity" where the key was never read.
    m_pl = re.search(r'query_default\(pfx \+ "\.law"[\s\S]{0,2000}?'
                     r'queryclass<Numeric::Material::Grimsel>', mmw)
    need(m_pl is not None,
         "the per-phase grimsel block is parsed in the same region as `.law`")
    if m_pl:
        seg = m_pl.group(0)
        need('if (plaw == "grimsel")' not in seg,
             "the grimsel coefficient block is parsed UNCONDITIONALLY, not "
             "inside the thermal-law branch -- so alpha_cap_theta binds for a "
             "mechanical-only leg too")

    # ⚠⚠ THE TWO-FIRING-SITE INVARIANT, MADE MECHANICAL. MMWSpalling.H:7246
    # pre-registers that the `Sp_field` site and the depth scan must change
    # together -- P0 closed the gap between them deliberately. A packet that
    # converted one would leave the diagnostic measuring a different criterion
    # than the one that fires, which is unfalsifiable from any output.
    for where, txt, tag in (("Removal.H depth scan", rem, "LawSigma(scan_g"),
                            ("MMWSpalling.H Sp_field", mmw, "LawSigma(te_g")):
        need(tag in txt, "%s routes its stress through LawSigma" % where)
    # the Sp_field site has TWO branches (inside / outside the top half-cell)
    need(mmw.count("LawSigma(te_g") == 2,
         "BOTH `Sp_field` branches convert -- the reconstructed top half-cell "
         "AND the sampled cell (%d of 2)" % mmw.count("LawSigma(te_g"))

    # The law's RAW pieces belong to the per-cell cache writer and to nobody
    # else. Anyone else reading E_of/strain_of/alpha_of/mu_of is building a
    # second stress formula, which is the defect this block exists to stop.
    CACHE_OK = (
        "EE   (i, j, k) = g.E_of(Tc);",
        "muu  (i, j, k) = g.mu_of(Tc);",
        "? (g.strain_of(Tc) - g.strain_of(T_r)) / dT",
        ": g.alpha_of(Tc);",
    )
    raw = []
    for nm, txt in (("MMWSpalling.H", mmw), ("Removal.H", rem)):
        for ln, line in enumerate(txt.split("\n"), 1):
            if not re.search(r"\.(E_of|strain_of|alpha_of|mu_of)\s*\(", line):
                continue
            if any(frag in line for frag in CACHE_OK):
                continue
            raw.append("%s:%d %s" % (nm, ln, line.strip()[:66]))
    for o in raw:
        print("       ** %s" % o)
    need(not raw,
         "the law's raw strain/stiffness pieces are read ONLY by the per-cell "
         "cache writer (%d other reader(s))" % len(raw))

    # ⚠⚠ deliverable 4: STRAIN IS NEVER INTERPOLATED IN SPACE. A strain or
    # stress FIELD would be interpolated by AMR on regrid and at box seams, and
    # the criterion would read a spatially smeared strain instead of the one at
    # its own reconstructed temperature.
    # ⚠ NOT a ban on field NAMES. A first pass here asserted that no
    # `strain_mf`/`stress_mf` exists and failed on `stress_mf`, which is the
    # MECHANICS solve's own nodal stress -- 15 uses, pre-existing, and the
    # Step-19 stress source reads it legitimately. Banning a name catches the
    # wrong thing. The invariant that actually encodes "strain is never
    # interpolated in space" is that the stress entry point is a PURE FUNCTION
    # OF TEMPERATURE: it reads no field and knows no cell index. If a cached
    # strain field is ever introduced and read here, this fails.
    m = re.search(r"static Set::Scalar LawSigma\([\s\S]*?\{([\s\S]*?)\n    \}",
                  mmw)
    need(m is not None, "the LawSigma body is locatable for inspection")
    if m:
        body = m.group(1)
        need("_mf" not in body,
             "LawSigma reads NO field -- strain and stiffness come from the "
             "law at the local temperature, never from an interpolated field")
        need("(i, j, k)" not in body and "(i,j,k)" not in body,
             "LawSigma knows no cell index, so it cannot smear strain across "
             "cells")

    # ⚠⚠ BYTE-IDENTITY UNDER THE SHIPPED DEFAULT IS STRUCTURAL, NOT HOPED FOR.
    # Each site keeps its pre-P2-2b expression VERBATIM in the else-branch.
    # Rewriting the default as relief*(E*beta*dT/(1-nu)) is algebraically the
    # same and NOT bit-identical -- it re-associates the multiply -- which
    # would break (b1) on a tree where the new law is switched off.
    need(rem.count("* phase_beta_loc") >= 1 and "phase_E_loc" in rem,
         "the depth scan keeps its scalar expression for `law = constant`")
    need(mmw.count("te_relief * te_E * te_beta") == 2,
         "both `Sp_field` branches keep the scalar expression too (%d of 2)"
         % mmw.count("te_relief * te_E * te_beta"))

    # ---- P2-2b (a1)/(b4): THE RULE, AS A PREDICATE ------------------------
    # WHY A PREDICATE AND NOT A COUNT. rev 1 barred this as "five sites and no
    # sixth", having found five by grepping for the PRODUCT `rho * Cp`. Two
    # sites read `rho` and `Cp` as SEPARATE scalars and cannot match a product
    # pattern, so the bar could only be satisfied by repeating the search error
    # that produced it. A count is brittle against exactly what it must catch.
    #
    # THE RULE: no site in the rock path reads `rho` or `Cp` as a per-phase
    # constant, and nothing stores a pre-multiplied `rho*Cp`. Three classes are
    # permitted, each asserted to be exactly where it belongs:
    #   * the PARSE block            -- where the scalars enter at all;
    #   * the `constant`-law object  -- site 4's else-branch; for a constant
    #                                   phase the Constant object IS the law;
    #   * the ONE field writer       -- site 5, per-phase becomes per-cell.
    print("\nP2-2b (a1) NO PER-PHASE SCALAR rho/Cp IN THE ROCK PATH")

    ALLOWED = {
        'pp.query_required(pfx + ".rho"':                  "parse block",
        'pp.query_required(pfx + ".Cp"':                   "parse block",
        "phase_materials[p].m_rho   = phases[p].rho":      "constant-law object",
        "phase_materials[p].m_cp    = phases[p].Cp":       "constant-law object",
        "rh[p]  = phases[p].rho":                          "the one field writer",
        "Cpv[p] = phases[p].Cp":                           "the one field writer",
        "phases[p].grimsel.rho(phases[p].T_ref)":          "the one field writer (law)",
        "phases[p].grimsel.cp (phases[p].T_ref)":          "the one field writer (law)",
    }
    offenders = []
    for nm, txt in (("MMWSpalling.H", mmw), ("Removal.H", rem)):
        for ln, line in enumerate(txt.split("\n"), 1):
            bare = line.split("//")[0]
            if not re.search(r"phases\[[^\]]*\]\.(rho|Cp)\b", bare):
                continue
            if any(frag in bare for frag in ALLOWED):
                continue
            offenders.append("%s:%d %s" % (nm, ln, line.strip()[:68]))
    for o in offenders:
        print("       ** %s" % o)
    need(not offenders,
         "every per-phase scalar read of rho/Cp sits in one of the three "
         "permitted classes (%d offender(s))" % len(offenders))

    # Each permitted class must still EXIST. Without this the block passes
    # vacuously on a tree where the scalars were deleted outright and the fields
    # are therefore never filled -- the failure the packet diagnosed at :5380,
    # where UpdatePropertyFields returns unless some phase sets law = grimsel.
    for frag, cls in sorted(ALLOWED.items()):
        n = (mmw + rem).count(frag)
        need(n == 1,
             "the permitted site `%s` (%s) exists exactly once (%d)"
             % (frag[:42], cls, n))

    # NO stored pre-multiplied product survives IN CODE (the retirement note
    # names them in a comment, deliberately, so the audit trail stays).
    code = "\n".join(l.split("//")[0] for l in (mmw + "\n" + rem).split("\n"))
    for name in ("rev_rhoCp", "pin_rhoCp"):
        n_code = len(re.findall(r"\b%s\b" % name, code))
        need(n_code == 0,
             "the stored product `%s` is retired from code (%d)" % (name, n_code))
    for name in ("pin_rho", "pin_Cp", "col_rho", "col_Cp"):
        n = len(re.findall(r"\b%s\b" % name, code))
        need(n >= 2, "`%s` is carried separately (%d uses)" % (name, n))

    # site 4 builds the enthalpy table FROM THE LAW, with the latent heat copied
    need(len(re.findall(r"phase_tables\[p\]\.Build\(g\)", mmw)) == 1,
         "site 4 builds the enthalpy table from the LAW under grimsel_law")
    for f in ("T_m", "fus_width", "L_m", "T_vap_lo", "T_vap_hi", "L_v"):
        need(len(re.findall(r"g\.%s\s*=\s*phases\[p\]\.%s;" % (f, f), mmw)) == 1,
             "`%s` is copied onto the law object before Build -- Grimsel parses "
             "only T_ref, so it would otherwise sit at the base default and the "
             "latent heat would vanish silently" % f)

    # --- THE RUN ASSERTION: a retired key must be UNCONSUMED ---------------
    # ⚠⚠ The only clause here that separates "key deleted" from "key parsed,
    # guard gone". For `spall.support_rule` the latter fires 240 K early IN
    # SILENCE, so source greps alone are not enough -- a deleted parse leaves
    # the key accepted and ignored by every other reader.
    #
    # ⚠⚠ THE PACKET EXPECTED AN ABORT AND THERE IS NONE. P2-2a's ledger cites
    # IO/ParmParse.H's unused-input check, but that fires inside
    # `queryclass<T>(prefix)` for keys UNDER that prefix; a top-level
    # `spall.*` key given on the command line is not covered, and MEASURED:
    # `spall.support_rule=1` exits 0, and so does `this.key.is.nonsense=42`.
    # What IS available is AMReX's own end-of-run report, which lists the key as
    #     [TOP]::spall.support_rule(nvals = 1)  :: [1]
    # so the discriminating property survives intact, and TWO-SIDED on one
    # binary: a key that is still parsed is CONSUMED and must be ABSENT from the
    # report, a retired key must be PRESENT. The second half is what makes this
    # non-vacuous -- without it, a run that ignored every key would "pass".
    if "--check" not in sys.argv:
        print("\nP2-2a (b4) THE RETIRED KEYS MUST BE UNCONSUMED (AMReX report)")
        gb = os.path.join(ROOT, "tests", "MMWSpalling", "unit",
                          "gradient_blind", "input")

        def unused_for(key):
            d = tempfile.mkdtemp(prefix="lockkey_")
            r = subprocess.run(
                ["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "1",
                 os.path.join(ROOT, "bin", "mmwspalling-3d-g++"), gb, key,
                 "stop_time=0.0", "plot_file=%s" % os.path.join(d, "run")],
                cwd=ROOT, capture_output=True, text=True)
            txt = (r.stdout or "") + (r.stderr or "")
            name = key.split("=")[0]
            return bool(re.search(r"\[TOP\]::%s\(" % re.escape(name), txt))

        for key in ("spall.support_rule=1", "spall.support_min_sides=2",
                    "spall.support_step_min=0.006",
                    "spall.driving_stress=differential",
                    "spall.driving_ref=flake",
                    "spall.driving_ref_depth=0.001"):
            u = unused_for(key)
            print("       %-38s %s" % (key, "unconsumed" if u else "** CONSUMED **"))
            need(u, "retired key `%s` is UNCONSUMED -- it is gone, not parsed "
                    "and ignored" % key)
        # ⚠⚠ P2-8 GROUP A: SIX `surface_patch.*` keys DELETED. Unlike the
        # top-level `spall.*` keys above, these sit under `queryclass<
        # SurfacePatch>("surface_patch")`, whose unused-key check ABORTS, so the
        # property here is the stronger one the packet names: the run must
        # FAIL. Each is given at its former DEFAULT value, so an abort can only
        # mean "the key is gone", never "the value was refused".
        def aborts_for(keys):
            d = tempfile.mkdtemp(prefix="lockkeyA_")
            r = subprocess.run(
                ["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "1",
                 os.path.join(ROOT, "bin", "mmwspalling-3d-g++"), gb] + keys
                + ["stop_time=0.0", "plot_file=%s" % os.path.join(d, "run")],
                cwd=ROOT, capture_output=True, text=True)
            return r.returncode != 0, (r.stdout or "") + (r.stderr or "")
        GROUP_A = ("surface_patch.side_face_factor=1.0",
                   "surface_patch.side_face_r_min=0.0",
                   "surface_patch.side_face_area_exact=0",
                   "surface_patch.side_face_closure=follow",
                   "surface_patch.side_face_h_max=80.0",
                   "surface_patch.side_face_h_scale=1.0")
        print("\nP2-8 (a2) THE SIX GROUP-A KEYS MUST ABORT (queryclass strict check)")
        for key in GROUP_A:
            ab, txt = aborts_for([key])
            name = key.split("=")[0].split(".", 1)[1]
            named = name in txt
            print("       %-42s %s%s" % (key, "ABORTS" if ab else "** RUNS **",
                                         "" if named else "  (key not named in output)"))
            need(ab and named, "retired key `%s` ABORTS the run and the output names "
                               "it -- it is gone, not parsed and ignored" % key)
        # the control: the SAME prefix with a live key must run, or "aborts"
        # would be true of a binary that refuses every surface_patch key.
        # ⚠ P2-10: side_face_flux is itself retired now, so the live key is face_list.
        ab, txt = aborts_for(["surface_patch.face_list=0"])
        print("       %-42s %s" % ("surface_patch.face_list=0 (live)",
                                   "runs (good)" if not ab else "** ABORTS **"))
        need(not ab, "a LIVE surface_patch key still runs -- the abort clause "
                     "above is not vacuous")
        # and the code: no parse of any of the six survives
        code_all = "\n".join(l.split("//")[0] for l in (mmw + "\n" + rem).split("\n"))
        for key in GROUP_A:
            nm = key.split("=")[0].split(".", 1)[1]
            n = len(re.findall(r'"%s"' % re.escape(nm), code_all))
            need(n == 0, "no code line names the retired key `%s` (%d)" % (nm, n))

        # the other side: a key that still exists must be consumed, or the
        # assertion above would pass for a binary that reads no keys at all.
        for key in ("spall.flake_c_f=0.4", "spall.h_spall_max=0.015"):
            u = unused_for(key)
            print("       %-38s %s" % (key, "consumed (good)" if not u
                                       else "** UNCONSUMED **"))
            need(not u, "live key `%s` is still CONSUMED -- the clause above is "
                        "not vacuous" % key)

    # ---- P2-8 (a3): THE FACE LIST -- one builder, one heat rule, one area rule
    # ⚠⚠ The bug family this file exists for is a consumer reading its OWN
    # h / T / area. Under `surface_patch.face_list` every consumer must read
    # the ONE list: built once (F1+F3), heated once (F2), and the four flux
    # readers through the one face-Newton call (F4). Asserted on CODE lines.
    print("\nP2-8 (a3) THE FACE LIST -- one list builder, one heat resolver, one weight function")
    code_m = "\n".join(l.split("//")[0] for l in mmw.split("\n"))
    code_r = "\n".join(l.split("//")[0] for l in rem.split("\n"))
    def ndecl(pat):
        return len(re.findall(pat, code_m)) + len(re.findall(pat, code_r))
    def ncall(name, decl):
        return (len(re.findall(r"\b%s\s*\(" % name, code_m))
                + len(re.findall(r"\b%s\s*\(" % name, code_r)) - decl)
    for name, dpat, want_calls, where in (
            ("BuildFaceList", r"void\s+BuildFaceList\s*\(", 1,
             "once per step, in AdvanceMicrostructure"),
            # P2-23 (the flameless list) added a SECOND call, in the `else if (fl_on)` branch of
            # `if (sp_on) BuildFlameColumns(...)` -- exclusive with the first, so still once per step
            # (asserted just below). The lock read 1 until P2-26 re-ran it (restated there).
            ("FaceListHeat", r"void\s+FaceListHeat\s*\(", 2,
             "once per step: in BuildFlameColumns before the march, or (patch off, P2-23) in its place"),
            ("FaceH", r"Set::Scalar\s+FaceH\s*\(", 1,
             "only inside FaceListHeat -- the ONE heat resolver"),
            ("FaceWeight", r"static\s+Set::Scalar\s+FaceWeight\s*\(", 1,
             "only inside BuildFaceList -- the ONE area rule")):
        nd = ndecl(dpat)
        nc = ncall(name, nd)
        print("     %-14s %d declaration(s), %d call(s)  [%s]" % (name, nd, nc, where))
        need(nd == 1, "`%s` is declared EXACTLY ONCE (%d)" % (name, nd))
        need(nc == want_calls, "`%s` has exactly %d call site(s) -- %s (%d)"
             % (name, want_calls, where, nc))
    need(re.search(r"if \(sp_on\) BuildFlameColumns\(lev, time, dt, k_top_col\);\s*else if \(fl_on\)\s*"
                   r"\{\s*FaceListHeat\(lev, 0\.0, time, k_top_col\);", code_m) is not None,
         "the second FaceListHeat call (P2-23, h = 0) is the ELSE of BuildFlameColumns' call: one per step")
    # P2-10: P2-8's face Newton (F4) had no caller after P2-9 and is deleted.
    need(ndecl(r"void\s+FaceListFlux\s*\(") == 0,
         "`FaceListFlux` is DELETED (P2-10; FrFaceFlux heats every listed face)")
    # the heat resolver is the ONLY place h_expr is evaluated per face
    fh_body = re.search(r"void\s+FaceListHeat\s*\(.*?\n    \}\n", code_m, re.S)
    need(fh_body is not None and "FaceH(" in fh_body.group(0),
         "FaceH is called from INSIDE FaceListHeat")
    bfc = re.search(r"void\s+BuildFlameColumns\s*\(.*?\n    \}\n", code_m, re.S)
    need(bfc is not None and re.search(r"FaceListHeat\(.*?JetEnthalpyMarch\(",
                                       bfc.group(0), re.S) is not None,
         "F2 runs BEFORE the march inside BuildFlameColumns (the march bills every "
         "face at this step's h)")
    adv = re.search(r"void\s+AdvanceMicrostructure\s*\(.*?\n    \}\n", code_m, re.S)
    need(adv is not None and re.search(r"BuildFaceList\(.*?BuildFlameColumns\(",
                                       adv.group(0), re.S) is not None,
         "F1 is built BEFORE BuildFlameColumns (and so before the march)")
    # the five consumers read the LIST
    need(adv is not None and "flp[q]" in adv.group(0) and "fli(i, j, k, 0)" in adv.group(0),
         "the KERNEL reads the list per cell (flp / fli)")
    led = re.search(r"void\s+EnergyLedger\s*\(.*?\n    \}\n", code_m, re.S)
    need(led is not None and "fli_l(i, j, k, 0)" in led.group(0)
         and "FrFaceFlux(" in led.group(0),
         "the LEDGER mirrors the list per cell (P2-9: through FrFaceFlux)")
    mar = re.search(r"void\s+JetEnthalpyMarch\s*\(.*?\n    \}\n", code_m, re.S)
    need(mar is not None and "fl_col_first[c]" in mar.group(0)
         and "side_nslot" not in mar.group(0) and "side_on" not in mar.group(0),
         "the MARCH bills the list's faces per column and has no slot gather and "
         "no side term at all (P2-10 deleted both)")
    # P2-10: the old side sites are deleted, not merely off under the key
    need(re.search(r'(?<!")surface_patch\.side_face_flux', code_m) is None
         and re.search(r"\bside_on\b", code_m) is None,
         "the kernel's and the ledger's old side-face blocks are DELETED (P2-10)")

    # ---- P2-9: ONE BREAKING RULE -- one gather, one criterion, one removal ---
    # ⚠⚠ Under `surface_patch.face_list` every surface cell is judged and
    # receded along ONE line by ONE path (FaceRemoval.H). Asserted on CODE.
    print("\nP2-9 ONE BREAKING RULE -- one gather, one criterion, one RecedeAlongLine")
    frm = open(os.path.join(ROOT, "src", "Integrator", "MMWSpalling", "FaceRemoval.H")).read()
    code_f = "\n".join(l.split("//")[0] for l in frm.split("\n"))
    allc = code_m + "\n" + code_r + "\n" + code_f
    rl = code_f[code_f.index("void RecedeAlongLines("):]
    for name, dpat, n_in_rl, what in (
            ("RecedeAlongLine", r"static\s+int\s+RecedeAlongLine\s*\(", 1, "the ONE removal function"),
            ("DepthScanH", r"static\s+Set::Scalar\s+DepthScanH\s*\(", 1, "the ONE criterion"),
            # ⚠ P2-9 rev 2 RESTATED 2 -> 1: the fallback no longer reads
            # ReconFromX's flat h_f = dz (item 5: its flake is the face balance's)
            ("ReconFromX", r"static\s+SurfaceRecon\s+ReconFromX\s*\(", 1,
             "the ONE reconstruction (the fallback no longer calls it, rev 2 item 5)")):
        nd = len(re.findall(dpat, allc))
        nc = len(re.findall(r"\b%s\s*\(" % name, rl))
        need(nd == 1 and nc == n_in_rl,
             "`%s` declared once (%d) and called %d time(s) in RecedeAlongLines (%d) -- %s"
             % (name, nd, n_in_rl, nc, what))
    need(rl.count("ReduceRealSum(G.data()") == 1,
         "ONE gather along every line (owner-written, ReduceRealSum-collapsed): %d"
         % rl.count("ReduceRealSum(G.data()"))
    need(re.search(r"for\s*\(std::size_t\s+l\s*=\s*0;\s*l\s*<\s*nl;", rl) is not None,
         "the criterion runs over EVERY line of every surface cell (the l < nl loop)")
    nff = len(re.findall(r"\bFrFaceFlux\s*\(", allc)) - 1
    # P2-11b: the march has TWO sites -- q_col (columns, face_heat = position) and q_face (faces,
    # face_heat = path) -- so the count is 5 (unit/face_heat (vi) locks each site's gas temperature)
    need(nff == 5 and len(re.findall(r"void\s+FrFaceFlux\s*\(", allc)) == 1,
         "`FrFaceFlux` declared once, called by kernel, ledger, march (q_col, q_face), diagnostics (%d)" % nff)
    # the dispatch precedes BOTH old criteria, so R:719's transitional skip is
    # unreachable under the key
    ur = code_r[code_r.index("void UpdateRemovalAfterCohesive("):]
    i_disp = ur.find("if (surface_patch.face_list)")
    i_ret = ur.find("return;", i_disp)
    i_scan = ur.find("h_col = DepthScanH(")
    need(0 <= i_disp < i_ret < i_scan and "RecedeAlongLines(" in ur[i_disp:i_ret]
         and "lat_on" not in ur,
         "the face-list DISPATCH (RecedeAlongLines; return) precedes the column depth "
         "scan, and no lateral criterion is left after it (P2-10)")

    # ---- P2-9 rev 2: one normal, one elastic helper, the edge-cell refill ---
    print("\nP2-9 rev 2 -- one normal, one elastic helper, the ghost refill on both paths")
    allc2 = code_m + "\n" + code_r + "\n" + code_f
    nd = len(re.findall(r"static\s+Set::Vector\s+FrSmoothedGradient\s*\(", allc2))
    nc = len(re.findall(r"\bFrSmoothedGradient\s*\(", allc2)) - nd
    bfl = re.search(r"void\s+BuildFaceList\s*\(.*?\n    \}\n", code_m, re.S)
    need(nd == 1 and nc == 1 and bfl is not None and "FrSmoothedGradient(" in bfl.group(0)
         and "Numeric::Gradient(" not in bfl.group(0),
         "ONE normal: `FrSmoothedGradient` declared once, called once -- in BuildFaceList, which "
         "no longer takes P2-8's +-1 indicator gradient (every consumer reads the list's n, w)")
    nd = len(re.findall(r"ElasticConsts\s+ElasticConstants\s*\(\s*\)\s*const", allc2))
    nc = len(re.findall(r"\bElasticConstants\s*\(\s*\)", allc2)) - nd
    n_nu = len(re.findall(r"E\s*/\s*\(2\.0\s*\*\s*phases\[0\]\.mu\)\s*-\s*1\.0", allc2))
    n_cf = len(re.findall(r"confining_p\s*\*", allc2))
    need(nd == 1 and nc >= 4 and n_nu == 1 and n_cf == 1,
         "ONE elastic helper: `ElasticConstants` declared once, called %d times; nu and the "
         "confining offset each written once (%d, %d)" % (nc, n_nu, n_cf))
    need("FrFillTempGhosts" not in allc2, "rev 1's zero-gradient `FrFillTempGhosts` is deleted")
    nd = len(re.findall(r"void\s+RefillTempGhosts\s*\(", allc2))
    ur2 = code_r[code_r.index("void UpdateRemovalAfterCohesive("):]
    tail = re.search(r"if\s*\(remap_any\)\s*\{(.*?)\}", ur2, re.S)
    rl2 = code_f[code_f.index("void RecedeAlongLines("):]
    tl2 = re.search(r"if\s*\(any_write\)\s*\{(.*?)\}", rl2, re.S)
    need(nd == 1 and tail is not None and re.search(r"InvertHtoT\(lev\);.*RefillTempGhosts\(lev,\s*time\)",
                                                     tail.group(1), re.S) is not None
         and tl2 is not None and re.search(r"InvertHtoT\(lev\);.*RefillTempGhosts\(lev,\s*time\)",
                                           tl2.group(1), re.S) is not None,
         "the temperature ghosts are refilled through the solver's BC (`RefillTempGhosts`) after "
         "InvertHtoT on BOTH removal paths -- the column tail and the line tail")
    hc = open(os.path.join(ROOT, "src", "Integrator", "HeatConduction.H")).read()
    need(re.search(r"protected:\s*(//[^\n]*\n\s*)*BC::BC<Set::Scalar>\*\s*bc\s*=", hc) is not None,
         "HeatConduction::bc is protected (P2-9 rev 2, that member only)")

    # ---- P2-10: NOTHING DELETED SURVIVES ------------------------------------
    # The retired-key list (MMWSpalling::Parse) is the ONE place the deleted keys
    # may be named -- it is what makes them abort. Everywhere else in src/, code
    # and comments alike, a deleted key, function or member is a leftover.
    print("\nP2-10 NOTHING DELETED SURVIVES IN src/ (outside the retired-key list)")
    DELETED = re.compile(
        'side_face_(?:flux|h|T|h_r_min|h_law|h_datum|factor_above|area_law|step_height|staircase)\\b|lateral_(?:drive|removal|subcell|thermal)\\b|per_cell_removal|jet_wall_march|jet_wall_mdot|jet_body|step_diag_radius|PerCellRemoval|FaceListFlux|ReconstructSurfaceT|fl_lat_top|fl_lat_nfb|SideFaceH|SideFaceTgas|ColumnWallCorner|PatchAzimuthFraction|UpdateWallLawState|WallJetH|WallJetBranch|WallZFill|WallMu\\b|UpdateColumnPhase|AssertStepSplit|WallStepDiagnostic|StepConductance|StepCellWeight|StaircaseFactor|AreaOfDelta|ColPhi|PairDelta|side_T_eff|groupB_given|surf_side_P_(?:top|buried|rin|rout)|lat_accum_col|lat_shift|ledger_E_flake_wall|sp_lateral_|pcr_on|wall_T_gas|jet_P_wall|wall_T_mouth')
    left = []
    for dp, _d, fs in os.walk(os.path.join(ROOT, "src")):
        for fn in fs:
            if not fn.endswith((".H", ".h", ".cpp", ".cc")):
                continue
            p = os.path.join(dp, fn)
            in_list = False
            for ln, line in enumerate(open(p, errors="replace"), 1):
                if "P2-10: THE RETIRED KEYS" in line:
                    in_list = True
                if in_list and "remove it from the input" in line:
                    in_list = False
                    continue
                if in_list:
                    continue
                if DELETED.search(line):
                    left.append("%s:%d %s" % (os.path.relpath(p, ROOT), ln, line.strip()[:70]))
    for o in left[:20]:
        print("       ** %s" % o)
    need(not left, "no deleted key, function or member is named anywhere in src/ outside "
                   "the retired-key list (%d line(s))" % len(left))
    nlist = sum(open(os.path.join(ROOT, "src", "Integrator", "MMWSpalling.H")).read()
                .count(k) for k in ("\"spall.lateral_drive\"", "\"surface_patch.side_face_flux\"",
                                    "\"surface_patch.jet_wall_march\""))
    need(nlist == 3, "the retired-key list itself exists and names them (%d of 3 probes)" % nlist)

    # ---- P2-26: THE CLOSED SWITCHES ARE GONE ---------------------------------
    # census B1 (dead members) and B3 (five closed switches). C++ IDENTIFIERS only:
    # the top-level key strings must survive exactly once, in the retired-at-default
    # table (unit/retired_keys R7), so a key-string pattern here would contradict it.
    print("\nP2-26 THE CLOSED SWITCHES (and P2-27's damage lineage, C1a) ARE GONE FROM src/ (identifiers, comments included)")
    P2_26 = {
        "B1": r"\bfl_wtop\b|\bsp_surface_T_mode\b|\bSurfaceTMode\b",
        "B3": (r"\bpad_shield_open\b|\bCheckPadRing\b|\bpad_open\b|\bjet_above_h\b|\bjet_T_above\b|"
               r"\bjet_rec_fixed\b|\bjet_T_rec_fixed\b|\bsp_flake_len_flux\b|\bsp_flake_frac_weibull\b|"
               r"\bsp_len_fb_[hq]0\b|\bW_CONE_MEDIAN\b|\bell_flux\b|\bfrac_over\b|\bsurf_ellq_col\b|"
               r"\brc_ellq\b|\bWeibullSizeFactor\b|\bsp_size_flux\b|\bweibull_V_ref\b"),
        "C2": (r"\bspall_surface_normal\b|\bsn_recession_superseded\b|\bSP_SN_COS_MIN\b|\bColumnSurfaceCos\b|"
               r"\bsn_cos_p\b|\bsn_cos_col\b|\bsn_cth\b|\bsn_icth\b|\bicth\b|\bsn_active\b|"
               r"\bspall_flake_coh_len\b|\bcoh_cells\b"),
        # `melt_aware` also ends the key string "spall.melt_aware", which survives once in the table
        "C3": (r"\bMeltSkeleton\b|(?<!\.)\bmelt_aware\b|\bmelt_lambda_crit\b|\bf_skel\b|\bLL_col_prof\b|"
               r"\bLL_col_p\b|\bLLcol_i\b|\bLL_at_didx\b"),
        # P2-27 (census C1a): the damage lineage -- the Drucker-Prager law, the cohesive zone, the damage-law
        # removal; the three key strings survive once each in the retired-at-default table (retired_keys R9)
        "C1a": (r"\bParseDamageSettings\b|\bUpdateDamageAfterMechanics\b|\bDamageGrowthRHS\b|"
                r"\bIntegrateDamageRK4\b|\bParseCohesiveSettings\b|\bUpdateCohesiveAfterMechanics\b|"
                r"\bResetCohesiveDiagnostics\b|\bPrincipalStressRatio\b|\bSpallSampleMode\b|\bDamageLaw\b|"
                r"\bdamage_enabled\b|\bcohesive_enabled\b|(?<!\.)\bkappa_damage_alpha\b|\bD_max_col\b|"
                r"\bspall_damage_threshold\b|\bspall_xi_s\b|\bspall_C_h\b|\bspall_ratio_f\b|\bDruckerPrager\b|"
                r"\bCohesiveZone\b"),
    }
    for tag, rx in P2_26.items():
        pat = re.compile(rx)
        # non-vacuity: the pattern must catch a planted leftover of its own list
        probe = rx.split("|")[0].replace("\\b", "")
        need(pat.search(" %s " % probe) is not None, "%s %s pattern catches a planted `%s`"
             % ("P2-27" if tag == "C1a" else "P2-26", tag, probe))
        hits = []
        for dp, _d, fs in os.walk(os.path.join(ROOT, "src")):
            for fn in fs:
                if fn.endswith((".H", ".h", ".cpp", ".cc")):
                    q = os.path.join(dp, fn)
                    for ln, line in enumerate(open(q, errors="replace"), 1):
                        if pat.search(line):
                            hits.append("%s:%d %s" % (os.path.relpath(q, ROOT), ln, line.strip()[:70]))
        for o in hits[:10]:
            print("       ** %s" % o)
        need(not hits, "no %s identifier of the deleted switches survives in src/ (%d line(s))" % (tag, len(hits)))

    print()
    if fails:
        print("FAIL: %d check(s) failed" % len(fails))
        return 1
    print("PASS: the stress-free reference is the STORED INITIAL FIELD -- write-once,\n"
          "      unplotted, read at BOTH firing sites -- the second driving form and\n"
          "      the support rule are DELETED rather than defaulted off, no strain\n"
          "      table has entered the criterion, the face list is one builder, one\n"
          "      heat rule and one breaking rule, and nothing P2-10 or P2-26 deleted\n"
          "      survives in src/ outside the retired-key lists.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
