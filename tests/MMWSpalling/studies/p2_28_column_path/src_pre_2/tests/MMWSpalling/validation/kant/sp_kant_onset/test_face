#!/usr/bin/env python3
# P2-28 -- KANT'S ONSET ON THE PRODUCTION CRITERION (the face list, evaluate-only).
#
# The site-A test (`test`, targets 1-6) re-expressed on the face list for its two scored targets:
#   3. the onset dT reproduces Kant Eq. 15 with the frozen K_Ic0 = 1.5 MPa m^0.5 within TOL_EQ15 = 8 %:
#        Theta = K_Ic (1 - nu) / (2 * 1.763 * sqrt(a/pi) * E * alpha) = 445.6 K  (E 35 GPa, nu 0.26, alpha 8e-6, a 20 um)
#   5. h_fl-independence: input_verification_face (h 150) and input_verification_hfl_face (h 250) within 8 %.
# THE STATISTIC (P2-13's, grimsel_calibration/reduce.py): per column (col_i, col_j) the FIRST events row with dir = 5 (a
# top face) and ts_fb = 0 (a reconstructed, not a fallback, surface temperature); its T_surf; the level = the median
# over the columns; dT = level - T_I (293.15 K). Evaluate-only writes one row per cell whose winning line fired, every
# step it fires (nothing is removed, so a cell can fire again): the FIRST row per column is the onset.
# Non-vacuity: every patch column (24 x 24) has a first top-face row within the run; the rows per column are bounded by
# the number of steps.
# Reported, not scored: the onset time; the old test's statistic on this run (the first plotfile time at which the
# top slab's max fr_score reaches 1, interpolated, with dT = the top cells' mean temperature - T_I).
# Usage: test_face [--check]
import csv
import glob
import math
import os
import re
import shutil
import subprocess
import sys

import numpy as np

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, "..", "..", "..", "..", ".."))
BIN = os.path.join(ROOT, "bin", "mmwspalling-3d-g++")
OUT = os.path.join(HERE, "output_face")

T_I, E, NU, ALPHA, A_FLAW, I_FK, KIC0_PA = 293.15, 35.0e9, 0.26, 8.0e-6, 20.0e-6, 1.763, 1.5e6
TOL_EQ15, TOL_HFL = 0.08, 0.08
NCOL = 24 * 24
CASES = [("verification", "input_verification_face", 48.0, 0.1),
         ("verification_hfl", "input_verification_hfl_face", 24.0, 0.1)]


def theta15(p_pa=0.0):
    return (1.0 - NU) / (E * ALPHA) * (KIC0_PA / (2.0 * I_FK * math.sqrt(A_FLAW / math.pi)) - p_pa * NU / (1.0 - NU))


def run(tag, deck, extra=()):
    d = os.path.join(OUT, tag)
    for p in [d, d + "_removal_events.csv"]:
        if os.path.isdir(p):
            shutil.rmtree(p)
        elif os.path.exists(p):
            os.remove(p)
    argv = ["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "4", BIN, os.path.join(HERE, deck)] + \
        list(extra) + ["plot_file=%s" % d]
    os.makedirs(OUT, exist_ok=True)
    with open(d + ".log", "w") as log:
        rc = subprocess.call(argv, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
    open(d + ".argv", "w").write(" ".join(argv) + "\n")
    print("  %-18s rc %d" % (tag, rc), flush=True)
    return rc


def onset_rows(csv_path):
    """P2-13's statistic: {col: first row with dir 5 and ts_fb 0}; plus every row's column count"""
    rows = list(csv.DictReader(open(csv_path)))
    first, per_col = {}, {}
    for r in rows:
        c = (int(r["col_i"]), int(r["col_j"]))
        per_col[c] = per_col.get(c, 0) + 1
        if float(r["ts_fb"]) == 0.0 and r["dir"] == "5":
            first.setdefault(c, r)
    return rows, first, per_col


# ---- the old statistic on this run (reported): a minimal cell-plotfile reader, no yt -----------------------------
FAB = re.compile(rb"FAB \(\(8, \(([\d ]+)\)\),\(8, \(([\d ]+)\)\)\)\(\(([-\d,]+)\) \(([-\d,]+)\) \(([\d,]+)\)\) (\d+)\n")


def top_slab(pf, names):
    L = open(os.path.join(pf, "Header")).read().split("\n")
    n = int(L[1])
    comps, t = L[2:2 + n], float(L[2 + n + 1])
    boxes = []
    for fn in sorted(glob.glob(os.path.join(pf, "Level_0", "Cell_D_*"))):
        raw = open(fn, "rb").read()
        pos = 0
        while pos < len(raw):
            m = FAB.match(raw, pos)
            lo = [int(x) for x in m.group(3).split(b",")]
            hi = [int(x) for x in m.group(4).split(b",")]
            nc = int(m.group(6))
            npts = int(np.prod([h - l + 1 for l, h in zip(lo, hi)]))
            dt = np.dtype("<f8") if m.group(2).split()[0] == b"8" else np.dtype(">f8")
            data = np.frombuffer(raw, dtype=dt, count=nc * npts, offset=m.end()).reshape(nc, npts)
            boxes.append((lo, hi, data))
            pos = m.end() + nc * npts * 8
    ktop = max(b[1][2] for b in boxes)
    out = {nm: [] for nm in names}
    for lo, hi, data in boxes:
        if hi[2] != ktop:
            continue
        shp = (hi[2] - lo[2] + 1, hi[1] - lo[1] + 1, hi[0] - lo[0] + 1)
        for nm in names:
            out[nm].append(data[comps.index(nm)].reshape(shp)[-1].ravel())
    return t, {nm: np.concatenate(v) for nm, v in out.items()}


def onset_plotfiles(d, field):
    pfs = []
    for p in glob.glob(os.path.join(d, "*cell")):
        m = re.search(r"(\d+)cell$", p)
        if m:
            pfs.append((int(m.group(1)), p))
    prev = None
    for _, p in sorted(pfs):
        t, s = top_slab(p, [field, "Temp"])
        mx, dT = float(np.max(s[field])), float(np.mean(s["Temp"])) - T_I
        if mx >= 1.0:
            if prev is None:
                return t, dT
            t0, mx0, dT0 = prev
            f = (1.0 - mx0) / (mx - mx0) if mx > mx0 else 1.0
            return t0 + f * (t - t0), dT0 + f * (dT - dT0)
        prev = (t, mx, dT)
    return None, None


def main():
    check = "--check" in sys.argv
    fails = []
    if not check:
        print("running the face decks:")
        for tag, deck, _, _ in CASES:
            if run(tag, deck) != 0:
                fails.append("%s exited non-zero" % tag)
        if fails:
            print("\n".join(fails) + "\nFAIL")
            sys.exit(1)
    th = theta15()
    print("\nKant Eq. 15 onset dT (frozen K_Ic0 = 1.5): %.1f K" % th)
    dT = {}
    for tag, _, stop, dt in CASES:
        p = os.path.join(OUT, tag + "_removal_events.csv")
        if not os.path.exists(p):
            fails.append("%s: no events file" % tag)
            continue
        rows, first, per_col = onset_rows(p)
        nsteps = int(round(stop / dt))
        if len(first) < NCOL:
            fails.append("%s: %d of %d patch columns have a first top-face row (empty statistic)" % (tag, len(first), NCOL))
        if per_col and max(per_col.values()) > nsteps:
            fails.append("%s: %d rows in one column > %d steps" % (tag, max(per_col.values()), nsteps))
        if not first:
            continue
        Ts = np.array([float(r["T_surf"]) for r in first.values()])
        t1 = np.array([float(r["time"]) for r in first.values()])
        level = float(np.median(Ts))
        dT[tag] = level - T_I
        err = abs(dT[tag] - th) / th
        tp, dTp = onset_plotfiles(os.path.join(OUT, tag), "fr_score")
        print("  %-18s rows %6d, columns %d/%d (rows per column max %d of %d steps); first onset t %.2f s"
              % (tag, len(rows), len(first), NCOL, max(per_col.values()), nsteps, float(t1.min())))
        print("  %-18s level (median first T_surf) %.2f K (p10 %.2f, p90 %.2f) -> dT %.1f K  vs Eq. 15 %.1f K: "
              "rel err %.2f %%  %s" % ("", level, np.percentile(Ts, 10), np.percentile(Ts, 90), dT[tag], th, 100 * err,
                                         "ok" if err <= TOL_EQ15 else "FAIL"))
        print("  %-18s (reported) the old statistic on this run: max fr_score >= 1 at t %s, top-cell mean dT %s"
              % ("", "%.2f s" % tp if tp is not None else "never",
                 "%.1f K" % dTp if dTp is not None else "-"))
        if err > TOL_EQ15:
            fails.append("target 3 %s: dT %.1f K vs Eq. 15 %.1f K (%.1f %% > 8 %%)" % (tag, dT[tag], th, 100 * err))
    if len(dT) == 2:
        a, b = dT["verification"], dT["verification_hfl"]
        rd = abs(a - b) / a
        print("\n[target 5] h_fl-independence: dT %.1f K (h 150) vs %.1f K (h 250): rel diff %.2f %%  %s"
              % (a, b, 100 * rd, "ok" if rd <= TOL_HFL else "FAIL"))
        if rd > TOL_HFL:
            fails.append("target 5: rel diff %.2f %% > 8 %%" % (100 * rd))
    print()
    if fails:
        print("FAILURES:")
        print("\n".join("  " + f for f in fails))
        print("\nFAIL")
        sys.exit(1)
    print("PASS")


if __name__ == "__main__":
    main()
