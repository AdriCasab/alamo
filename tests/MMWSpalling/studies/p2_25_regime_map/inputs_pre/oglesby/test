DOE_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "studies", "p2_21_loss_table", "doe")
B0_REF = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "studies", "p2_23_beam_port", "legs", "B0",
                      "run")
SHIFT, DOE_ON, DOE_OFF = 210.0, 495.0, 1790.0      # Fig. 34's clock: beam-on, onset (last pre-jump window), beam-off


def doe_tables():
    P, V, Tt = {}, {}, {}
    for ln in open(os.path.join(DOE_DIR, "FIG34_FULL.txt")):
        q = ln.split()
        if len(q) == 4 and q[0].isdigit():
            P[int(q[0])], V[int(q[0])] = float(q[1]), float(q[2])
    for ln in open(os.path.join(DOE_DIR, "FIG34_TOP.txt")):
        q = ln.split()
        if len(q) >= 2 and q[0].isdigit():
            try:
                Tt[int(q[0])] = float(q[1])
            except ValueError:
                pass
    return P, V, Tt


class MLeg:
    """a P2-24 leg: every thermo row (t > 0), the onset, the solidus row"""
    def __init__(self, run):
        self.run = run
        self.m = meta(run)
        self.h, self.rows = thermo(run)
        self.dt = self.rows[1]["time"] - self.rows[0]["time"]
        self.ev = csvrows(run + "_removal_events.csv")
        self.onset_row = next((r for r in self.rows if math.isfinite(r["bc_z_melt"])), None)
        self.t_on = self.onset_row["time"] if self.onset_row else math.nan
        self.sol_row = next((r for r in self.rows if math.isfinite(r["bc_f_L_peak"]) and r["bc_f_L_peak"] > 0), None)
        self.lit = [r for r in self.rows if r["beam_P_beam"] > 0]
        self.t_off = max(r["time"] for r in self.lit) if self.lit else math.nan

    def at(self, t):
        if not math.isfinite(t):
            return None
        r = min(self.rows, key=lambda x: abs(x["time"] - t))
        return r if abs(r["time"] - t) <= self.dt * 0.51 + 1e-9 else None

    def trans(self, r):
        return r["beam_P_trans"] / r["beam_P_beam"] if r["beam_P_beam"] > 0 else math.nan

    def collapse(self, factor):
        """the time after onset at which P_trans/P_beam first falls below factor x its onset value"""
        if self.onset_row is None:
            return math.nan, math.nan
        r0 = self.trans(self.onset_row)
        for r in self.rows:
            if r["time"] >= self.t_on and r["beam_P_beam"] > 0 and self.trans(r) < factor * r0:
                return r["time"] - self.t_on, r0
        return math.inf, r0


def C(TK):
    return TK - 273.15 if TK is not None and math.isfinite(TK) else math.nan


def binned(rows, key, lo, hi, val):
    v = [val(r) for r in rows if lo <= key(r) <= hi and math.isfinite(val(r))]
    return (sum(v) / len(v), len(v)) if v else (math.nan, 0)


def table_jump(L):
    log = os.path.join(os.path.dirname(L.run), "run.log")
    txt = open(log, errors="replace").read().replace("\0", "") if os.path.exists(log) else ""
    import re
    m = re.search(r"H\(fus_lo ([0-9.]+) K\) = ([0-9.eE+-]+), H\(fus_hi ([0-9.]+) K\) = ([0-9.eE+-]+)", txt)
    if not m:
        return None
    T1, H1, T2, H2 = (float(x) for x in m.groups())
    g = lambda k, d: float(L.m.get("microstructure.phase0.grimsel." + k, d))
    a, b, th0, rho = g("cp.a", 1370), g("cp.b", 178000), g("cp.th0", 271), g("rho", 2650)
    Lm = float(L.m["microstructure.phase0.L_m"])
    x1, x2 = T1 - 273.15, T2 - 273.15
    inv = rho * Lm + rho * (a * (x2 - x1) - b * math.log((x2 + th0) / (x1 + th0)))
    return T1, T2, H2 - H1, inv, rho * Lm


def main_p2_24(argv):
    import argparse
    ap = argparse.ArgumentParser()
    ap.add_argument("run")
    ap.add_argument("--onset", action="store_true")
    ap.add_argument("--alt")
    ap.add_argument("--flat")
    ap.add_argument("--fine")
    a = ap.parse_args(argv)
    M0 = MLeg(a.run)
    P, V, TT = doe_tables()
    print("P2-24 #19 through its 26 minutes, the melt a state (units: s, m printed mm, K and C, W)")
    print("  %s: dt %.3g s, %d step rows, the beam lit to %.1f s, %d removal-event rows; phase0 T_m %s, fus_width %s, "
          "beam.melt_factor %s, beam.R_melt %s, vapor.enabled %s" % (
              a.run, M0.dt, len(M0.rows), M0.t_off, len(M0.ev), M0.m.get("microstructure.phase0.T_m"),
              M0.m.get("microstructure.phase0.fus_width"), M0.m.get("beam.melt_factor"), M0.m.get("beam.R_melt"),
              M0.m.get("vapor.enabled")))
    print("=" * 110)
    tj = table_jump(M0)
    if tj:
        T1, T2, jump, inv, lat = tj
        need(abs(jump / inv - 1.0) <= 1e-6, "b1 (i) the run's table jump H(%.1f) - H(%.1f) = %.10e J/m3 vs rho L_m + rho "
             "int c_p dT = %.10e (rel %.1e; bar 1e-6; the latent share %.3f)" % (T2, T1, jump, inv, jump / inv - 1.0,
                                                                                lat / inv))
    else:
        need(False, "b1 (i) the run's table print not found in %s" % os.path.join(os.path.dirname(a.run), "run.log"))
    need(M0.onset_row is not None, "b1 (ii) the first step row with a finite bc_z_melt: %s" % (
        "%.1f s (bc_z_melt %s, bc_T_peak %.1f K)" % (M0.t_on, mm(M0.onset_row["bc_z_melt"]), M0.onset_row["bc_T_peak"])
        if M0.onset_row else "never"))
    mush = [r for r in M0.rows if math.isfinite(r["bc_f_L_peak"]) and 0.0 < r["bc_f_L_peak"] < 1.0]
    need(len(mush) > 0, "b1 (iii) rows with 0 < bc_f_L_peak < 1: %d" % len(mush))
    # b1r
    ref_sol = ref_on = None
    if os.path.isdir(B0_REF):
        _, rb = thermo(B0_REF)
        ref_sol = next((r["time"] for r in rb if r["bc_T_peak"] > 1410.5), None)
        ref_on = next((r["time"] for r in rb if math.isfinite(r["bc_z_melt"])), None)
    dwell, i0 = 0, None
    for i, r in enumerate(M0.rows):
        f = r["bc_f_L_peak"]
        if i0 is None and math.isfinite(f) and f > 0:
            i0 = i
        if i0 is not None:
            if math.isfinite(f) and 0 < f < 1:
                dwell += 1
            else:
                break
    print("\nb1r (report) the solidus (first bc_f_L_peak > 0) at %s vs P2-23 B0's first bc_T_peak > 1410.5 K at %s "
          "(%s); the onset (bc_z_melt, T_m 1510.5 K) at %.1f s vs B0's %s (%+.1f s: the latent heat); the dwell: %d "
          "consecutive rows (%.1f s) with the peak inside the band" % (
              "%.1f s" % M0.sol_row["time"] if M0.sol_row else "never", "%.1f s" % ref_sol if ref_sol else "-",
              ("same row" if ref_sol and M0.sol_row and abs(M0.sol_row["time"] - ref_sol) < 1e-9 else
               "%+.1f s" % (M0.sol_row["time"] - ref_sol) if ref_sol and M0.sol_row else "-"),
              M0.t_on, "%.1f s" % ref_on if ref_on else "-", M0.t_on - ref_on if ref_on else math.nan, dwell,
              dwell * M0.dt))
    # b2
    ce = [r["beam_col_err_max"] for r in M0.rows if "beam_col_err_max" in r]
    cef = [x for x in ce if math.isfinite(x)]
    need(len(cef) == len(ce) and max(cef) <= 1e-12, "b2 beam_col_err_max over %d rows: max %.2e (bar 1e-12; %d NaN)" % (
        len(ce), max(cef) if cef else math.nan, len(ce) - len(cef)))
    cl = [r["beam_closure_err"] for r in M0.lit]
    pre = [r["beam_closure_err"] for r in M0.lit if r["time"] < M0.t_on]
    post = [r["beam_closure_err"] for r in M0.lit if r["time"] >= M0.t_on]
    print("b2r (report) beam_closure_err over %d lit rows: %.3e .. %.3e (pre-onset %.3e .. %.3e, post %.3e .. %.3e); "
          "inside -1e-5 .. +3e-2: %s" % (len(cl), min(cl), max(cl), min(pre), max(pre), min(post) if post else math.nan,
                                         max(post) if post else math.nan, min(cl) >= -1e-5 and max(cl) <= 3e-2))
    legs = [("M0", M0)]
    if a.alt:
        legs.append(("M100", MLeg(a.alt)))
    if a.flat:
        legs.append(("M0F", MLeg(a.flat)))
    F = MLeg(a.fine) if a.fine else None

    # m1
    doe_f = V[565] / V[495] if 565 in V and 495 in V else math.nan
    doe_f_kw = (V[565] / P[565]) / (V[495] / P[495]) if all(k in P and k in V for k in (495, 565)) else math.nan
    print("\nm1 (report; P1) the transmission per BEAM power, onset-aligned. DOE: pick-off %.4f V at 495 s -> %.4f V at 565 "
          "s = x%.3f in 70 s (per kW x%.3f); the DOE onset is %.0f s after beam-on" % (
              V.get(495, math.nan), V.get(565, math.nan), doe_f, doe_f_kw, DOE_ON - SHIFT))
    for lab, L in legs[:2]:
        tc, r0 = L.collapse(0.148)
        r70 = L.at(L.t_on + 70.0)
        first = L.lit[0]
        print("   %-5s onset %.1f s: P_trans/P_beam %.4f (the first lit row %.4f; P_trans/P_inc there %.4f vs P2-21's cold "
              "0.4966 x 0.76 = 0.377); below x0.148 of it %s after onset; at onset + 70 s x%.3f" % (
                  lab, L.t_on, r0, L.trans(first), first["beam_P_trans"] / first["beam_P_inc"],
                  "%.1f s" % tc if math.isfinite(tc) else "NEVER", L.trans(r70) / r0 if r70 else math.nan))
    # m2
    print("\nm2 (report; P2) the absorbed fraction per beam power, and the central column's R")
    for lab, L in legs:
        r70 = L.at(L.t_on + 70.0)
        post = [r for r in L.lit if r["time"] >= L.t_on]
        b2kw = binned(post, lambda r: r["beam_P_beam"], 1900, 2100, lambda r: r["beam_P_dep"] / r["beam_P_beam"])
        Rb = binned(post, lambda r: r["beam_P_beam"], 1900, 2100, lambda r: r["bc_R_col"])
        print("   %-5s at onset + 70 s: P_dep/P_beam %.4f, P_inc/P_beam %.4f, bc_R_col %.4f; over %d post-onset rows at "
              "1.9-2.1 kW: P_dep/P_beam %.4f, bc_R_col %.4f" % (
                  lab, r70["beam_P_dep"] / r70["beam_P_beam"] if r70 else math.nan,
                  r70["beam_P_inc"] / r70["beam_P_beam"] if r70 else math.nan, r70["bc_R_col"] if r70 else math.nan,
                  b2kw[1], b2kw[0], Rb[0]))
    # m3
    print("\nm3 (report; P3) the synthetic 137 GHz radiometer (bc_T_rad = the view mean of eps_137 T_top over r <= 16.25 "
          "mm), C")
    doe_post = [t for t in sorted(TT) if t >= DOE_ON + 100 and t in P and math.isfinite(P[t])]
    d19 = binned(doe_post, lambda t: P[t], 1.9, 2.1, lambda t: TT[t])
    d33 = binned(doe_post, lambda t: P[t], 3.2, 3.4, lambda t: TT[t])
    pre_doe = [TT[t] for t in sorted(TT) if SHIFT <= t <= DOE_ON]
    print("   DOE: onset + 20 s %.0f C, + 100 s %.0f C; post-onset (>= +100 s) binned by power: 1.9-2.1 kW %.0f C (%d "
          "windows), 3.2-3.4 kW %.0f C (%d); pre-melt mean %.0f C, max %.0f C" % (
              TT.get(515, math.nan), TT.get(595, math.nan), d19[0], d19[1], d33[0], d33[1],
              sum(pre_doe) / len(pre_doe), max(pre_doe)))
    for lab, L in legs:
        post = [r for r in L.lit if r["time"] >= L.t_on + 100.0]
        m19 = binned(post, lambda r: r["beam_P_beam"], 1900, 2100, lambda r: C(r["bc_T_rad"]))
        m33 = binned(post, lambda r: r["beam_P_beam"], 3200, 3400, lambda r: C(r["bc_T_rad"]))
        before = [r for r in L.rows if r["time"] < L.t_on]
        rb = before[-1] if before else None
        r20, r100 = L.at(L.t_on + 20.0), L.at(L.t_on + 100.0)
        print("   %-5s onset + 20 s %.0f C, + 100 s %.0f C (view mean T %.0f / %.0f C); binned: 1.9-2.1 kW %.0f C (%d rows), "
              "3.2-3.4 kW %.0f C (%d) => %+.1f %% (DOE %+.1f %%); just before onset %.0f C (view mean %.0f C)" % (
                  lab, C(r20["bc_T_rad"]) if r20 else math.nan, C(r100["bc_T_rad"]) if r100 else math.nan,
                  C(r20["bc_T_view"]) if r20 else math.nan, C(r100["bc_T_view"]) if r100 else math.nan,
                  m19[0], m19[1], m33[0], m33[1], 100 * (m33[0] / m19[0] - 1), 100 * (d33[0] / d19[0] - 1),
                  C(rb["bc_T_rad"]) if rb else math.nan, C(rb["bc_T_view"]) if rb else math.nan))
    # m4
    print("\nm4 (report; P4) the melt spot 2 sqrt(bc_A_melt / pi) (top solid cells with f_L > 0)")
    for lab, L in legs:
        end = L.at(L.t_off)
        grow = " ".join("%.0fs/%.2fkW/%.1fmm" % (r["time"], r["beam_P_beam"] / 1e3, 2e3 * math.sqrt(r["bc_A_melt"] / math.pi))
                        for r in L.lit if abs(r["time"] / 200.0 - round(r["time"] / 200.0)) < 1e-9)
        print("   %-5s at the end of heating (%.1f s, %.2f kW): %.1f mm vs ~38 mm (DOE '~1 1/2\"'); against time/power: %s"
              % (lab, end["time"], end["beam_P_beam"] / 1e3, 2e3 * math.sqrt(end["bc_A_melt"] / math.pi), grow))
    # m5
    print("\nm5 (report; P5) after beam-off: DOE 1805 / 1855 / 2005 s = %.0f / %.0f / %.0f C" % (
        TT.get(1805, math.nan), TT.get(1855, math.nan), TT.get(2005, math.nan)))
    for lab, L in legs:
        plat = L.at(L.t_off)
        v = {d: L.at(L.t_off + d) for d in (5, 15, 55, 65, 205, 215)}
        txt = " ".join("+%d:%.0f" % (d, C(v[d]["bc_T_rad"]) if v[d] else math.nan) for d in sorted(v))
        p55, p65 = (C(v[d]["bc_T_rad"]) / C(plat["bc_T_rad"]) if v[d] else math.nan for d in (55, 65))
        print("   %-5s at beam-off (%.1f s) %.0f C; %s C; +55 s = %.0f %% of the plateau's C (+65 s: %.0f %%; DOE "
              "627/2281 = %.0f %%)" % (lab, L.t_off, C(plat["bc_T_rad"]), txt, 100 * p55, 100 * p65,
                                       100 * 627 / 2281))
    # m6
    print("\nm6 (report; P6) vapour and the exclusions")
    for lab, L in legs:
        prog = " ".join("%.0fs:%d/%d" % (r["time"], r.get("bc_n_vapor", 0), r.get("bc_n_vapor_int", 0))
                        for r in L.rows if r["time"] in (300.0, 600.0, 900.0, 1200.0, 1580.0, 1800.0))
        fv = next((r for r in L.rows if r.get("fr_n_vapor", 0) > 0), None)
        fi = next((r for r in L.rows if r.get("fr_n_vapor_int", 0) > 0), None)
        post = [r for r in L.rows if r["time"] >= L.t_on]
        n2 = sum(1 for e in L.ev if e["regime"] == 2)
        print("   %-5s bc_n_vapor/bc_n_vapor_int %s; the first surface void %s; the first buried count %s; "
              "ledger_E_vapor %.4g J; events regime 2: %d; after onset: fr_n_molten max %d, fr_n_lid max %d, bk_n_eval "
              "max %d (sum %d), removals %d" % (
                  lab, prog, "%.1f s at %.0f W" % (fv["time"], fv["beam_P_beam"]) if fv else "none",
                  "%.1f s at %.0f W" % (fi["time"], fi["beam_P_beam"]) if fi else "none",
                  L.rows[-1].get("ledger_E_vapor", math.nan), n2, max((r["fr_n_molten"] for r in post), default=0),
                  max((r["fr_n_lid"] for r in post), default=0), max((r["bk_n_eval"] for r in post), default=0),
                  sum(r["bk_n_eval"] for r in post), sum(removals(r) for r in post)))
    # m7
    if F is not None:
        print("\nm7 (report; P7) M1 (0.78 mm) vs M0 over onset .. onset + 120 s")
        for lab, L in (("M0", M0), ("M1", F)):
            tc, r0 = L.collapse(0.148)
            pts = " ".join("+%d: f_L %.3f z_liq %s" % (
                d, L.at(L.t_on + d)["bc_f_L_peak"] if L.at(L.t_on + d) else math.nan,
                mm(L.at(L.t_on + d)["bc_z_liq"]) if L.at(L.t_on + d) else "-") for d in (30, 60, 120))
            print("   %-3s onset %.1f s; the collapse to x0.148 %s after onset; %s" % (
                lab, L.t_on, "%.1f s" % tc if math.isfinite(tc) else "NEVER (in %.0f s)" % (L.rows[-1]["time"] - L.t_on),
                pts))
    print("=" * 110)
    print("FAIL (%d)" % len(FAIL) if FAIL else "PASS")
    return 1 if FAIL else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
