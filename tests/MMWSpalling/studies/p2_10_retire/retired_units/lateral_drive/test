    print("[P1f] (a1) cell-form branch writes nothing -- SOURCE assertion, see caveat")
    src = open(os.path.join(ROOT, "src", "Integrator", "MMWSpalling.H")).read()
    writes = re.findall(r"if \(T_face_out\) \*T_face_out = (\w+);", src)
