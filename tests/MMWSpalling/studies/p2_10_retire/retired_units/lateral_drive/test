        # so threshold arrives EARLIER on the same drive.
        fser = [x[0] for x in thermo_rows("LAD_HOT_DIAG", ["lat_fires"], root)]
        kfirst = next((i for i, v in enumerate(fser) if v > 0.0), None)
        print("      %s lat_fires %6.0f   lat_qmax %.4f   T_face_max %7.2f K   "
              "first firing step %s%s"
              % (tag, fi, qm_x, tf_x, kfirst,
                 "   margin to %.1f K = %+.1f K" % (th, tf_x - th)
                 if th else ""))
    print("      ⚠ the margin is drive-dependent, which is why this is a report")
    print("        and the exact claim lives in (u2).")
    print("      ⚠⚠ the packet's expectation was 0 -> >0. It is NOT what happens:")
    print("         the corner ALREADY fires pre-fix, because the criterion's")
    print("         drive is the 80 W/m2K cap on BOTH legs (see u2), so the")
    print("         fix moves the count and the ONSET TIME, not 0 -> nonzero.")

    # ========= P1g-0b: (a3) runtime aborts, (c1) the lift, (c4) cavities =====
    print("\n" + "=" * 70)
    print("P1g-0b -- THE COEFFICIENT CAP (Removal.H:506 -> the kernel's condition)")
    print("=" * 70)

    print("\n[P1g-0b] (a3) THE RUNTIME ABORTS -- fired, and silent when satisfied")
    if "--check" in sys.argv:
        print("     (--check: not run)")
    else:
        def abort_leg(name, extra):
            d = os.path.join(OUT, name)
            if os.path.exists(d):
                shutil.rmtree(d)
            os.makedirs(d, exist_ok=True)
            argv = ["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "4",
                    BIN, INP, "plot_file=%s/run" % d,
                    "spall.lateral_drive=1", "spall.lateral_removal=1",
                    "spall.seed_void=%s" % RISER, "stop_time=0.2"] + extra
            with open(os.path.join(OUT, name + ".log"), "w") as lg:
                rc = subprocess.call(argv, stdout=lg, stderr=subprocess.STDOUT)
            txt = open(os.path.join(OUT, name + ".log"),
                       errors="replace").read()
            txt = re.sub(r"\x1b\[[0-9;]*m", "", txt)
            line = next((l for l in txt.split("\n")
                         if "ABORT" in l and "lateral_drive" in l), "")
            return rc, line.strip()
        # ⚠ the violating configurations, and the shipped one as the control
        rc_c, ln_c = abort_leg("AB_CLOSURE",
                               ["surface_patch.side_face_closure=cell"])
        rc_p, ln_p = abort_leg("AB_PINNED",
                               ["surface_patch.robin_form=pinned"])
        rc_o, ln_o = abort_leg("AB_OK", [])
        for tag, rc, ln in (("side_face_closure=cell", rc_c, ln_c),
