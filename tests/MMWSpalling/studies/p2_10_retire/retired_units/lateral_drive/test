def T_face_pred(side_h):
    return T_REF + side_h / (side_h + G_ROCK) * (T_GAS - T_REF)


# --- the criterion, recomputed by hand. The ONLY independent check of the
# --- score the branch decides on; it reproduced the packet's own thresholds
# --- (756.4 K absolute / 942.0-1084.9 K differential at 8 um) to the kelvin.
KIC_T = (298.15, 523.15, 723.15, 923.15, 1123.15)
KIC_V = (1.43, 1.35, 0.98, 0.43, 0.22)
C_TH  = 30.0e9 * 8.0e-6 / (1.0 - 0.30)       # Pa/K, = Removal.H:488


def kic_mpa(T):
    if T <= KIC_T[0]:  return KIC_V[0]
    if T >= KIC_T[-1]: return KIC_V[-1]
    for i in range(len(KIC_T) - 1):
        if T <= KIC_T[i + 1]:
            f = (T - KIC_T[i]) / (KIC_T[i + 1] - KIC_T[i])
            return (1.0 - f) * KIC_V[i] + f * KIC_V[i + 1]
    return KIC_V[-1]


def tada_g(x):
    return 1.3 if x <= 0.0 else 1.3 - 0.3 * x ** 1.25


def q_hand(T_face, ell, a, diff, n=64):
    """K_I/K_Ic by hand, in Pa*sqrt(m) on BOTH sides -- the unit the bug got
    wrong. Mirrors SpCriterion::K_I's composite Simpson on xi = sin(theta)."""
    dT = T_face - T_REF
    if not (dT > 0.0 and ell > 0.0 and a > 0.0):
        return 0.0
    h_f = min(0.4 * ell, 1.5e-3)
    def sig(xi):
        j = dT * math.exp(-xi / ell)
        if diff:
            j *= (1.0 - math.exp(-h_f / ell))
        return C_TH * j if j > 0.0 else 0.0
    step = (0.5 * math.pi) / n
    acc = 0.0
    for k in range(n + 1):
        xi = math.sin(step * k)
        w = 1.0 if (k == 0 or k == n) else (4.0 if k % 2 else 2.0)
        acc += w * sig(xi * a) * tada_g(xi)
    K_I = 2.0 * math.sqrt(a / math.pi) * acc * step / 3.0
    T_tip = T_REF + dT * math.exp(-a / ell)
    return K_I / (kic_mpa(T_tip) * 1.0e6)


def q_thresh(ell, a, diff):
    lo, hi = T_REF + 1.0, 5000.0
    if q_hand(hi, ell, a, diff) < 1.0:
        return None
    for _ in range(200):
        m = 0.5 * (lo + hi)
        if q_hand(m, ell, a, diff) >= 1.0: hi = m
        else:                              lo = m
    return hi


# ===== P1g-0: THE FACE NEWTON BY HAND, AND ITS INVERSE ====================
# ⚠⚠ WHY THIS EXISTS. The packet's (u2) bar -- "the lift ratio is sqrt(2) to
# round-off" -- CANNOT HOLD, and the reason is in the kernel's own equation
# (MMWSpalling.H:3769-3790):
#
#     G (Tf - Tc) = h (Tg - Tf) - eps sig (Tf^4 - Ta^4) - h_c (Tf - Ta)
#                 =: R(Tf),      G = 2k/dz
#
# so the lift is L = R(Tc + L)/G. R is DECREASING in Tf, so with
# B := h + 4 eps sig Tf^3 + h_c > 0 the ratio of lifts is
#
#     L_post / L_pre  =  (G_pre + B) / (G_post + B)   <  G_pre/G_post = sqrt(2)
#
# STRICTLY, for every B > 0 -- and B >= h_conv = 10 always. Measured on this
# fixture it is 1.277 at h = 700 (10.4 % below sqrt 2), 1.340 at h = 305 and
# 1.368 at h = 169.3: the ratio is not an invariant at all, it DEPENDS ON THE
# DRIVE. sqrt(2) is exact on the CONDUCTANCE, G_pre/G_post = 1/|n_x|, and that
# is where it is asserted below.
#
# What replaces it is STRICTER, not weaker: recompute the face temperature from
# the kernel's own equation and require the logged value to round-off. Nothing
# is fitted and there is no tolerance to tune.
KAPPA  = 1.5            # microstructure.phase0.kappa, W/mK  (input)
DX_M   = 2.0e-3         # dx = dy = dz, from amr.n_cell + geometry.prob_hi
EPS_LO = 0.8            # losses.epsilon; T_eps_break = 1e30 => eps_lo always
SIG_SB = 5.670374e-8    # losses.sigma_SB
H_CONV = 10.0           # losses.h_conv
T_AMB  = 293.15         # losses.T_amb
# ⚠ exactly as the code forms it: comp = |hx|/hypot(hx,hy) with hx = hy = 1.
# 1.0/hypot(1,1) and sqrt(2)/2 differ in the last bit; use the code's form.
COMP45 = 1.0 / math.hypot(1.0, 1.0)
G_POST = 2.0 * KAPPA / DX_M             # the fix: dz = DX[0]
G_PRE  = 2.0 * KAPPA / (DX_M * COMP45)  # the defect: dz = d_n = DX[0]*|n_x|


def face_newton(G, h, Tc, Tg=T_GAS):
    """Tf solving F(Tf) = 0, the kernel's bisection-guarded Newton run tight."""
    lo, hi = min(Tc, Tg, T_AMB), max(Tc, Tg, T_AMB)
    Tf = Tc
    for _ in range(200):
        T3 = Tf * Tf * Tf
        F = (G * (Tf - Tc) - h * (Tg - Tf)
             + EPS_LO * SIG_SB * (T3 * Tf - T_AMB ** 4) + H_CONV * (Tf - T_AMB))
        if F == 0.0:
            break
        if F > 0.0: hi = Tf
        else:       lo = Tf
        dF = G + h + 4.0 * EPS_LO * SIG_SB * T3 + H_CONV
        Tn = Tf - F / dF
        if not (lo <= Tn <= hi):
            Tn = 0.5 * (lo + hi)
        step = Tn - Tf
        Tf = Tn
        if abs(step) <= 1.0e-14 * Tc:
            break
    return Tf


def loss_at(Tf):
    """eps sig (Tf^4 - Ta^4) + h_c (Tf - Ta) -- everything in R but h(Tg-Tf)."""
    return (EPS_LO * SIG_SB * (Tf ** 4 - T_AMB ** 4) + H_CONV * (Tf - T_AMB))


def cell_from_face(Tf, G, h, Tg=T_GAS):
    """Tc = Tf - R(Tf)/G -- the balance inverted for a KNOWN h."""
    return Tf - (h * (Tg - Tf) - loss_at(Tf)) / G


def cell_and_h(Tf_pre, Tf_post, Tg=T_GAS):
    """Recover (Tc, h) from the two logged faces -- NO assumption about either.

    ⚠⚠ THIS IS WHY (u2) NEEDS NO SOURCE CHANGE AND NO CONSTANT FROM THE INPUT.
    Before any firing the two binaries see the SAME thermal field and the same
    side-face pair, so one (Tc, h) must satisfy BOTH balances, which differ only
    in dz:
        G (Tf - Tc) = h (Tg - Tf) - loss(Tf)
    Two equations, two unknowns, linear in both:
        G_pre  Tc + (Tg - Tf_pre ) h = G_pre  Tf_pre  + loss(Tf_pre )
        G_post Tc + (Tg - Tf_post) h = G_post Tf_post + loss(Tf_post)
    ⚠ h must then come out CONSTANT across every pre-firing step. That is the
    real assertion: if the max-score face moved to a different cell between the
    binaries, or if anything but dz changed, h scatters and the row fails. It
    also RECOVERS the drive the criterion actually used, which is NOT the
    ladder's side_face_h -- see the cap note in the (u2) block.
    """
    a1, b1, c1 = G_PRE,  Tg - Tf_pre,  G_PRE * Tf_pre + loss_at(Tf_pre)
    a2, b2, c2 = G_POST, Tg - Tf_post, G_POST * Tf_post + loss_at(Tf_post)
    det = a1 * b2 - a2 * b1
    if abs(det) < 1.0e-30:
        return None, None
    return (c1 * b2 - c2 * b1) / det, (a1 * c2 - a2 * c1) / det


def thermo_rows(base, keys, root=None):
    """per-step tuples of `keys`; `root` selects an ARCHIVED output tree."""
    f = os.path.join(root or OUT, base, "run", "thermo.dat")
    if not os.path.exists(f):
        return []
    L = open(f).read().strip().split("\n")
    h = L[0].split()
    if any(k not in h for k in keys):
        return []
    ix = [h.index(k) for k in keys]
    rows = []
    for r in L[1:]:
        fl = r.split()
        if len(fl) > max(ix):
            rows.append(tuple(float(fl[i]) for i in ix))
    return rows


def first_prefiring(base, root=None):
    """(index, lat_Tface_max) at the first logged step that HAS a face
    temperature and has fired NOTHING yet.

    ⚠⚠ Why not the run maximum: lat_Tface_max is SELF-LIMITED once the leg
    fires (removal consumes every face above threshold) and UNBOUNDED before
    the fix, so run maxima are not comparable quantities. A matched pre-firing
    step is drive-independent and margin-free."""
    for n, Tf in prefiring_series(base, root):
        return n, Tf
    return None, 0.0


def prefiring_series(base, root=None):
    """every (index, lat_Tface_max) with a face temperature and NOTHING fired
    yet, in order. More than one step lets h be checked for CONSTANCY, which is
    what catches a moved argmax."""
    out = []
    for n, (Tf, fi) in enumerate(thermo_rows(
            base, ["lat_Tface_max", "lat_fires"], root)):
        if fi != 0.0:
            break
        if Tf > 0.0:
            out.append((n, Tf))
    return out


def run(name, seed, drive, rem):
    d = os.path.join(OUT, name)
    if os.path.exists(d):
        shutil.rmtree(d)
    os.makedirs(d, exist_ok=True)
    argv = ["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "4", BIN, INP,
            "plot_file=%s/run" % d,
            "spall.lateral_drive=%s" % drive,
            "spall.lateral_removal=%s" % rem]
    if seed:
        argv.append("spall.seed_void=%s" % seed)
    with open(os.path.join(OUT, name + ".log"), "w") as lg:
        return subprocess.call(argv, stdout=lg, stderr=subprocess.STDOUT)


def events(name):
    f = os.path.join(OUT, name, "run_removal_events.csv")
    return list(csv.DictReader(open(f))) if os.path.exists(f) else []


def thermo(name, key):
    f = os.path.join(OUT, name, "run", "thermo.dat")
    if not os.path.exists(f):
        return []
    L = open(f).read().strip().split("\n")
    h = L[0].split()
    if key not in h:
        return []
    i = h.index(key)
    return [float(r.split()[i]) for r in L[1:] if len(r.split()) > i]


def interior(rows):
    return [r for r in rows
            if 0 < int(r["col_i"]) < N - 1 and 0 < int(r["col_j"]) < N - 1]


def main():
    fails = []

    def need(ok, msg):
        print(("  ok    " if ok else "  FAIL  ") + msg)
        if not ok:
            fails.append(msg)

    if "--check" not in sys.argv:
        if not os.path.exists(BIN):
            print("FAIL: missing binary"); return 1
        os.makedirs(OUT, exist_ok=True)
        for lg in LEGS:
            rc = run(*lg)
            if rc != 0:
                print("FAIL: leg %s exited %d" % (lg[0], rc)); fails.append(lg[0])
        if fails:
            return 1

    # ---- RISER: reachability, but NOT the firing count --------------------
    # ⚠⚠ The old `fires > 0` assertion here is VOID. It was satisfied BY the
    # 1e6x unit bug (deliverable 9): with the units right this fixture's face
    # reaches only 491 K against a 656 K threshold, so it fires 0 and a lower
    # bound would now simply fail while telling us nothing. The firing
    # assertions moved to the LADDER's hot leg, where they are two-sided.
    print("RISER -- face temperature arrives on every face (reachability only)")
    cand = sum(thermo("RISER", "lat_cand"))
    need(cand > 0, "the mode has candidates to judge (%g)" % cand)
    need(sum(thermo("RISER", "lat_no_faceT")) == 0,
         "no face was skipped for want of a face temperature (deliverable 0 "
         "delivers on every face)")

    # ---- the 1-cell step: lateral removal IS top-cell removal -------------
    print("STEP1 -- a one-cell step: the face cell IS the top cell")
    a, b = events("STEP1R"), events("STEP1D")
    # ⚠⚠ `len(a) > 0` is VOID for the same reason as RISER's: it was satisfied
    # by the unit bug. The one-cell-per-firing invariant is asserted on the
    # LADDER's hot leg, which actually fires.
    tops = [r for r in a if int(float(r["regime"])) == 6]
    print("      (firing count not asserted here -- VOID since deliverable 9; "
          "%d regime-6 events, invariant checked on LAD_HOT)" % len(tops))
    need(all(int(float(r["n_voided"])) == 1 for r in tops),
         "no regime-6 event here voids more than one cell (%d events)"
         % len(tops))
    need(len(b) == 0,
         "drive-only fires nothing into the log (%d events) -- removal is what "
         "voids" % len(b))

    # ============ (u)(v)(v2)(w)(b2): THE LADDER, run order 1 =============
    if "--check" not in sys.argv:
        for nm, hh in LADDER:
            rc = run_ladder(nm, hh)
            if rc != 0:
                print("FAIL: ladder leg %s exited %d" % (nm, rc))
                fails.append(nm)

    def lad(nm, key):
        v = thermo(nm, key)
        return max(v) if v else 0.0

    rung = []
    for nm, hh in LADDER:
        rung.append(dict(
            name=nm, h=hh,
            Tf=lad(nm, "lat_Tface_max"), q=lad(nm, "lat_qmax"),
            cand=max(thermo(nm, "lat_cand") or [0.0]),
            fires=sum(thermo(nm, "lat_fires")),
            ell=ell_field(nm, 2.0, 50, 59, 1.0)))

    print("\n(v) THREE-POINT SCORE LADDER -- one fixture, side_face_h by argv")
    print("     leg           h      T_face[K]  pred   lat_qmax  lat_cand  lat_fires  ell[mm]")
    for r in rung:
        print("     %-12s %6.1f  %8.1f  %6.1f  %9.4f  %8.0f  %9.0f  %7.3f"
              % (r["name"], r["h"], r["Tf"], T_face_pred(r["h"]), r["q"],
                 r["cand"], r["fires"], r["ell"] * 1e3))
    ok_T = all(r["Tf"] > 0 for r in rung)
    need(ok_T, "every rung reported a face temperature (lat_Tface_max > 0)")
    if ok_T:
        worst = max(abs(r["Tf"] - T_face_pred(r["h"])) for r in rung)
        print("     face temperature vs T0 + h/(h+G)(T_gas-T0), G = %.0f: worst "
              "%.1f K" % (G_ROCK, worst))
        # ⚠⚠ THE PREDICTION UNDER-READS, FOR TWO COMPOUNDING REASONS, and
        # neither is a defect -- but neither was in the packet either:
        #  (1) T_face is the RECONSTRUCTED FACE temperature (T_face_out,
        #      deliverable 0), not the adjacent CELL-CENTRE temperature that
        #      G ~ 605 was fitted to from a plotfile. The face is hotter.
        #  (2) ⚠⚠ ON A FIRING LEG lat_Tface_max IS SELF-LIMITED TO THE
        #      THRESHOLD: removal consumes any face that gets hotter, so the
        #      hot rung cannot reach the drive's asymptote (~780 K) and reports
        #      ~the threshold instead. ⇒ "the hot face lands inside
        #      (absolute, differential)" is NEARLY TAUTOLOGICAL once the leg
        #      fires at all; it is the monotone q and the single crossing that
        #      carry (v), not the window.
        print("     ⚠⚠ the prediction is a CELL-CENTRE model and the hot rung is")
        print("        SELF-LIMITED by its own removal -- see the comment here;")
        print("        (v2), which uses each leg's OWN T_face, is the real check")
    qs = [r["q"] for r in rung]
    need(all(qs[i] < qs[i + 1] for i in range(len(qs) - 1)),
         "lat_qmax is STRICTLY MONOTONE INCREASING across the ladder (%s)"
         % " < ".join("%.4f" % v for v in qs))
    cross = sum(1 for i in range(len(qs) - 1) if qs[i] < 1.0 <= qs[i + 1])
    need(cross == 1 and qs[0] < 1.0 and qs[-1] >= 1.0,
         "lat_qmax crosses 1.0 EXACTLY ONCE (%d crossing(s)) -- this is what "
         "fixes the threshold's LOCATION, which a hot/cold pair cannot" % cross)
    # ⚠⚠ P1g-0b (c2)/(c3): THE 0/0/>0 PATTERN IS A CARRIED NUMBER AND IS VOID.
    # It was measured while the criterion's `h` was capped at 80 on every rung,
    # so the ladder never ran at its own drive. With the cap conditional
    # (P1g-0b deliverable 1) the drives 169.3 / 305 / 700 finally reach the
    # criterion and the pattern is 0 / >0 / >0 -- the WARM rung moved identity
    # from 305 to 169.3. Asserting 0/0/>0 would be asserting a number from a
    # different experiment, so what is asserted is the STRUCTURE: the lowest rung
    # is silent, the top rung fires, and a rung exists that is near threshold yet
    # silent -- found, not assumed, and printed.
    need(rung[0]["fires"] == 0 and rung[-1]["fires"] > 0,
         "the ladder still brackets the threshold: the lowest rung is SILENT and "
         "the top rung FIRES (%s)"
         % " / ".join("%.0f" % r["fires"] for r in rung))
    print("     ⚠ fires by rung: %s  (pre-cap-fix this read 0 / 0 / 48 -- the"
          % " / ".join("%.0f" % r["fires"] for r in rung))
    print("       drives never reached the criterion then)")
    # the hot face must land BETWEEN the two form thresholds, or (b2) has no
    # discriminator and the test must say so rather than pass.
    ell_h = rung[2]["ell"] if rung[2]["ell"] > 0 else 6.3e-3
    th_abs = q_thresh(ell_h, A0_FIX, False)
    th_dif = q_thresh(ell_h, A0_FIX, True)
    print("     fixture thresholds at ell = %.3f mm, a0 = %g um: absolute "
          "%.1f K, differential %.1f K" % (ell_h * 1e3, A0_FIX * 1e6,
                                           th_abs, th_dif if th_dif else -1))
    # ⚠⚠ P1g-0 (u3): THE WINDOW SUB-CONDITION IS DELETED, NOT WEAKENED.
    # It read `th_abs < hot Tf < th_dif` and PASSED BY 1.8 K (657.4 against a
    # 655.6 K edge) on a window that had itself moved 1,253 K between packet
    # revisions. The quantity is self-limited: on any leg that fires, removal
    # consumes every face above threshold, so lat_Tface_max REPORTS THE
    # THRESHOLD and the window is a rounding error dressed as a discriminator.
    # A quantity bounded by the mechanism's own action cannot be its
    # discriminator (ROADMAP standing rule 15). What carries this row is the
    # monotone lat_qmax and the single crossing, above; (b2)'s straddle is the
    # real form discriminator and is scored on its own two legs.
    print("     ⚠⚠ the hot face is %.1f K; the WINDOW around it is DELETED as a"
          % rung[2]["Tf"])
    print("        discriminator (self-limited by its own removal) -- reported,")
    print("        never asserted. (b2) below is what separates the two forms.")

    # ============ (c2) THE RE-SPACED LADDER, targets stated in advance =======
    print("\n[P1g-0b] (c2) THE RE-SPACED LADDER -- new names, old drives KEPT above")
    print("     targets registered BEFORE the run: two SILENT rungs near %.2f and"
          % RESPACE_TARGETS["q_lo"][0])
    print("     in [%.2f, %.2f], every silent rung <= %.2f, and one FIRING rung"
          % (RESPACE_TARGETS["q_mid"][0], RESPACE_TARGETS["q_mid"][1],
             RESPACE_TARGETS["q_silent_max"]))
    print("     with lat_fires >= %d. ⚠⚠ A FIRING rung carries NO clearance bar:"
          % RESPACE_TARGETS["fires_min"])
    print("        its lat_qmax is self-limited by its own removal.")
    if "--check" not in sys.argv:
        for nm, hh in RESPACED:
            rc = run_ladder(nm, hh)
            if rc != 0:
                print("FAIL: respaced leg %s exited %d" % (nm, rc))
                fails.append(nm)
    resp = []
    for nm, hh in RESPACED:
        resp.append(dict(name=nm, h=hh, q=lad(nm, "lat_qmax"),
                         Tf=lad(nm, "lat_Tface_max"),
                         cand=max(thermo(nm, "lat_cand") or [0.0]),
                         fires=sum(thermo(nm, "lat_fires"))))
    print("     leg           h      lat_qmax  lat_fires  T_face[K]  lat_cand")
    for r in resp:
        print("     %-12s %6.1f  %9.5f  %9.0f  %9.2f  %8.0f"
              % (r["name"], r["h"], r["q"], r["fires"], r["Tf"], r["cand"]))
    qs_r = [r["q"] for r in resp]
    need(all(qs_r[i] < qs_r[i + 1] for i in range(len(qs_r) - 1)),
         "the re-spaced lat_qmax is STRICTLY MONOTONE (%s)"
         % " < ".join("%.5f" % v for v in qs_r))
    cross_r = sum(1 for i in range(len(qs_r) - 1) if qs_r[i] < 1.0 <= qs_r[i + 1])
    need(cross_r == 1 and qs_r[0] < 1.0 <= qs_r[-1],
         "it crosses 1.0 EXACTLY ONCE (%d crossing(s))" % cross_r)
    silent = [r for r in resp if r["fires"] == 0]
    firing = [r for r in resp if r["fires"] > 0]
    need(len(silent) >= 2,
         "at least TWO rungs are silent (%d: %s)"
         % (len(silent), ", ".join(r["name"] for r in silent)))
    need(all(r["q"] <= RESPACE_TARGETS["q_silent_max"] for r in silent),
         "every SILENT rung is <= %.2f -- none sits a rounding error under "
         "threshold (%s)"
         % (RESPACE_TARGETS["q_silent_max"],
            ", ".join("%s %.5f" % (r["name"], r["q"]) for r in silent)))
    lo, hi = RESPACE_TARGETS["q_lo"]
    need(any(lo <= r["q"] <= hi for r in silent),
         "a silent rung lands in the LOW target band [%.2f, %.2f] (%s)"
         % (lo, hi, ", ".join("%.5f" % r["q"] for r in silent)))
    mlo, mhi = RESPACE_TARGETS["q_mid"]
    need(any(mlo <= r["q"] <= mhi for r in silent),
         "a silent rung lands in the MIDDLE target band [%.2f, %.2f] -- this is "
         "what the old 1.0002 rung could not do (%s)"
         % (mlo, mhi, ", ".join("%.5f" % r["q"] for r in silent)))
    need(len(firing) >= 1
         and max(r["fires"] for r in firing) >= RESPACE_TARGETS["fires_min"],
         "the FIRING rung fires at least %d times -- counted, not cleared (%s)"
         % (RESPACE_TARGETS["fires_min"],
            ", ".join("%s %.0f" % (r["name"], r["fires"]) for r in firing)))
    print("     ⚠ the old middle rung for comparison: LAD_WARM lat_qmax %.5f "
          "(fires %.0f)" % (rung[1]["q"], rung[1]["fires"]))

    print("\n(v2) the ladder's VALUES -- lat_qmax vs K_I/K_Ic by hand from each")
    print("     leg's OWN printed lat_Tface_max (bar 5 %)")
    worst_q = 0.0
    for r in rung:
        if not (r["Tf"] > 0.0):
            continue
        e = r["ell"] if r["ell"] > 0 else 6.3e-3
        want = q_hand(r["Tf"], e, A0_FIX, False)
        err = 100.0 * abs(r["q"] - want) / want if want > 0 else 0.0
        worst_q = max(worst_q, err)
        print("     %-12s T_face %7.1f K  ell %6.3f mm   code %.4f  hand %.4f"
              "   %+6.2f %%" % (r["name"], r["Tf"], e * 1e3, r["q"], want, err))
    need(worst_q <= 5.0,
         "every rung's lat_qmax agrees with the hand criterion to <= 5 %% "
         "(worst %.2f %%)" % worst_q)

    print("\n(w) TWO-SIDED COUNT -- a lower bound alone cannot detect OVER-firing")
    # ⚠⚠ P1g-0b (c3): THE WARM RUNG IS FOUND, NOT INDEXED. Pre-cap-fix it was
    # rung[1] (305); post-fix 305 FIRES and the near-threshold-yet-silent rung is
    # rung[0] (169.3). Hard-coding the index would have scored the wrong leg and
    # called it a pass.
    hot = rung[-1]
    cands = [r for r in rung if r["fires"] == 0 and 0.5 < r["q"] < 1.0]
    warm = cands[-1] if cands else rung[0]
    print("\n     [P1g-0b] (c3) the WARM rung is FOUND, not indexed: chose %s "
          "(h = %.1f, lat_qmax %.4f, fires %.0f)"
          % (warm["name"], warm["h"], warm["q"], warm["fires"]))
    print("          candidates with qmax in (0.5,1) AND zero fires: %s"
          % (", ".join("%s(%.4f)" % (c["name"], c["q"]) for c in cands)
             if cands else "NONE"))
    need(bool(cands),
         "a rung exists that is near threshold yet fires EXACTLY 0 -- the "
         "negative case (%s)"
         % ", ".join("%s q=%.4f f=%.0f" % (r["name"], r["q"], r["fires"])
                     for r in rung))
    need(0 < hot["fires"] < hot["cand"],
         "the HOT leg fires strictly between 0 and its candidate count "
         "(0 < %.0f < %.0f)" % (hot["fires"], hot["cand"]))
    need(hot["q"] >= 1.0,
         "and its lat_qmax reaches the threshold (%.4f >= 1)" % hot["q"])
    # ⚠⚠ THE WARM RUNG IS WHAT MAKES THE BOUND REAL. A zero-firing leg whose
    # score is never written cannot refute anything -- lat_q reads 0.0 there by
    # initialisation, which is the vacuous-witness trap inside the very row that
    # exists to prevent it. lat_qmax (deliverable 12) is taken BEFORE the firing
    # branch, so the warm leg reports how close it came.
    need(0.5 < warm["q"] < 1.0,
         "the WARM leg's lat_qmax is strictly inside (0.5, 1) -- near the "
         "threshold yet silent, so the upper bound reads a real number and not "
         "an uninitialised zero (%.4f)" % warm["q"])

    print("\n(u) THE UNIT FIX -- q_lat recomputed by hand on an absolute-form "
          "regime-6 event")
    ev6 = [r for r in events("LAD_HOT") if int(float(r["regime"])) == 6
           and float(r["q_lat"]) > 0.0]
    need(len(ev6) > 0, "the hot leg logged at least one regime-6 event with a "
                       "q_lat to check (%d)" % len(ev6))
    if ev6:
        e0 = max(ev6, key=lambda r: float(r["q_lat"]))
        Tf, el, af = (float(e0["T_face_lat"]), float(e0["ell_lat"]),
                      float(e0["a_f"]))
        got, kic = float(e0["q_lat"]), float(e0["K_Ic_lat"])
        want = q_hand(Tf, el, af, False)
        err = 100.0 * abs(got - want) / want if want > 0 else 0.0
        print("     T_face %.2f K  ell %.5f m  a_f %.3g m  K_Ic %.4g Pa*sqrt(m)"
              % (Tf, el, af, kic))
        print("     logged q_lat %.6f   by hand %.6f   %+.3f %%" % (got, want, err))
        need(kic > 1.0e5,
             "K_Ic_lat is in Pa*sqrt(m), not MPa*sqrt(m) (%.4g) -- the bug "
             "itself, now an assertion" % kic)
        need(err <= 1.0, "logged q_lat agrees with the hand criterion to "
                         "<= 1 %% (%.3f %%)" % err)
        # the invariants that RISER/STEP1 can no longer carry
        nv = collections.Counter(int(float(r["n_voided"])) for r in
                                 [r for r in events("LAD_HOT")
                                  if int(float(r["regime"])) == 6])
        need(set(nv) == {1}, "every regime-6 event on the firing leg has "
                             "n_voided == 1 (%s)" % dict(nv))
        need(sum(thermo("LAD_HOT", "lat_voided")) ==
             sum(thermo("LAD_HOT", "lat_fires")),
             "every firing voids exactly one cell (%g voided vs %g fired)"
             % (sum(thermo("LAD_HOT", "lat_voided")),
                sum(thermo("LAD_HOT", "lat_fires"))))

    # ⚠⚠ P2-2a change B: the (b2) block is DELETED, and its four legs with it
    # BY NAME -- `B2_ABS`, `B2_DIF`, `B2_OFF_ABS`, `B2_OFF_DIF`. It asserted
    # that the lateral criterion follows the RUN's `spall.driving_stress`, and
    # that key no longer exists: there is ONE form. Its finding is preserved in
    # the P2-2a packet -- the two forms straddled 1.0 at the same drive, so the
    # difference was the FORM and not the drive.
    # ⚠ The lateral site's own `(1 - e^{-h_f/ell})` factor went with
    # `differential`; under the surviving form h_f never enters the lateral
    # stress, so that criterion is ell-blind apart from exp(-a_f/ell).

    # ================= (c1) STENCIL EXACTNESS, analytic =================
    # ⚠ This is a regression on the DIVISOR, not on the field. Sample a known
    # exponential along the wall normal, read it with the shipped two-cell form,
    # and recover ell. The divisor must be dx*|n_x| (the NORMAL distance between
    # the two cell centres); plain dx under-reads by 1/|n_x| = 1.4142 at 45 deg,
    # and the staircase factor f = 1/(|n_x|+|n_y|) is right at 0 and 45 deg ONLY
    # and 15.5 % off at 15 and 30 deg -- which is exactly why a 0/45-only test
    # would pass a wrong divisor.
    print("[P1f] (c1) stencil exactness on a prescribed exponential (bar 0.1 %)")
    DX_M, ELL_TRUE = 0.002, 0.006          # 3 cells
    worst, worst_ang = 0.0, None
    for ang in (0.0, 15.0, 30.0, 45.0):
        nx = abs(math.cos(math.radians(ang)))
        d_n = DX_M * nx                     # the shipped divisor
        # the field: dT = exp(-xi/ell) along the NORMAL
        dT_c = math.exp(-0.0 / ELL_TRUE)
        dT_b = math.exp(-d_n / ELL_TRUE)
        ell = d_n / math.log(dT_c / dT_b)
        rel = abs(ell - ELL_TRUE) / ELL_TRUE
        worst = max(worst, rel)
        if rel >= worst: worst_ang = ang
        print("     %4.0f deg  |n_x| %.5f  recovered ell %.6f mm  err %.2e"
              % (ang, nx, 1000 * ell, rel))
    need(worst <= 1e-3,
         "exact at every angle (worst %.2e at %s deg)" % (worst, worst_ang))
    # and the divisor really is what the kernel uses
    src_r = open(os.path.join(ROOT, "src", "Integrator", "MMWSpalling",
                              "Removal.H")).read()
    need("const Set::Scalar d_n = DX[0] * comp;" in src_r,
         "Removal.H divides by DX[0] * comp, the normal distance")
    need("1.0 / (hx + hy)" not in src_r.split("P1f:")[-1],
         "the staircase factor is NOT used as the lateral divisor")

    # ================= (c2) FIELD RESIDUAL, swept over ell/dz ==============
    print("\n[P1f] (c2) field residual on a static staircase, swept over ell/dz")
    print("     ⚠ domain 32 mm wide (16 columns) so the profile cannot reach the")
    print("       Neumann far side -- the old 16 mm box set the 8.66 point and it")
    print("       was counted after being flagged; it is excluded here by design.")
    N2, NZ2 = 16, 60
    sweep = []
    for soak in (2.0, 10.0, 60.0, 240.0):
        for tag, seed in (("A", axis_seed(N2, 50, 59)), ("D", diag_seed(N2, 50, 59))):
            nm = "C2%s_%g" % (tag, soak)
            if "--check" not in sys.argv:
                run_sweep(nm, N2, 2.0, NZ2, soak, seed)
        # ⚠⚠ SCORED ON THE FIELD, not on lat_ell_med: that variable is
        # conditioned on firing and inflated the (c3) gap ~5x. ell_last is
        # printed beside it so the contrast stays on the record.
        a = ell_field("C2A_%g" % soak, 2.0, 50, 59, 1.0)
        d = ell_field("C2D_%g" % soak, 2.0, 50, 59, 1.0 / math.sqrt(2.0))
        a_cond = ell_last("C2A_%g" % soak)
        d_cond = ell_last("C2D_%g" % soak)
        if a > 0 and a_cond > 0:
            print("       field %.4f / %.4f mm   (firing-conditioned %.4f / "
                  "%.4f mm -- NOT scored)"
                  % (a * 1e3, d * 1e3, a_cond * 1e3, d_cond * 1e3))
        if not (a > 0 and d > 0):
            continue
        gap = 100.0 * abs(d - a) / a
        # ⚠⚠ CONTAINMENT, COMPUTED -- not a point excluded by eye.
        # The two-cell read is only meaningful while the profile is contained by
        # the rock BEHIND the wall. The far face is Neumann, so once the profile
        # reaches it the reflection flattens the tail, the log-ratio reads a
        # longer ell, and the apparent anisotropy inflates. Solid thickness
        # behind the wall is (n/2)*dx; require the boundary to sit at >= 2 decay
        # lengths (<= 13.5 % of the face amplitude).
        thick = (N2 / 2) * 2.0e-3
        ndec = thick / a
        ok = ndec >= 2.0
        print("     soak %6.0f s   ell/dz %5.2f   gap %5.1f %%   boundary at "
              "%.1f decay lengths  %s"
              % (soak, a / 0.002, gap, ndec,
                 "" if ok else "<- EXCLUDED, profile not contained"))
        if ok:
            sweep.append((soak, a / 0.002, gap))
    need(len(sweep) >= 3, "the sweep produced at least 3 CONTAINED points")
    if len(sweep) >= 3:
        gaps = [g for _, _, g in sweep]
        mono = all(gaps[i] >= gaps[i + 1] - 1e-9 for i in range(len(gaps) - 1))
        need(mono, "the gap is MONOTONE DECREASING with ell/dz over the "
                   "CONTAINED points %s -- a non-monotone contained sweep would "
                   "mean the residual is not a cell-scale field effect and the "
                   "attribution is wrong"
                   % ["%.1f" % g for g in gaps])
        at4 = min(sweep, key=lambda r: abs(r[1] - 4.0))
        need(at4[2] <= 12.0,
             "gap %.1f %% at ell/dz %.2f <= 12 %% (the bar (f)'s 1.10 requires, "
             "NOT the 8.4 %% previously observed)" % (at4[2], at4[1]))

    # ========== (c3) MESH REFINEMENT, DE-CONFOUNDED — report, not gate ======
    # ⚠⚠ THE SHIPPED VERSION WAS CONFOUNDED AND ITS 19.6 % IS NOT EVIDENCE.
    # It seeded the riser by CELL COUNT (10 cells), so at dz = 1 mm the step went
    # 20 mm -> 10 mm: dz was not the only change. The axis leg alone moved
    # ell 6.30 -> 4.71 mm at one soak, which mesh refinement cannot do to a
    # physical length. Here the riser is seeded by PHYSICAL HEIGHT (20 cells at
    # 1 mm = the same 20 mm) and the soak is shortened so ell/dz is held fixed,
    # leaving dz as the only change and the estimator's conditioning identical.
    #
    # ⚠ ell ~ sqrt(t), so holding ell/dz fixed while halving dz needs t/4.
    #
    # ⚠⚠ THE ln-RATIO QUOTIENT is the diagnostic, not just the gap:
    #   ln(r_axis)/ln(r_diag) = sqrt(2) * ell_diag/ell_axis
    # because d_n differs between the geometries by exactly sqrt(2). A quotient
    # near sqrt(2) is the PARALLEL-ISOTHERM field the divisor is built for -- the
    # 2 mm pair reads 1.4143, i.e. the correction reconciling two genuinely
    # different fields to 1 part in 1e4. ⚠ This is also what refutes the
    # "resolution floor" reading: a saturated instrument would return MATCHING
    # raw ratios and ell differing by sqrt(2), not the reverse.
    print("\n[P1f] (c3) mesh refinement, de-confounded -- REPORT, not a gate")
    SOAK2, SOAK3 = 60.0, 15.0            # 15 = 60/4, holding ell/dz fixed
    ref = next(((sk, ed, g) for sk, ed, g in sweep if sk == SOAK2), None)
    if "--check" not in sys.argv:
        for tag, seed in (("A", axis_seed(32, 100, 119)),
                          ("D", diag_seed(32, 100, 119))):
            run_sweep("C3%s" % tag, 32, 1.0, 120, SOAK3, seed)
    # ⚠⚠ SCORED ON THE FIELD -- see the ell_last docstring and
    # studies/p1f_lateral/C3_MESH_FINDING.txt 'CORRECTION'.
    a1 = ell_field("C3A", 1.0, 100, 119, 1.0)
    d1 = ell_field("C3D", 1.0, 100, 119, 1.0 / math.sqrt(2.0))
    a1c, d1c = ell_last("C3A"), ell_last("C3D")
    if a1 > 0 and a1c > 0:
        print("     field %.4f / %.4f mm   (firing-conditioned %.4f / %.4f mm "
              "-- NOT scored)" % (a1 * 1e3, d1 * 1e3, a1c * 1e3, d1c * 1e3))
    print("     riser held at 20 mm physical (20 cells at 1 mm vs 10 at 2 mm); "
          "soak %g s = %g/4" % (SOAK3, SOAK2))
    if a1 > 0 and d1 > 0:
        q1 = math.sqrt(2.0) * d1 / a1
        g1 = 100.0 * abs(d1 - a1) / a1
        cont1 = (16.0e-3) / a1
        print("     dz = 1 mm:  ell/dz %5.2f   containment %4.1f decay   "
              "axis %.6f mm  45deg %.6f mm" % (a1 / 0.001, cont1, 1000*a1, 1000*d1))
        print("     dz = 1 mm:  gap %6.3f %%   ln-ratio quotient %.4f   "
              "(sqrt2 = %.4f)" % (g1, q1, math.sqrt(2.0)))
        if ref:
