    P1G0 = os.path.join(HERE, "output.p1g0b_prefix")
    have_pre = os.path.isdir(PREFIX) and os.path.isdir(P1G0)

    print("\n(n3) SOURCE: no SurfaceCellFlux call passes a direction-dependent "
          "length")
    rem_src = open(os.path.join(ROOT, "src", "Integrator", "MMWSpalling",
                                "Removal.H")).read()
    mmw_src = open(os.path.join(ROOT, "src", "Integrator",
                                "MMWSpalling.H")).read()
    # ⚠ the dz argument is index 6, NOT 7: the signature is
