    print("\n(u2) THE CORNER, at a matched PRE-FIRING step -- the lift above the")
    print("     cell, recomputed from the kernel's own balance")
    print("     ⚠⚠ the packet's sqrt(2) bar is on the CONDUCTANCE, not the lift:")
    print("        L_post/L_pre = (G_pre+B)/(G_post+B) < sqrt2 strictly, B > 0.")
    if have_pre:
        print("     conductances: G_pre %.4f  G_post %.4f  ratio %.12f  "
