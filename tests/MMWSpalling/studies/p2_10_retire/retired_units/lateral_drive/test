    print("\n[P1g-0b] (c4) BURIED CAVITIES -- a real bar, replacing a clamped assertion")
    print("     ⚠⚠ the old row asserted the DEPTH SCAN never reads a cavity. It")
    print("        cannot: the scan is clamped to solid_run_col[idx]-1")
    print("        (Removal.H:1260-1262), so the assertion passed BY")
    print("        CONSTRUCTION on every leg. This counts the cells instead.")
    def buried(root, leg):
        """solid-above-void cells below each column's top, from the plotfile."""
        try:
            import numpy as _np, yt as _yt
            _yt.set_log_level(50)
        except Exception as e:
            return None
        d = os.path.join(root, leg, "run")
        if not os.path.isdir(d):
            return None
        pf = sorted(g for g in (os.path.join(d, x) for x in os.listdir(d))
                    if g.endswith("cell") and os.path.isdir(g))
        if not pf:
            return None
        ds = _yt.load(pf[-1])
        cg = ds.covering_grid(level=0, left_edge=ds.domain_left_edge,
                              dims=ds.domain_dimensions)
        solid = _np.asarray(cg["removed"]) < 0.5
        nx, ny, nz = solid.shape
        n = 0
        for i in range(nx):
            for j in range(ny):
                col = solid[i, j, :]
                if not col.any():
                    continue
                kt = nz - 1 - int(_np.argmax(col[::-1]))
                for k in range(kt - 1, -1, -1):
                    if (not col[k]) and col[k + 1]:
                        n += 1
        return n
