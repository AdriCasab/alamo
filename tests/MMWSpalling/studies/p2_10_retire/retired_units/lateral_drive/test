            Tc_true = cell_from_face(Tf_true, G_POST, H_TRUE)
            print("     step %d   T_face: capped(h=80) %.4f K   "
                  "uncapped(h=169.3) %.4f K" % (n2, Tf_cap, Tf_true))
            print("     cell recovered from each: %.4f K vs %.4f K   "
