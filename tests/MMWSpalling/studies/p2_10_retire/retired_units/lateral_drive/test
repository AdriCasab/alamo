    print("P1g-2c THE THERMAL SHIFT'S WRITE-BACK")
    print("=" * 70)

    # ⚠⚠ THE FLAT LEG NEEDS THE WIDE DOMAIN TOO, and this is NOT what the packet
    # said. It sized only the 45 degree leg, but `axis_seed(n)` puts the wall at
    # i = n/2 and so leaves n/2 cells of solid behind the face: at the fixture's
    # n = 8 that is FOUR, below ROWMIN = 6, so every shift refuses and the leg
    # reads `sum lat_shift = 0`. Measured exactly that way on the first run --
    # the leg banked 88 times (56 void + 32 short) and shifted never. The code's
    # own comment at Removal.H:3182-3187 predicts it ("the shared fixture box
    # leaves only 3-4 cells behind the face"). At n = 20 the wall sits at i = 10
    # with 10 cells behind it, so the control can actually shift.
    # ⚠ Both legs therefore share one geometry, which is a bonus: the only
    # difference between them is the SEED, so (b1) vs (b2) isolates the wall
    # orientation and nothing else.
    G2C_GEOM = ["amr.n_cell=%d %d 60" % (G2C_N, G2C_N),
                "geometry.prob_hi=%g %g 0.120" % (G2C_L, G2C_L)]

    if "--check" not in sys.argv:
        rc = g1_run("G1_FLAT_SHIFT", G2C_KEYS,
                    seed=axis_seed(G2C_N, 50, 59), extra=G2C_GEOM)
        need(rc == 0, "[P1g-2c] leg G1_FLAT_SHIFT exits 0 (rc=%d)" % rc)
        rc = g1_run("G1_DIAG45", G2C_KEYS, seed=diag_seed(G2C_N, 50, 59),
                    extra=G2C_GEOM)
        need(rc == 0, "[P1g-2c] leg G1_DIAG45 exits 0 (rc=%d)" % rc)

    def g2c_frac(name):
        """realised/booked over the run.

        ⚠ Taken as the RATIO OF SUMS, not the mean of the per-step ratio: a step
        with a tiny booked energy would otherwise dominate. The ratio is also
        immune to thermo sampling, since numerator and denominator are sampled
        together -- though this fixture has plot_int = 1 anyway."""
        rr = g1_thermo(name, "lat_shift_real")
        bb = g1_thermo(name, "lat_shift_E")
        if not rr or not bb:
            return None, 0.0, 0.0
        sr, sb = sum(rr), sum(bb)
        return (sr / sb if sb != 0.0 else None), sr, sb

    for nm in ("G1_FLAT_SHIFT", "G1_DIAG45"):
        sh = g1_thermo(nm, "lat_shift")
        need(sh is not None and sum(sh) > 0,
             "[P1g-2c] %s actually SHIFTS (sum lat_shift = %s) -- a leg that "
             "never enters Removal.H:3181 cannot witness anything"
             % (nm, "absent" if sh is None else "%g" % sum(sh)))

    # ---- (b1) the diagnostic reads 1.00 on the SINGLE-TOUCH leg ----------
    # ⚠⚠ The control MUST be a leg that ENTERS the shift. The four G1_* legs do
    # not set lateral_thermal, so they would pass by absence -- the vacuity trap.
    f_flat, sr, sb = g2c_frac("G1_FLAT_SHIFT")
    tm = g1_thermo("G1_FLAT_SHIFT", "lat_touch_multi")
    tw = g1_thermo("G1_FLAT_SHIFT", "lat_twoaxis")
    print("\n[P1g-2c] (b1) G1_FLAT_SHIFT -- axis-aligned riser, ONE row per cell")
    print("     realised %.6g J / booked %.6g J = %s"
          % (sr, sb, "%.6f" % f_flat if f_flat is not None else "n/a"))
    print("     cells touched >1x: sum %g      two-axis faces: sum %g"
          % (sum(tm) if tm else -1, sum(tw) if tw else -1))
    need(f_flat is not None and abs(f_flat - 1.0) <= 0.002,
         "[P1g-2c] (b1) realised/booked == 1.000 +/- 0.002 on the single-touch "
         "leg (got %s) -- otherwise the DIAGNOSTIC is wrong, not the physics"
         % ("n/a" if f_flat is None else "%.6f" % f_flat))
    need(tm is not None and sum(tm) == 0.0,
         "[P1g-2c] (b1) the axis-aligned leg touches NO cell twice (sum %s) -- "
         "every open face is +x there, so a multi-touch would mean the key is "
         "mis-scoped" % ("absent" if tm is None else "%g" % sum(tm)))

    # ---- (b2) the 45 degree leg REACHES the bug --------------------------
    f_diag, sr2, sb2 = g2c_frac("G1_DIAG45")
    tw2 = g1_thermo("G1_DIAG45", "lat_twoaxis")
    sh2 = g1_thermo("G1_DIAG45", "lat_shift")
    tm2 = g1_thermo("G1_DIAG45", "lat_touch_multi")
    cov = (sum(tw2) / sum(sh2)) if (tw2 and sh2 and sum(sh2) > 0) else 0.0
    same = max(sh2) if sh2 else 0.0
    print("\n[P1g-2c] (b2) G1_DIAG45 -- 45 deg staircase, TWO rows share cells")
    print("     realised %.6g J / booked %.6g J = %s"
          % (sr2, sb2, "%.6f" % f_diag if f_diag is not None else "n/a"))
    print("     two-axis coverage %.3f      max shifts in one step %g"
          % (cov, same))
    print("     cells touched >1x: sum %g  max %g"
          % (sum(tm2) if tm2 else -1, max(tm2) if tm2 else -1))
    need(cov > 0.50,
         "[P1g-2c] (b2) two-axis coverage > 50 %% (got %.3f) -- below this the "
         "leg is not reaching corners and a clean ratio would be VACUOUS, "
         "which is exactly how the old corner test passed" % cov)
    need(same >= 2.0,
         "[P1g-2c] (b2) at least 2 corners bank in the SAME step (max %g) -- "
         "cross-face crossings need two faces shifting at once" % same)
    # ⚠ This row's SENSE flips with the fix: before it, the 45 deg leg must read
    # BELOW 0.95 (the bug is reachable); after it, (c2) requires 1.000 +/- 0.002.
    # Both are asserted, selected by whether any cell is touched twice AND the
    # ratio has closed -- so one file serves both builds without editing.
    multi = (tm2 is not None and sum(tm2) > 0.0)
    need(multi,
         "[P1g-2c] (b2) the 45 deg leg DOES write some cell twice (sum %s) -- "
         "if not, the shared-cell path is still unexercised"
         % ("absent" if tm2 is None else "%g" % sum(tm2)))
    # ⚠⚠ P2-1 deliverable 7, CARRIED RISK (ii) FROM P1g-2c'S REVIEW. This row
    # used to branch: below 0.95 it PRINTED "pre-fix, leak reachable" and
    # passed. That was right for exactly one packet -- the one that had to run
    # the same file against both builds -- and wrong for every packet after it,
    # because a regression that reopened the leak would reproduce the pre-fix
    # reading and the test would announce it and pass. The fix has shipped; the
    # assertion is now UNCONDITIONAL and the pre-fix branch is gone.
    need(f_diag is not None and abs(f_diag - 1.0) <= 0.002,
         "[P1g-2c] (c2) the 45 deg leg closes: realised/booked == 1.000 "
         "+/- 0.002 (got %s)"
         % ("n/a" if f_diag is None else "%.6f" % f_diag))
    if f_diag is not None:
        print("     => the 45 deg leg CLOSES (%.6f)" % f_diag)
    es = g1_thermo("G1_DIAG45", "ledger_err_solid")
    need(bool(es),
         "[P1g-2c] (c2) the 45 deg leg reports ledger_err_solid at all -- an "
         "absent column cannot be scored and must not pass silently")
    if es:
        print("     ledger_err_solid max |.| = %.4e" % max(abs(x) for x in es))
        need(max(abs(x) for x in es) <= 5.0e-3,
             "[P1g-2c] (c2) ledger_err_solid <= 5e-3 on the 45 deg leg "
             "(max %.4e)" % max(abs(x) for x in es))

    # ---- deliverable 6: the refusal split adds up ------------------------
    for nm in ("G1_FLAT_SHIFT", "G1_DIAG45"):
        rf = g1_thermo(nm, "lat_shift_refuse")
        a = g1_thermo(nm, "lat_ref_ell")
        b = g1_thermo(nm, "lat_ref_void")
        c = g1_thermo(nm, "lat_ref_short")
        if rf and a and b and c:
            lhs, rhs = sum(rf), sum(a) + sum(b) + sum(c)
            print("\n[P1g-2c] d6 %s refusals %g = ell %g + void %g + short %g"
                  % (nm, lhs, sum(a), sum(b), sum(c)))
            need(abs(lhs - rhs) < 0.5,
                 "[P1g-2c] the three-way refusal split sums to lat_shift_refuse "
                 "(%g vs %g)" % (lhs, rhs))

    # ======================================================================
    # P2-1 (b2) LOWER HALF: `typed` IS A TRUE NO-OP
    # ======================================================================
    # ⚠⚠ WHAT THIS ROW CAN AND CANNOT MEASURE ON THIS FIXTURE, stated so the
    # reviewer does not have to re-derive it:
    #
    #  * the packet asks for `side_h_used == 169.3 to 6 s.f.` here. That is not
    #    scoreable on this leg for TWO independent reasons, both structural:
    #      - this leg's coefficient is 400.0, not 169.3 (`g1_run`'s default
    #        h = G1_H overrides the input's 169.3 by argv), and
    #      - the `side_h_used_*` columns are registered ONLY under
    #        side_face_h_law = derived, which is exactly what keeps a `typed`
    #        leg's thermo header unchanged and the 2639-file tree gate clean.
    #        Registering them on a typed leg would trade (b1) for (b2).
    #  * so the lower half is scored by its PURPOSE -- that the law does not
    #    leak into the default -- as byte-identity between the shipped leg and
    #    one that names `side_face_h_law = typed` explicitly. That is
    #    non-vacuous: any resolution reaching the default breaks it.
    #  * and the key's reachability is scored by its GUARD firing, which is the
    #    one thing this jet-less fixture can say about `derived` at all.
    print("\n[P2-1] (b2) lower half -- `typed` is a true no-op, and the "
          "derived guard fires")
    rc_t = g1_run("G1_FLAT_TYPED", G2C_KEYS + ["surface_patch.side_face_h_law=typed"],
                  seed=axis_seed(G2C_N, 50, 59), extra=G2C_GEOM)
    need(rc_t == 0, "[P2-1] G1_FLAT_TYPED exits 0 (rc=%d)" % rc_t)
    a = os.path.join(OUT, "G1_FLAT_SHIFT", "run_removal_events.csv")
    b = os.path.join(OUT, "G1_FLAT_TYPED", "run_removal_events.csv")
    if os.path.exists(a) and os.path.exists(b):
        same = open(a, "rb").read() == open(b, "rb").read()
        print("     event logs byte-identical with and without "
              "side_face_h_law=typed: %s" % same)
        need(same,
             "[P2-1] (b2) naming side_face_h_law = typed changes NOTHING -- the "
             "law has not leaked into the default")
    else:
        need(False, "[P2-1] (b2) both legs wrote an event log")
    # thermo headers must match too: a column added on a typed leg is what
    # would cost the tree gate.
    ha = g1_thermo_header("G1_FLAT_SHIFT")
    hb = g1_thermo_header("G1_FLAT_TYPED")
    need(ha is not None and ha == hb,
         "[P2-1] (b2) the typed leg's thermo header is unchanged (%s)"
         % ("equal" if ha == hb else "DIFFERS"))
    need(ha is not None and not [c for c in ha if c.startswith("side_h_used")],
         "[P2-1] (b2) a typed leg carries NO side_h_used_* column -- that is "
         "what keeps the 2639-file identity gate clean")
    # the guard: `derived` without a jet closure must ABORT, not fall back.
    rc_d = g1_run("G1_FLAT_DERIVED", G2C_KEYS + ["surface_patch.side_face_h_law=derived"],
                  seed=axis_seed(G2C_N, 50, 59), extra=G2C_GEOM)
    print("     side_face_h_law=derived on this jet-less fixture: rc=%d" % rc_d)
    need(rc_d != 0,
         "[P2-1] (b2) `derived` ABORTS without surface_patch.jet_closure = "
         "enthalpy (rc=%d) -- a silent fall-back to the typed scalar is the "
         "inert-key failure three keys in this line of packets already hit"
         % rc_d)
    lg = os.path.join(OUT, "G1_FLAT_DERIVED.log")
    txt = open(lg).read() if os.path.exists(lg) else ""
    need("jet_closure = enthalpy" in txt,
         "[P2-1] (b2) the abort NAMES the key that would fix it")

    print()
    if fails:
        print("FAIL: %d check(s) failed" % len(fails)); return 1
    print("PASS: the lateral mode fires, voids exactly one cell, closes the "
          "ledger,\n      and is isotropic between an axis-aligned and a 45 "
          "degree wall.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
