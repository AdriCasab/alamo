def run_sweep(name, n, dxmm, nz, soak, seed):
    """One isotropy leg: n x n columns at dxmm, nz cells in z, drive-only.
    ⚠ Removal OFF -- with it on, every firing re-exposes a fresh face and pins
    ell_lat near dz/4, where a two-cell log ratio cannot resolve anything."""
    d = os.path.join(OUT, name)
    if os.path.exists(d):
        shutil.rmtree(d)
    os.makedirs(d, exist_ok=True)
    L = n * dxmm * 1e-3
    argv = ["mpirun", "--oversubscribe", "--bind-to", "none", "-np", "4", BIN, INP,
            "plot_file=%s/run" % d,
            "spall.lateral_drive=1", "spall.lateral_removal=0",
            "amr.n_cell=%d %d %d" % (n, n, nz),
            "geometry.prob_hi=%g %g %g" % (L, L, nz * dxmm * 1e-3),
            "stop_time=%g" % soak,
            "spall.seed_void=%s" % seed]
    with open(os.path.join(OUT, name + ".log"), "w") as lg:
        return subprocess.call(argv, stdout=lg, stderr=subprocess.STDOUT)


def ell_last(name):
    """⚠⚠ DEAD AS AN ESTIMATOR -- kept only to print beside ell_field().

    lat_ell_med is CONDITIONED ON FIRING, twice over: Removal.H:671-678 means it
    over FIRING columns only, and lat_ell[c] is itself a per-column MAX over that
    column's faces (ReduceRealMax at :664 after :660-662 zeroes the non-winning
    columns). The conditioning SET turns over step to step, so the series moves
    discontinuously at constant lat_fires -- measured +54.8 % and +39.7 % one-step
    jumps at UNCHANGED lat_fires on the (c3) pair. Reading it inflated the (c3)
    gap from the field's +6.1 % to +33.6 %. Score the FIELD; see
    studies/p1f_lateral/C3_MESH_FINDING.txt, 'CORRECTION'."""
    v = [x for x in thermo(name, "lat_ell_med") if x > 0]
    return v[-1] if v else 0.0


def ell_field(name, dxmm, k0, k1, comp, trim=2):
    """ell from the FIELD, UNCONDITIONED on firing -- the scored estimator.

    Every solid cell in the riser interior that has an open lateral neighbour AND
    a solid cell behind it, using the kernel's own
    ell = dx*|n_x| / ln(dT_c / dT_b).  comp = |n_x|: 1 on an axis wall,
    1/sqrt(2) on a 45 deg staircase.  Returns the median in metres, 0.0 if the
    plotfile or yt is unavailable (the caller must not silently fall back to
    lat_ell_med)."""
    try:
        import warnings
        warnings.filterwarnings("ignore")
        import numpy as np
        import yt
        yt.set_log_level(50)
    except Exception as e:
        print("      ⚠ ell_field unavailable (%s) -- NOT falling back" % e)
        return 0.0
    d = os.path.join(OUT, name, "run")
    plt = sorted(g for g in (os.path.join(d, x) for x in os.listdir(d))
                 if g.endswith("cell") and os.path.isdir(g))
    if not plt:
        print("      ⚠ ell_field: no cell plotfile under %s" % d)
        return 0.0
    ds = yt.load(plt[-1])
    cg = ds.covering_grid(level=0, left_edge=ds.domain_left_edge,
                          dims=ds.domain_dimensions)
    T = np.asarray(cg["Temp"])
    solid = np.asarray(cg["removed"]) <= 0.5
    nx, ny, nz = T.shape
    dx = dxmm * 1e-3
    rec = []
    for k in range(k0 + trim, k1 + 1 - trim):
        for i in range(1, nx - 1):
            for j in range(1, ny - 1):
                if not solid[i, j, k]:
                    continue
                for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    ii, jj, bi, bj = i + di, j + dj, i - di, j - dj
                    if not (0 <= ii < nx and 0 <= jj < ny):
                        continue
                    if not (0 <= bi < nx and 0 <= bj < ny):
                        continue
                    if solid[ii, jj, k] or not solid[bi, bj, k]:
                        continue          # need an OPEN face and a solid behind
                    dc, db = T[i, j, k] - T_REF, T[bi, bj, k] - T_REF
                    if not (dc > 0.0 and db > 0.0 and dc > db):
                        continue
                    rec.append(dx * comp / math.log(dc / db))
    if not rec:
        print("      ⚠ ell_field: no qualifying (cell, face) pairs in %s" % name)
        return 0.0
    return float(np.median(np.array(rec)))


