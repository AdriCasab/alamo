        need(rc_o == 0,
             "the SHIPPED configuration is SILENT -- the guards forbid "
             "configurations, they do not break the fixture (rc %d)" % rc_o)

    print("\n[P1g-0b] (c1) THE LIFT, recomputed from the kernel's own balance")
    print("     ⚠ scored on a leg that fires NOTHING on BOTH binaries, so the")
    print("       thermal field is untouched and Tc is common to the two reads.")
    if have_pre:
        H_CAPPED, H_TRUE = 80.0, 169.3
        sp2 = dict(prefiring_series("LAD_SHIPPED", P1G0))   # criterion h = 80
        so2 = dict(prefiring_series("LAD_SHIPPED"))          # criterion h = 169.3
        common2 = sorted(set(sp2) & set(so2))
        need(bool(common2),
             "the shipped rung reports pre-firing face temperatures on both "
             "binaries (%d common steps)" % len(common2))
        if common2:
            n2 = common2[-1]
            Tf_cap, Tf_true = sp2[n2], so2[n2]
            # ⚠⚠ ONE EQUATION EACH, NO FREE PARAMETER. Same G, same cell; the
