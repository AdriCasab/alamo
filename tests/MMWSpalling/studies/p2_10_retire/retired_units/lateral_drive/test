             % (len(sp), len(so), len(common)))
        if common:
            print("     (Tc, h) recovered from the TWO logged faces per step --")
            print("      no constant assumed; h must come out CONSTANT:")
            print("      %5s %11s %11s %10s %9s %9s %9s"
                  % ("step", "Tf_pre", "Tf_post", "Tc[K]", "h[W/m2K]",
                     "lift_pre", "lift_post"))
            rec = []
            for n in common:
                Tc, hh = cell_and_h(sp[n], so[n])
                if Tc is None:
                    continue
                rec.append((n, sp[n], so[n], Tc, hh))
            show = rec[:3] + ([("...",)] if len(rec) > 6 else []) + rec[-3:] \
                if len(rec) > 6 else rec
            for r in show:
                if len(r) == 1:
                    print("      %5s" % "..."); continue
                n, a, b, Tc, hh = r
                print("      %5d %11.4f %11.4f %10.4f %9.4f %9.4f %9.4f"
                      % (n, a, b, Tc, hh, a - Tc, b - Tc))
            hs = [r[4] for r in rec]
            Tcs = [r[3] for r in rec]
            # ⚠⚠ THE RECOVERED DRIVE IS NOT THE LADDER'S, and this is a FINDING.
            # The leg sets side_face_h = 700, but Removal.H:499 caps h_side
            # UNCONDITIONALLY at surface_patch.side_face_h_max, whose default is
            # 80.0 -- while the kernel (MMWSpalling.H:1768, :3937) caps only
            # under side_face_flux && per_cell_removal. So the criterion judges
            # on 80 W/m2K while the kernel heats with 700. That is a SECOND
            # criterion/kernel mismatch of the same family as the one this
            # packet fixes. REPORTED, NOT FIXED: the packet's fix is one
            # argument and widening it is not authorised. The ladder is
            # unaffected -- its lever moves the CELL temperature, not h.
            H_CAP = 80.0
            tol = 1.0e-3
            good = [h for h in hs if abs(h - H_CAP) <= tol * H_CAP]
            frac = len(good) / float(len(hs))
            print("     recovered h over %d steps: %.6f .. %.6f W/m2K"
                  % (len(hs), min(hs), max(hs)))
            print("     ⚠⚠ it is the 80.0 CAP, not the leg's side_face_h = 700:")
            print("        Removal.H:499 caps h_side at side_face_h_max "
                  "(default 80.0)")
            print("        UNCONDITIONALLY; the kernel caps only under")
            print("        side_face_flux && per_cell_removal. A SECOND")
            print("        criterion/kernel mismatch -- reported, out of scope.")
            print("     within %.1e of the cap on %d/%d steps (%.1f %%)"
                  % (tol, len(good), len(hs), 100.0 * frac))
            # ⚠ the first few steps are a transient: the score ORDERING is what
            # the fix changes, so while many faces are near-degenerate the
            # max-score face can differ between the binaries and the 2x2 then
            # mixes two cells. It settles within ~4 steps and is printed above
            # rather than trimmed away.
            need(frac >= 0.9,
                 "ONE h satisfies both binaries' balances on >= 90 %% of "
                 "pre-firing steps and it is the 80.0 cap (%.1f %%, %d steps) "
                 "-- the only thing that changed is dz" % (100.0 * frac, len(hs)))
            n_last, a_l, b_l, Tc_l, h_l = rec[-1]
            # ⚠⚠ THE BAR IS PROPAGATED, NOT CHOSEN. thermo.dat is written with
            # %g -- six significant digits -- so each logged face carries a
            # quantisation of half its last printed digit (standing rule 8: do
            # not demand bit-exactness from a text diagnostic). The 2x2 is
            # ill-conditioned in exactly this direction: its determinant is
            # ~3.3e5 against coefficients ~2e3, so a 5e-4 K rounding on a face
            # moves the recovered h by ~5e-3. A 1e-4 RELATIVE bar sits BELOW
            # that floor and fails on round-off alone -- it did on the first
            # run of this file. Perturb both faces by +/- half a quantum in all
            # four sign combinations and take the worst excursion as the bar.
            def quantum(x):
                """half the last printed digit of a %g six-significant-digit
                token -- the most the stored double can differ from it."""
                t = "%g" % x
                if "e" in t or "E" in t:
                    m, e = t.lower().split("e")
                    nd = len(m.split(".")[1]) if "." in m else 0
                    return 0.5 * 10.0 ** (int(e) - nd)
                nd = len(t.split(".")[1]) if "." in t else 0
                return 0.5 * 10.0 ** (-nd)
            qa, qb = quantum(a_l), quantum(b_l)
            exc = 0.0
            for sa in (-1.0, 1.0):
                for sb in (-1.0, 1.0):
                    _t, hp = cell_and_h(a_l + sa * qa, b_l + sb * qb)
                    if hp is not None:
                        exc = max(exc, abs(hp - h_l))
            bar = max(exc, 1.0e-9)
            print("     LAST pre-firing step %d: Tc %.4f K   h %.6f  "
                  "|h-80| = %.2e" % (n_last, Tc_l, h_l, abs(h_l - H_CAP)))
            print("       %%g quanta on the two faces: %.1e / %.1e K  =>  "
                  "propagated bar on h = %.2e" % (qa, qb, bar))
            need(abs(h_l - H_CAP) <= bar,
                 "at the last common pre-firing step -- the one with the most "
                 "signal -- the recovered drive is the 80.0 cap to within the "
                 "logging precision (|h-80| = %.2e <= %.2e)"
                 % (abs(h_l - H_CAP), bar))
            need(all(t > T_REF for t in Tcs[4:]) if len(Tcs) > 4 else True,
                 "every recovered cell temperature past the transient is above "
                 "the rock IC (min %.4f K > %.2f)"
                 % (min(Tcs[4:]) if len(Tcs) > 4 else 0.0, T_REF))
            # the lift, and the ratio that is NOT sqrt 2
            n0, a0_, b0_, Tc0, _h = rec[-1]
            h_bar = H_CAP
            ha = face_newton(G_PRE, h_bar, Tc0)
            hb = face_newton(G_POST, h_bar, Tc0)
            pred = (hb - Tc0) / (ha - Tc0)
            meas = (b0_ - Tc0) / (a0_ - Tc0)
            print("     at step %d (Tc %.4f K): hand faces %.6f / %.6f vs "
                  "logged %.6f / %.6f" % (n0, Tc0, ha, hb, a0_, b0_))
            print("     LIFT ratio measured %.6f   balance predicts %.6f   "
                  "sqrt2 %.6f" % (meas, pred, math.sqrt(2.0)))
            print("       ⇒ %.2f %% BELOW sqrt 2, which is (G_pre+B)/(G_post+B) "
                  "with B > 0" % (100.0 * (1.0 - meas / math.sqrt(2.0))))
            need(abs(meas - pred) <= 2.0e-3 * pred,
                 "the lift ratio matches the balance's own prediction (%.6f vs "
                 "%.6f) -- NOT sqrt 2, which the nonlinear losses forbid"
                 % (meas, pred))

    print("\n(u2b) the corner rung's FIRING COUNT, pre-fix vs post-fix -- the")
    print("      CONSEQUENCE, reported with its margins. Nothing halts here.")
    for tag, root in (("pre-fix ", PREFIX if have_pre else None),
                      ("post-fix", P1G0 if have_pre else None)):
        if tag.strip() == "pre-fix" and not have_pre:
            print("      pre-fix  : no archive"); continue
        fi = sum(x[0] for x in thermo_rows("LAD_HOT_DIAG", ["lat_fires"], root))
        qm = [x[0] for x in thermo_rows("LAD_HOT_DIAG", ["lat_qmax"], root)]
        tf = [x[0] for x in thermo_rows("LAD_HOT_DIAG", ["lat_Tface_max"], root)]
        qm_x = max(qm) if qm else 0.0
        tf_x = max(tf) if tf else 0.0
        el = ell_field("LAD_HOT_DIAG", 2.0, 50, 59, 1.0) if root is None else 0.0
        th = q_thresh(el, A0_FIX, False) if el > 0 else None
        # the step at which the corner FIRST fires -- sharper than the total,
