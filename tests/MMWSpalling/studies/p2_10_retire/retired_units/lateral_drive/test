# --- geometries -------------------------------------------------------------
def axis_seed(n, k0, k1):
    """a straight wall at i = n/2: every open face is +x, so |n_x| = 1 exactly."""
    return "%d 0 %d %d %d %d" % (n // 2, k0, n - 1, n - 1, k1)


def diag_seed(n, k0, k1):
    """a 45 deg staircase, one seed box per j, boundary on i + j = n + 1.
    Every standing column on the boundary has ONE x face and ONE y face open, so
    hx = hy and |n_x| = |n_y| = 1/sqrt(2) -- the case the divisor must handle."""
    return " ".join("%d %d %d %d %d %d" % (max(0, n + 1 - j), j, k0, n - 1, j, k1)
                    for j in range(2, n))


