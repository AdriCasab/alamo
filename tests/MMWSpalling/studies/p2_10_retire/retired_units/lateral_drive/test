        for m in re.finditer(r"SurfaceCellFlux\(", src):
            if src[:m.start()].rstrip().endswith("static void"):
                continue
            depth, j = 1, m.end()
            while depth and j < len(src):
                if src[j] == "(": depth += 1
                elif src[j] == ")": depth -= 1
                j += 1
            args, d2, cur = [], 0, ""
            for ch in src[m.end():j - 1]:
                if ch == "(": d2 += 1
                elif ch == ")": d2 -= 1
                if ch == "," and d2 == 0:
                    args.append(cur.strip()); cur = ""
                else:
                    cur += ch
            args.append(cur.strip())
            args = [" ".join(a.split()) for a in args]
            if len(args) > 7:
                calls.append((tag, src[:m.start()].count("\n") + 1, args[6]))
    print("     %d call sites; the conduction length each one passes:" % len(calls))
    for tag, ln, a in calls:
        print("       %-16s :%-5d  %s" % (tag, ln, a))
    bad = [c for c in calls if "d_n" in c[2] or "comp" in c[2]]
