#!/usr/bin/env python3
"""P2-2e (deliverable 7, gate a4) -- THE CONSTRAINT-REFERENCE LOCK.

Asserts, by source inspection, that EVERY stress-reference read named in the
packet's reachability ledger reads the constraint reference under
`spallation.sp.constraint_depth > 0`, that the two vertical firing sites read
the SAME gathered values, that the gather precedes the first firing site, and
that the reference is read in METRES from a gathered (never box-local) column.

THE THREE SITES, EIGHT READS (enumerated by grepping every T0_at/T0_at_didx/
LawSigma read on 2026-10-19 -- there are no others):
  Removal.H  lateral criterion   law  LawSigma(lat_g, T0 + jump, ...)
                                 verbatim  C_th * (...)
  Removal.H  depth scan          law  LawSigma(scan_g, T_z, T0_z)
                                 verbatim  (T_z - T0_z)
  MMWSpalling.H Sp_field top half-cell  law + verbatim
  MMWSpalling.H Sp_field deeper/lateral law + verbatim

⚠⚠ RED IS DEMONSTRATED, NOT ASSERTED. Each clause has a MUTATION control that
reverts exactly one P2-2e edit textually and must turn that clause RED; a
"full revert" control reverts them all and must turn EVERY clause red. With
`--pre <dir>` the clauses are also run against an actual pre-change source
pair (MMWSpalling.H + Removal.H) and must all FAIL there.

Usage:  test [--pre <dir holding MMWSpalling.H and Removal.H>]
"""
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, "..", "..", "..", ".."))
MMW = os.path.join(ROOT, "src", "Integrator", "MMWSpalling.H")
REM = os.path.join(ROOT, "src", "Integrator", "MMWSpalling", "Removal.H")


def body(txt, header, end=r"\n    \}"):
    """The body of the first member function whose signature matches."""
    m = re.search(header + r"[\s\S]*?\{([\s\S]*?)" + end, txt)
    return m.group(1) if m else ""


def clauses(mmw, rem):
    """[(name, bool)] -- every clause, evaluated on one source pair."""
    out = []

    def need(name, ok):
        out.append((name, bool(ok)))

    # C1 the key: parsed once, default 0, BEFORE the sp_weibull early return
    psm = body(mmw, r"static void ParseSpallationModel\(", r"\n    \}\n")
    q = psm.find('"spallation.sp.constraint_depth"')
    r = psm.find("if (value.spallation_model != SpallationModel::SpWeibull) return;")
    need("C1 the key is parsed ONCE, default 0.0, BEFORE the sp_weibull early "
         "return (so a damage_law deck cannot leave it silently unused)",
         mmw.count('"spallation.sp.constraint_depth"') == 1
         and 'query_default("spallation.sp.constraint_depth", value.sp_cref_d, 0.0)' in mmw
         and 0 <= q < r)

    # C2 the abort names the T-face conjunction
    need("C2 d > 0 aborts unless the T-derived criterion path is on (the SAME "
         "conjunction Removal.H forms as sp_weibull_use_T_face)",
         re.search(r"if \(value\.sp_cref_d > 0\.0\)[\s\S]{0,900}?"
                   r"value\.spall_enabled &&[\s\S]{0,200}?SpallationModel::SpWeibull"
                   r"[\s\S]{0,200}?sp_local_thermoelastic[\s\S]{0,400}?Util::Abort",
                   mmw) is not None)

    # C3 the depth scan
    need("C3 the depth scan's reference is CrefTAtDepth at normal depth "
         "(z_abs + d), converted with sn_icth -- METRES, under d > 0; "
         "T0_at_didx at d = 0",
         # ⚠ gaps sized for the 40-50 column indentation of this site: the
         # first draft's 120/260 were a few characters short and read RED on
         # correct source, which made C3's mutation control vacuous.
         re.search(r"const Set::Scalar T0_z = cref_on\s*\?\s*CrefTAtDepth\("
                   r"[\s\S]{0,400}?\(z_abs \+ cref_d_loc\) \* sn_icth"
                   r"[\s\S]{0,400}?:\s*T0_at_didx\(", rem) is not None
         and "LawSigma(scan_g, T_z, T0_z)" in rem
         and len(re.findall(r"\(T_z - T0_z\)", rem)) == 1)

    # C4 the lateral criterion
    need("C4 the lateral criterion references T0 + dT_s exp(-(xi + d)/ell_use) "
         "on BOTH its law and verbatim paths under d > 0",
         re.search(r"if \(cref_on\)\s*\{\s*const Set::Scalar jref =\s*"
                   r"dT_s \* std::exp\(-\(xi \+ cref_d_loc\) / ell_use\);"
                   r"[\s\S]{0,600}?LawSigma\(lat_g, T0 \+ jump, T0 \+ jref\)"
                   r"[\s\S]{0,200}?return C_th \* \(jump - jref\);", rem) is not None)

    # C5 the Sp_field site, both branches, through ONE resolver
    tref = re.search(r"auto Tref_at = \[&\] \(Set::Scalar depth_n,([\s\S]*?)\n                \};",
                     mmw)
    tb = tref.group(1) if tref else ""
    need("C5 BOTH Sp_field branches take their reference from the ONE resolver "
         "Tref_at; its TOP-face path reads CrefTAtDepth at (depth + d)*icth and "
         "its LATERAL path the profile model d further in; d = 0 is T0_at(...)",
         len(re.findall(r"const Set::Scalar Tref_h = Tref_at\(depth, i, j, k\);", mmw)) == 1
         and len(re.findall(r"const Set::Scalar Tref_d = Tref_at\(depth, i_d, j_d, k_d\);", mmw)) == 1
         and "LawSigma(te_g, T_recon_at(dv),\n                                                Tref_h)" in mmw
         and "LawSigma(te_g, T_a(i_d, j_d, k_d),\n                                            Tref_d)" in mmw
         and "(T_recon_at(dv) - Tref_h)" in mmw
         and "(T_a(i_d, j_d, k_d) - Tref_d)" in mmw
         and "if (!cref_on_sp) return T0_at(ii, jj, kk);" in tb
         and re.search(r"CrefTAtDepth\(c, \(depth_n \+ cref_d_sp\) \* icth", tb) is not None
         and "std::exp(-(depth_n * icth + cref_d_sp) / ell_s)" in tb)

    # C6 one buffer, both vertical sites, never box-local
    crd = body(mmw, r"Set::Scalar CrefTAtDepth\(std::size_t c,")
    need("C6 the two VERTICAL firing sites read the SAME gathered buffer: "
         "CrefTAtDepth is called once in each file, and its body reads only "
         "cref_T_col -- no Array4, no T_a, no box index (so it cannot be "
         "box-local)",
         rem.count("CrefTAtDepth(") == 1
         and len(re.findall(r"\bCrefTAtDepth\(", mmw)) == 2       # def + 1 call
         and "cref_T_col" in crd
         and not re.search(r"\bT_a\(|Array4|\.array\(|validbox|vbx_lo", crd))

    # C7 the gather precedes the FIRST firing site
    adv = mmw
    i_b = adv.find("        BuildConstraintRefColumns(lev);\n        UpdateSpAfterMechanics(lev, time, dt);")
    i_r = adv.find("        UpdateRemovalAfterCohesive(lev, time, dt);")
    need("C7 BuildConstraintRefColumns runs IMMEDIATELY before "
         "UpdateSpAfterMechanics and therefore before UpdateRemovalAfterCohesive "
         "(the depth scan) -- both sites see one gather of one state",
         i_b >= 0 and i_r > i_b)

    # C8 the gather is a gather
    bcr = body(mmw, r"void BuildConstraintRefColumns\(int lev\)")
    need("C8 the reference column is a validbox-filled, ReduceRealSum-gathered "
         "band with the SAME column-top rule (GatherColumnSurface) and solid-run "
         "guard (ColumnSolidRunBelowTop) as the depth scan",
         "validbox()" in bcr and "ReduceRealSum(" in bcr and "cref_T_col" in bcr
         and "GatherColumnSurface(" in bcr and "ColumnSolidRunBelowTop(" in bcr)

    # C9 metres, interpolated
    need("C9 the read is in METRES and INTERPOLATED between cell centres "
         "(D/dz - 1/2 and a weight), never a floor(D/dz) cell read",
         "Set::Scalar mf = D / dz - 0.5;" in crd
         and "(1.0 - w) * g[m0] + w * g[m0 + 1]" in crd
         and "std::floor(D / dz)" not in crd)

    # C10 witnesses keyed and last
    i_p = mmw.find('"pcr_lateral_cells",  false);')
    i_c = mmw.find('"cref_n_vert",  false);')
    need("C10 the cref_* witnesses are registered ONLY under d > 0 and AFTER the "
         "last pre-existing registration, so a d = 0 thermo.dat is unchanged",
         i_p >= 0 and i_c > i_p
         and re.search(r"if \(value\.sp_cref_d > 0\.0\)\s*\{\s*value\.RegisterIntegratedVariable"
                       r"\(&value\.cref_d_out", mmw) is not None)

    # C11 nothing left un-routed
    need("C11 NO stress-reference read is left on the old reference: no "
         "LawSigma(te_g, ..., T0_at(...)) and no `- T0_at(` in a Sp_field bracket",
         not re.search(r"LawSigma\(te_g,[^;]*?T0_at\(", mmw)
         and not re.search(r"- T0_at\(", mmw))
    return out


# --------------------------------------------------------------------------
# MUTATIONS: each reverts ONE P2-2e edit, textually, on the CURRENT source.
def m_scan(mmw, rem):
    r2 = re.sub(r"const Set::Scalar T0_z = cref_on\s*\?[\s\S]*?:\s*T0_at_didx\(",
                "const Set::Scalar T0_z = T0_at_didx(", rem, count=1)
    return mmw, r2


def m_lat(mmw, rem):
    r2 = re.sub(r"if \(cref_on\)\s*\{\s*const Set::Scalar jref =[\s\S]*?"
                r"return C_th \* \(jump - jref\);\s*\}", "", rem, count=1)
    return mmw, r2


def m_sp(mmw, rem):
    m2 = mmw.replace("Tref_at(depth, i_d, j_d, k_d)", "T0_at(i_d, j_d, k_d)")
    return m2, rem


def m_order(mmw, rem):
    m2 = mmw.replace("        BuildConstraintRefColumns(lev);\n        UpdateSpAfterMechanics(lev, time, dt);",
                     "        UpdateSpAfterMechanics(lev, time, dt);\n        BuildConstraintRefColumns(lev);")
    return m2, rem


def m_boxlocal(mmw, rem):
    m2 = mmw.replace("const Set::Scalar* g = cref_T_col.data()",
                     "const Set::Scalar* g = T_a(0, 0, 0) + cref_T_col.data()")
    return m2, rem


def m_cells(mmw, rem):
    m2 = mmw.replace("Set::Scalar mf = D / dz - 0.5;",
                     "Set::Scalar mf = std::floor(D / dz);")
    return m2, rem


def m_key_after(mmw, rem):
    """move the key's query below the sp_weibull return"""
    m2 = mmw.replace('pp.query_default("spallation.sp.constraint_depth", value.sp_cref_d, 0.0);',
                     "", 1)
    m2 = m2.replace("        if (value.spallation_model != SpallationModel::SpWeibull) return;",
                    "        if (value.spallation_model != SpallationModel::SpWeibull) return;\n"
                    '        pp.query_default("spallation.sp.constraint_depth", value.sp_cref_d, 0.0);', 1)
    return m2, rem


MUTATIONS = [
    ("revert the depth scan's reference to T0_at_didx", m_scan, "C3"),
    ("delete the lateral criterion's cref branch", m_lat, "C4"),
    ("revert the Sp_field deeper branch to T0_at(i_d,j_d,k_d)", m_sp, "C5"),
    ("build the gather AFTER the first firing site", m_order, "C7"),
    ("let the reader touch a box-local Array4", m_boxlocal, "C6"),
    ("read the reference by CELL index", m_cells, "C9"),
    ("parse the key AFTER the sp_weibull early return", m_key_after, "C1"),
]


def main():
    pre = None
    if "--pre" in sys.argv:
        pre = sys.argv[sys.argv.index("--pre") + 1]
    mmw, rem = open(MMW).read(), open(REM).read()
    bad = 0

    print("P2-2e (a4) -- THE CONSTRAINT-REFERENCE LOCK")
    print("=" * 84)
    print("POST-CHANGE source (must be GREEN):")
    res = clauses(mmw, rem)
    for nm, ok in res:
        print(f"  {'ok  ' if ok else 'FAIL'}  {nm}")
        bad += 0 if ok else 1

    print("\nMUTATION CONTROLS (each must turn its own clause RED):")
    for label, fn, target in MUTATIONS:
        mm, rr = fn(mmw, rem)
        changed = (mm != mmw) or (rr != rem)
        r2 = dict(clauses(mm, rr))
        hit = [k for k, v in r2.items() if k.startswith(target) and not v]
        # ⚠ NON-VACUITY: a control only discriminates if its clause was GREEN
        # on the unmutated source. A clause already red "goes red" for free --
        # exactly how the first draft's C3/C4 controls passed while C3/C4 failed.
        was_green = any(k.startswith(target) and v for k, v in res)
        ok = changed and bool(hit) and was_green
        print(f"  {'ok  ' if ok else 'FAIL'}  {label}: "
              f"{'source unchanged -- the mutation did not apply' if not changed else (target + ' goes RED' if hit else target + ' STAYS GREEN')}")
        bad += 0 if ok else 1

    if pre:
        print(f"\nPRE-CHANGE source ({pre}) -- every clause must be RED:")
        pm = open(os.path.join(pre, "MMWSpalling.H")).read()
        pr = open(os.path.join(pre, "Removal.H")).read()
        rp = clauses(pm, pr)
        green = [nm for nm, ok in rp if ok]
        for nm, ok in rp:
            print(f"  {'RED ' if not ok else 'GRN!'}  {nm[:72]}")
        print(f"  => {len(rp) - len(green)} of {len(rp)} clauses RED on the pre-change source")
        if green:
            # C11 is a NEGATIVE statement (nothing left on the old reference)
            # and C7/C8/C9 describe code that does not exist pre-change, so
            # every clause SHOULD be red; any green one is reported.
            bad += len(green)

    print("=" * 84)
    if bad:
        print(f"FAIL: {bad} check(s)")
        return 1
    print("PASS: every ledger site reads the constraint reference under d > 0,")
    print("      through one gathered column read in metres, built before the")
    print("      first firing site -- and each clause is shown to discriminate.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
