#@
#@ [3d]
#@ dim=3
#@ check=false
#@ exe=mmwspalling
#@

# P0 deliverable 8 -- THE 1-D STEADY-STATE RUNAWAY / MESH GATE.
#
# A laterally uniform column drilled by a convective flame BC until the front
# reaches steady recession. Three things are asked of it:
#
#   (a) the temperature the criterion FIRES AT is the same at 2 / 1 / 0.5 mm,
#       in a configuration that is NOT the Kant cube: removal is active, the
#       front is moving, and the flux is Meier-like rather than Kant-like;
#   (c) the steady recession rate matches the scheme's own energy balance
#           v = h*(T_g - T_surf,fire) / (rho*c*(T_bar_flake - T0))
#       to +-5 % at all three meshes;
#   and the cascade witness: cells voided per step must NOT read one per step.
#
# ⚠ "0.55 MW/m^2" IS A FLUX AT THE FIRING SURFACE, NOT A PRESCRIBED-FLUX BC.
# The packet asks for a uniform-flux column at 0.55 MW/m^2. This model has no
# prescribed-flux surface BC, so the flux is set through the convective BC the
# model actually uses: h_conv = 600 with T_flame = 1673.15 gives
# 600*(1673.15 - 756) = 0.550 MW/m^2 at the firing surface temperature, which
# is the middle of Meier's required 0.5-0.6 band. Revision 1 of the packet
# assumed a prescribed-flux BC and was corrected for exactly this reason; the
# same correction applies to the wording here.
#
# Meshes on the command line so all legs share one file:
#   amr.n_cell = 4 4 60 (2 mm) | 8 8 120 (1 mm) | 16 16 240 (0.5 mm)
# ⚠ timestep held at 0.008 s on all three (the 0.5 mm explicit limit
# dz^2/(6*alpha) is 0.060 s), so dz is the only thing that varies.

alamo.program = mmwspalling

plot_file = tests/MMWSpalling/validation/p0_steady_column/output/run

timestep  = 0.008
stop_time = 60.0

amr.plot_int        = 100000
amr.max_level       = 0
amr.n_cell          = 8 8 120
amr.blocking_factor = 2
amr.max_grid_size   = 32
amr.regrid_int      = 1000000
amr.grid_eff        = 0.7
amr.n_error_buf     = 1
amr.cell.all        = 1

# 8 x 8 x 120 mm. Laterally uniform (whole face heated, Neumann sides), so the
# problem is 1-D; 120 mm of depth keeps the front well clear of the base for
# 60 s at every leg's rate.
geometry.prob_lo     = 0.0   0.0   0.0
geometry.prob_hi     = 0.008 0.008 0.120
geometry.is_periodic = 0 0 0

alpha = 0.0 0.0

microstructure.mode       = expression
microstructure.phase_expr = 0
microstructure.nphases    = 1

microstructure.phase0.fraction          = 1.0
microstructure.phase0.kappa             = 1.5
microstructure.phase0.beta              = 8.0e-6
microstructure.phase0.E                 = 30.0e9
microstructure.phase0.mu                = 11.538461538e9
microstructure.phase0.rho               = 2750.0
microstructure.phase0.Cp                = 790.0
microstructure.phase0.A_D               = 0.0
microstructure.phase0.T_ref             = 293.15

conductivity.h_gb0              = 0.0

spallation.model         = sp_weibull
spall.stress_source      = local_thermoelastic
spallation.sp.a0         = 8.0e-6
spallation.sp.n_segments = 128
spallation.sp.kic.law    = nasseri_table
spallation.sp.kic.scale  = 1.0

weibull.enabled = 0

spall.enabled                = 1
spall.h_spall_max            = 0.015
spall.flake_coherence_length = 0.004
spall.removal_events_csv     = 1

# ⚠ REQUIRED, NOT COSMETIC. Without surface.follow_mask the convective patch
# is applied at the FIXED domain top (MMWSpalling.H: `k_top_c = ... : sp_topk`),
# so the moment the first cell is voided the heating stops dead and the column
# cools for the rest of the run. Measured on this case before the key was set:
# the new top cell sat at 295.9 K after 59 s of nominal 0.55 MW/m^2.
surface.follow_mask = 1

spall.surface_T      = reconstructed
spall.removal_energy = flake

vapor.enabled = 0
confining.p   = 0.0

beam.P0     = 0.0
beam.omega0 = 0.02
beam.lambda = 2.19e-3
beam.x0     = 0.004
beam.y0     = 0.004
beam.z0     = 0.120
beam.alpha_expr = 1.0
beam.R      = 0.0

losses.epsilon       = 0.0
losses.epsilon_high  = 0.0
losses.T_eps_break   = 1.0e30
losses.sigma_SB      = 0.0
losses.h_conv        = 0.0
losses.T_amb         = 293.15

surface_patch.enabled = 1
surface_patch.mode    = convective_flame
surface_patch.x0      = 0.004
surface_patch.y0      = 0.004
surface_patch.radius  = 0.05
surface_patch.h_conv  = 600.0
surface_patch.T_flame = 1673.15

hc.heat.alpha = 6.9045e-7
hc.heat.refinement_threshold = 1.0
hc.ic.type           = constant
hc.ic.constant.value = 293.15
hc.bc.temp.constant.type.xlo = neumann
hc.bc.temp.constant.type.xhi = neumann
hc.bc.temp.constant.type.ylo = neumann
hc.bc.temp.constant.type.yhi = neumann
hc.bc.temp.constant.type.zlo = neumann
hc.bc.temp.constant.type.zhi = neumann
hc.bc.temp.constant.val.xlo  = 0.0
hc.bc.temp.constant.val.xhi  = 0.0
hc.bc.temp.constant.val.ylo  = 0.0
hc.bc.temp.constant.val.yhi  = 0.0
hc.bc.temp.constant.val.zlo  = 0.0
hc.bc.temp.constant.val.zhi  = 0.0

el.type     = disable
el.nmodels  = 1
el.model1.E  = 30.0e9
el.model1.nu = 0.3
el.model1.F0 = 0 0 0 0 0 0 0 0 0

