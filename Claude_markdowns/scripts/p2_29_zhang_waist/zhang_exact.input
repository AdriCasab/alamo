#@
#@ [3d]
#@ dim=3
#@ check=true
#@ exe=mmwspalling
#@

# P2-29 (2026-11-10): Zhang/Oglesby MMW heating of Barre granite on THE PRODUCTION KERNEL (AdvanceMicrostructure),
# on a QUARTER of Zhang's block. The deck's physics is input's (the P2-20/P2-21 recorded prediction, nothing tuned to
# the experiment or to Zhang's curve -- see input's provenance block); what changes is the path and the domain:
#   * Zhang's granite (Zhang Table 1, src/Numeric/Material/Zhang.H defaults) is a PHASE LAW,
#     microstructure.phase0.law = zhang -- the kernel every production run uses -- not the separate material kernel
#     with its implicit solver (both retire in P2-29 stage 2).
#   * the block is the quadrant x, y in [0.05, 0.10] of input's 0.10 x 0.10 x 0.025 m block, with the beam axis on
#     its CORNER (beam.x0 = y0 = 0.05) and the two symmetry planes xlo / ylo adiabatic (Neumann: the ghost is the
#     nearest cell, the mirror of a symmetric field). The beam is NOT quartered by hand: the intensity is analytic per
#     cell and the schedule power is the full 800 W, so the integrated beam_P_inc / P_dep / P_trans / E_* are ONE
#     QUARTER of the full block's (x4 for any whole-block total), while beam_P_beam, the closure ratio and the
#     central-column bc_* are the full block's (the quadrant's corner column is the same physical cell).
#   * explicit, timestep 0.05 s (forward Euler; the limit at 0.78125 mm is 0.073 s at T_cold 273.15 K, ratio 0.69).
# Setup (zhang_oglesby_mmw_validation_summary.txt): T_amb 297.5 K, omega_0 = 0.02 m, zero standoff, Zhang's Table II
# power schedule; losses on the top face only (eps 0.7 below T_m, 0.3 above; h 56 W/m2K, Zhang Table 1); sides and
# bottom adiabatic. 150 s: the first schedule interval (800 W).

alamo.program = mmwspalling

plot_file = tests/MMWSpalling/validation/zhang/zhang_oglesby/output

timestep  = 0.05
stop_time = 150.0

amr.plot_int        = 200   # every 10 s
amr.thermo.int      = 1
amr.thermo.plot_int = 1     # the beam closure columns on every step (b1)
amr.max_level       = 0
amr.n_cell          = 64 64 32
amr.blocking_factor = 2
amr.regrid_int      = 1000000
amr.grid_eff        = 1.0
amr.cell.all = 1

geometry.prob_lo     = 0.05 0.05 0.0
geometry.prob_hi     = 0.10 0.10 0.025
geometry.is_periodic = 0 0 0

#
# MATERIAL: one phase, Zhang's law (Zhang Table 1: rho, kappa, c_p as Zhang.H's defaults). The latent scalars are the
# phase's (the law's own copies are refused): Zhang Table 1's fusion and vaporisation, as input's material carried.
#
microstructure.mode       = expression
microstructure.phase_expr = 0
microstructure.nphases    = 1
microstructure.phase0.fraction  = 1.0
microstructure.phase0.law       = zhang
microstructure.phase0.T_m       = 1510.5
microstructure.phase0.fus_width = 200.0
microstructure.phase0.L_m       = 3.4e5
microstructure.phase0.T_vap_lo  = 3233.0
microstructure.phase0.T_vap_hi  = 3503.0
microstructure.phase0.L_v       = 4.8e6
# INERT: the mechanics are off (el.type = disable); the scalars are required of a zhang phase (no stress law)
microstructure.phase0.E         = 1.0
microstructure.phase0.mu        = 0.3846153846
microstructure.phase0.beta      = 0.0

#
# BEAM: as input (P2-20: the absorption and reflection COMPUTED from Barre granite's dielectric pair; P2-21 the
# Hartlieb loss-ratio table). The axis on the quadrant's corner.
#
beam.omega0     = 0.02
beam.lambda     = 1.070687e-2        # c / 28 GHz (the heating gyrotron)
beam.x0         = 0.05
beam.y0         = 0.05
beam.z0         = 0.025
beam.eps_r      = 5.02               # Barre: n 2.24 (DOE p. 52); flat with T (user, 2026-11-05)
beam.tan_delta  = 0.01065            # Barre at 28 GHz (DOE p. 44/52)

beam.schedule.t_end = 150.0  390.0  510.0  750.0  850.0  1050.0  1200.0  1250.0  1750.0
beam.schedule.P     = 800.0  1800.0 2300.0 2800.0 1700.0 2800.0  1700.0  3200.0  0.0

#
# SURFACE LOSSES (Zhang Table 1): eps = 0.7 below T_m, 0.3 above; h = 56 W/(m^2 K); T_amb = 297.5 K.
#
losses.epsilon       = 0.7
losses.epsilon_high  = 0.3
losses.T_eps_break   = 1510.5
losses.sigma_SB      = 5.670374419e-8
losses.h_conv        = 56.0
losses.T_amb         = 297.5

#
# HEAT CONDUCTION: hc.heat.alpha is unused on the phase path (the law gives kappa / (rho c_p)) but the base class
# requires the key. Initial T = T_amb; adiabatic Neumann on every face (xlo / ylo are the symmetry planes).
#
hc.heat.alpha = 1.3e-6
hc.heat.refinement_threshold = 1.0
hc.ic.type           = constant
hc.ic.constant.value = 297.5
hc.bc.temp.constant.type.xlo = neumann
hc.bc.temp.constant.type.xhi = neumann
hc.bc.temp.constant.type.ylo = neumann
hc.bc.temp.constant.type.yhi = neumann
hc.bc.temp.constant.type.zlo = neumann
hc.bc.temp.constant.type.zhi = neumann
hc.bc.temp.constant.val.xlo  = 0.0
hc.bc.temp.constant.val.xhi  = 0.0
hc.bc.temp.constant.val.ylo  = 0.0
hc.bc.temp.constant.val.yhi  = 0.0
hc.bc.temp.constant.val.zlo  = 0.0
hc.bc.temp.constant.val.zhi  = 0.0

#
# ELASTICITY: disabled (a thermal-only validation)
#
el.type     = disable
el.nmodels  = 1
el.model1.E  = 1.0
el.model1.nu = 0.3
el.model1.F0 = 0 0 0 0 0 0 0 0 0
